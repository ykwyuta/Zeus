JPMAP    DFHMSD TYPE=MAP,MODE=INOUT,LANG=COBOL,TIOAPFX=YES,            X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
JPM1     DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=20,ATTRB=(ASKIP,BRT),                 X
               INITIAL='日本語の画面'
         DFHMDF POS=(3,1),LENGTH=10,ATTRB=(ASKIP,NORM),INITIAL='お名前：'
NAME     DFHMDF POS=(3,12),LENGTH=20,ATTRB=(UNPROT,IC),SOSI=YES
         DFHMDF POS=(3,33),LENGTH=0
MSG      DFHMDF POS=(5,1),LENGTH=40,ATTRB=(ASKIP,BRT)
         DFHMSD TYPE=FINAL
