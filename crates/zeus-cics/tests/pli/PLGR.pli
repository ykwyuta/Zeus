 /* A pseudo-conversational PL/I transaction: a BMS map, a file, a
    COMMAREA kept between tasks and a COBOL program LINKed to. */
 PLGR: PROC(COMMPTR) OPTIONS(MAIN);
   DCL COMMPTR POINTER;
   DCL 1 COMM BASED(COMMPTR),
         2 VISITS FIXED BIN(31),
         2 LAST CHAR(10);
   DCL 1 NEXT,
         2 VISITS FIXED BIN(31),
         2 LAST CHAR(10);
   DCL 1 GREET,
         2 NAME CHAR(10),
         2 TEXT CHAR(40),
         2 LEN FIXED BIN(31);
   DCL REC CHAR(30);
   DCL KEY CHAR(10);
   DCL RC FIXED BIN(31);
   DCL (EIBP, CAP) POINTER;
   DCL V PIC'99';
   DCL BYE CHAR(12) INIT('GOODBYE PL/I');
   DCL (STG, ADDR, LOW, SUBSTR) BUILTIN;
   %INCLUDE PLMAP;
   %INCLUDE DFHAID;
   %INCLUDE DFHBMSCA;

   IF EIBCALEN = 0 THEN DO;
     /* the first task: a record for the file, the map */
     REC = 'ALICE     WONDERLAND';
     KEY = 'ALICE';
     EXEC CICS WRITE FILE('NAMES') FROM(REC) RIDFLD(KEY) RESP(RC);
     CALL PLIFILL(ADDR(PLMAPAI), LOW(1), STG(PLMAPAI));
     VISITO = 'VISIT 00';
     EXEC CICS SEND MAP('PLMAPA') MAPSET('PLMAP') ERASE;
     NEXT.VISITS = 0;
     NEXT.LAST = '(NOBODY)';
     EXEC CICS RETURN TRANSID(EIBTRNID) COMMAREA(NEXT)
          LENGTH(STG(NEXT));
   END;
   IF EIBAID = DFHPF3 THEN DO;
     EXEC CICS SEND TEXT FROM(BYE) LENGTH(12) ERASE;
     EXEC CICS RETURN;
   END;
   EXEC CICS ADDRESS EIB(EIBP) COMMAREA(CAP);
   EXEC CICS HANDLE CONDITION MAPFAIL(NONAME);
   EXEC CICS RECEIVE MAP('PLMAPA') MAPSET('PLMAP') INTO(PLMAPAI);
   GREET.NAME = NAMEI;
   EXEC CICS LINK PROGRAM('CBGREET') COMMAREA(GREET)
        LENGTH(STG(GREET));
   KEY = GREET.NAME;
   CALL PLIFILL(ADDR(PLMAPAI), LOW(1), STG(PLMAPAI));
   MSGO = GREET.TEXT;
   EXEC CICS READ FILE('NAMES') INTO(REC) RIDFLD(KEY) RESP(RC);
   IF RC = DFHRESP(NORMAL) THEN INFOO = 'FOUND ' || SUBSTR(REC, 11);
   ELSE IF RC = DFHRESP(NOTFND) THEN INFOO = 'NOT IN FILE';
   ELSE INFOO = 'READ FAILED';
   IF EIBP ^= DFHEIPTR | CAP ^= COMMPTR THEN INFOO = 'BAD ADDRESS';
   NEXT.VISITS = COMM.VISITS + 1;
   V = NEXT.VISITS;
   VISITO = 'VISIT ' || V;
   LASTO = 'LAST ' || COMM.LAST;
   MSGA = DFHBMBRY;
   NEXT.LAST = KEY;
   EXEC CICS SEND MAP('PLMAPA') MAPSET('PLMAP') DATAONLY;
   EXEC CICS RETURN TRANSID(EIBTRNID) COMMAREA(NEXT);
 NONAME:
   CALL PLIFILL(ADDR(PLMAPAI), LOW(1), STG(PLMAPAI));
   MSGO = 'PLEASE TYPE A NAME';
   EXEC CICS SEND MAP('PLMAPA') MAPSET('PLMAP') ERASE;
   EXEC CICS RETURN TRANSID(EIBTRNID) COMMAREA(COMM);
 END PLGR;
