PLMAP    DFHMSD TYPE=MAP,MODE=INOUT,LANG=PLI,TIOAPFX=YES,              X
               DSATTS=(COLOR,HILIGHT),MAPATTS=(COLOR,HILIGHT)
PLMAPA   DFHMDI SIZE=(24,80),LINE=1,COLUMN=1
         DFHMDF POS=(1,1),LENGTH=20,ATTRB=(ASKIP,BRT),                 X
               INITIAL='PL/I GREETER'
         DFHMDF POS=(3,1),LENGTH=10,ATTRB=(ASKIP,NORM),INITIAL='NAME:'
NAME     DFHMDF POS=(3,12),LENGTH=10,ATTRB=(UNPROT,IC)
         DFHMDF POS=(3,23),LENGTH=0
MSG      DFHMDF POS=(5,1),LENGTH=40,ATTRB=(ASKIP,BRT)
INFO     DFHMDF POS=(6,1),LENGTH=40,ATTRB=(ASKIP,NORM)
VISIT    DFHMDF POS=(7,1),LENGTH=20,ATTRB=(ASKIP,NORM)
LAST     DFHMDF POS=(8,1),LENGTH=30,ATTRB=(ASKIP,NORM)
         DFHMSD TYPE=FINAL
