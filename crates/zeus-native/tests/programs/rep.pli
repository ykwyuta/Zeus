 REP: PROC(PARM) OPTIONS(MAIN);
   DCL PARM CHAR(100) VAR;
   DCL IN FILE RECORD INPUT;
   DCL REC CHAR(80);
   DCL EOF BIT(1) INIT('0'B);
   DCL N FIXED BIN(31) INIT(0);
   ON ENDFILE(IN) EOF = '1'B;
   PUT SKIP LIST('PARM', PARM);
   READ FILE(IN) INTO(REC);
   DO WHILE (¬EOF);
     N = N + 1;
     PUT SKIP LIST(SUBSTR(REC, 1, 10));
     READ FILE(IN) INTO(REC);
   END;
   PUT SKIP LIST('RECORDS', N);
   CALL PLIRETC(N);
 END REP;
