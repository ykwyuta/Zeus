 T3: PROC OPTIONS(MAIN);
   DCL I FIXED BIN(31), J FIXED BIN(15);
   DCL TOTAL FIXED DEC(9,2) INIT(0);
   DCL A(5) FIXED BIN(31) INIT(1, 2, 3, 4, 5);
   DCL M(2,3) FIXED DEC(3) INIT((6) 7);
   DCL 1 EMP,
         2 NAME CHAR(10) INIT('SMITH'),
         2 SALARY FIXED DEC(7,2) INIT(1234.56),
         2 FLAGS,
           3 ACTIVE BIT(1) INIT('1'B),
           3 MANAGER BIT(1) INIT('0'B);
   DCL 1 EMP2 LIKE EMP;
   DCL P PIC '$$$,$$9V.99';
   DCL S CHAR(20) VAR;
   DCL EOF BIT(1) INIT('0'B);
   DCL (SUBSTR, INDEX, LENGTH, TRIM, MOD, MAX, SUM, HBOUND) BUILTIN;

   DO I = 1 TO 5;
     TOTAL = TOTAL + A(I) * 1.5;
   END;
   PUT SKIP LIST('TOTAL', TOTAL);
   PUT SKIP LIST('SUM', SUM(A), 'HBOUND', HBOUND(A, 1));
   PUT SKIP LIST('FACT(10)', FACT(10));
   S = 'HELLO' || ' ' || 'WORLD';
   PUT SKIP LIST(S, LENGTH(S), INDEX(S, 'WORLD'), SUBSTR(S, 7, 3));
   SUBSTR(S, 1, 1) = 'J';
   PUT SKIP LIST(S);
   EMP2 = EMP;
   EMP2.SALARY = EMP2.SALARY * 2;
   PUT SKIP LIST(EMP2.NAME, EMP2.SALARY, EMP2.ACTIVE);
   P = 1234.5;
   PUT SKIP LIST('PIC', P);
   P = -7;
   PUT SKIP EDIT('PIC2 ', P)(A, A);
   DO J = 10 TO 1 BY -3;
     PUT SKIP LIST(J);
   END;
   PUT SKIP LIST('J AFTER', J);
   SELECT (MOD(17, 5));
     WHEN (1) PUT SKIP LIST('ONE');
     WHEN (2, 3) PUT SKIP LIST('TWO OR THREE');
     OTHERWISE PUT SKIP LIST('OTHER');
   END;
   ON ZERODIVIDE BEGIN;
     PUT SKIP LIST('ZERODIVIDE CAUGHT', ONCODE());
     GO TO AFTER;
   END;
   J = 0;
   I = 10 / J;
   PUT SKIP LIST('NOT REACHED');
 AFTER:
   PUT SKIP LIST('MAX', MAX(3, 9.5, 2));
   M(2,3) = 1;
   PUT SKIP LIST(M);
   CALL SHOW(EMP.NAME, 3);
   I = 0;
   DO WHILE (I < 3);
     I = I + 1;
     IF I = 2 THEN ITERATE;
     PUT SKIP LIST('WHILE', I);
   END;
   OUTER: DO I = 1 TO 3;
     DO J = 1 TO 3;
       IF J = 2 THEN LEAVE OUTER;
       PUT SKIP LIST(I, J);
     END;
   END OUTER;
   PUT SKIP LIST(TRIM('  ABC  ') || '!', 1E2, 101B, 'C1C2'X);

 FACT: PROC(N) RETURNS(FIXED DEC(15)) RECURSIVE;
   DCL N FIXED BIN(31);
   IF N <= 1 THEN RETURN(1);
   RETURN(N * FACT(N - 1));
 END FACT;

 SHOW: PROC(T, K);
   DCL T CHAR(*), K FIXED BIN(15);
   PUT SKIP LIST('SHOW', T, K, LENGTH(T));
 END SHOW;
 END T3;
