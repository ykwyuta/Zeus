 T6: PROC OPTIONS(MAIN);
   DCL N FIXED DEC(5);
   DCL S CHAR(5) INIT('12X45');
   DCL BAD CONDITION;
   DCL K FIXED DEC(3);
   ON CONDITION(BAD) PUT SKIP LIST('BAD SIGNALLED');
   SIGNAL CONDITION(BAD);
   ON ERROR BEGIN;
     ON ERROR SYSTEM;
     PUT SKIP LIST('ERROR UNIT, ONCODE', ONCODE());
     GO TO NEXT;
   END;
   N = S;
   PUT SKIP LIST('NOT HERE');
 NEXT:
   REVERT ERROR;
   ON SIZE PUT SKIP LIST('SIZE UNIT');
   (SIZE): K = 12345;
   PUT SKIP LIST('AFTER SIZE', K);
   ON FINISH PUT SKIP LIST('FINISH');
   SELECT (K);
     WHEN (1) PUT SKIP LIST('ONE');
   END;
   PUT SKIP LIST('NOT REACHED');
 END T6;
