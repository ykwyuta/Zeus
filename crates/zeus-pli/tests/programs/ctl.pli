 CTLT: PROC OPTIONS(MAIN);
   DCL X(*) FIXED BIN(31) CONTROLLED;
   DCL S CHAR(*) CONTROLLED;
   ALLOCATE X(3);
   X = 7;
   CALL FILL(X, 5);
   PUT SKIP LIST(ALLOCATION(X), DIM(X), X(5));
   FREE X;
   PUT SKIP LIST(ALLOCATION(X), DIM(X), X(1));
   CALL NAME(S);
   PUT SKIP LIST(S, LENGTH(S));
 FILL: PROC(A, N);
   DCL A(*) FIXED BIN(31) CONTROLLED;
   DCL N FIXED BIN(31);
   DCL K FIXED BIN(31);
   ALLOCATE A(N);
   DO K = 1 TO N; A(K) = K * 100; END;
 END FILL;
 NAME: PROC(T);
   DCL T CHAR(*) CONTROLLED;
   ALLOCATE T CHAR(6);
   T = 'ZEUSPL';
 END NAME;
 END CTLT;
