 DFTT: PROC OPTIONS(MAIN);
   DFT RANGE(I:N) FIXED BIN(15);
   DFT RANGE(S) CHAR;
   DFT RANGE(*) VALUE(CHAR(4), FIXED DEC(9,2));
   DCL I1 FIXED BIN;
   DCL K2 INIT(7);
   DCL SX;
   DCL A FIXED DEC;
   DCL B CHAR;
   K2 = K2 + 1;
   SX = 'ABCDEFG';
   A = 1234.567;
   PUT SKIP LIST(STG(I1), STG(K2), K2);
   PUT SKIP LIST(STG(SX), SX);
   PUT SKIP LIST(STG(A), A, STG(B));
 END DFTT;
