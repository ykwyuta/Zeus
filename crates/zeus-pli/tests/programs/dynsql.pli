 DYN: PROC OPTIONS(MAIN);
   EXEC SQL INCLUDE SQLCA;
   EXEC SQL INCLUDE SQLDA;
   DCL 1 ROW,
         2 ID FIXED BIN(31),
         2 NAME CHAR(10),
         2 RATE FLOAT DEC(16),
         2 AMT PIC'9999V99';
   DCL INDS(4) FIXED BIN(15);
   DCL STMT CHAR(200) VARYING;
   DCL (I, K, LOWID) FIXED BIN(31);
   DCL WID FIXED BIN(31);
   DCL WNAME CHAR(10);
   DCL WRATE FLOAT DEC(16);
   DCL WAMT FIXED DEC(6,2);
   DCL FLAG BIT(16);
   EXEC SQL DROP TABLE PLIDYN;
   STMT = 'CREATE TABLE PLIDYN (ID INTEGER NOT NULL, ' ||
          'NAME CHAR(10), RATE FLOAT, AMT DECIMAL(6,2), ' ||
          'FLAG CHAR(2) FOR BIT DATA)';
   EXEC SQL EXECUTE IMMEDIATE :STMT;
   PUT SKIP LIST('CREATE', SQLCODE);
   DO K = 1 TO 3;
     ID = K;
     NAME = 'ROW ' || TRIM(CHAR(K));
     RATE = K * 1.5E0;
     AMT = K * 12.25;
     EXEC SQL INSERT INTO PLIDYN (ID, NAME, RATE, AMT)
              VALUES (:ROW);
   END;
   STMT = 'UPDATE PLIDYN SET NAME = ? WHERE ID = ?';
   EXEC SQL PREPARE S1 FROM :STMT;
   WNAME = 'SECOND';
   WID = 2;
   EXEC SQL EXECUTE S1 USING :WNAME, :WID;
   PUT SKIP LIST('UPDATE', SQLCODE, SQLERRD(3));
   EXEC SQL SELECT ID, NAME, RATE, AMT INTO :ROW :INDS
            FROM PLIDYN WHERE ID = 2;
   PUT SKIP LIST(ID, NAME, RATE, AMT, INDS(2));
   STMT = 'SELECT ID, NAME, RATE, AMT FROM PLIDYN ' ||
          'WHERE ID >= ? ORDER BY ID';
   EXEC SQL PREPARE S2 FROM :STMT;
   EXEC SQL DECLARE C2 CURSOR FOR S2;
   LOWID = 2;
   EXEC SQL OPEN C2 USING :LOWID;
   EXEC SQL FETCH C2 INTO :ROW;
   DO WHILE(SQLCODE = 0);
     PUT SKIP LIST('C2', ID, NAME, AMT);
     EXEC SQL FETCH C2 INTO :ROW;
   END;
   EXEC SQL CLOSE C2;
   SQLSIZE = 4;
   ALLOCATE SQLDA;
   EXEC SQL DESCRIBE S2 INTO :SQLDA;
   PUT SKIP LIST('DESCRIBE', SQLCODE, SQLD);
   DO I = 1 TO SQLD;
     K = SQLTYPE(I);
     PUT SKIP LIST(K - MOD(K, 2), SQLLEN(I));
     SQLIND(I) = ADDR(INDS(I));
   END;
   SQLDATA(1) = ADDR(WID);
   SQLDATA(2) = ADDR(WNAME);
   SQLDATA(3) = ADDR(WRATE);
   SQLDATA(4) = ADDR(WAMT);
   LOWID = 1;
   EXEC SQL OPEN C2 USING :LOWID;
   EXEC SQL FETCH C2 USING DESCRIPTOR :SQLDA;
   DO WHILE(SQLCODE = 0);
     PUT SKIP LIST('SQLDA', WID, WNAME, WRATE, WAMT);
     EXEC SQL FETCH C2 USING DESCRIPTOR :SQLDA;
   END;
   EXEC SQL CLOSE C2;
   FLAG = '1010000011110000'B;
   EXEC SQL UPDATE PLIDYN SET FLAG = :FLAG WHERE ID = 1;
   FLAG = ''B;
   EXEC SQL SELECT FLAG INTO :FLAG FROM PLIDYN WHERE ID = 1;
   PUT SKIP LIST('BIT', FLAG, SQLCODE);
   STMT = 'DELETE FROM PLIDYN WHERE ID = 3';
   EXEC SQL EXECUTE IMMEDIATE :STMT;
   EXEC SQL SELECT COUNT(*) INTO :K FROM PLIDYN;
   PUT SKIP LIST('LEFT', K);
   EXEC SQL EXECUTE S9;
   PUT SKIP LIST('S9', SQLCODE);
 END DYN;
