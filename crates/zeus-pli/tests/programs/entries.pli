 ENTRIES: PROC OPTIONS(MAIN);
   DCL E ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31)) VARIABLE;
   DCL P ENTRY(CHAR(*)) VARIABLE;
   DCL TAB(2) ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31)) VARIABLE;
   DCL K FIXED BIN(31);
   E = TWICE;
   PUT SKIP LIST('TWICE', E(21));
   E = SQUARE;
   PUT SKIP LIST('SQUARE', E(7));
   TAB(1) = TWICE; TAB(2) = SQUARE;
   DO K = 1 TO 2;
     PUT SKIP LIST(K, TAB(K)(5));
   END;
   P = SAY;
   CALL P('HELLO');
   IF E = SQUARE THEN PUT SKIP LIST('SAME');
   CALL APPLY(TWICE, 4);
 TWICE: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(31);
   RETURN(X * 2);
 END TWICE;
 SQUARE: PROC(X) RETURNS(FIXED BIN(31));
   DCL X FIXED BIN(31);
   RETURN(X * X);
 END SQUARE;
 SAY: PROC(S);
   DCL S CHAR(*);
   PUT SKIP LIST('SAY ' || S);
 END SAY;
 APPLY: PROC(F, V);
   DCL F ENTRY(FIXED BIN(31)) RETURNS(FIXED BIN(31));
   DCL V FIXED BIN(31);
   PUT SKIP LIST('APPLY', F(V));
 END APPLY;
 END ENTRIES;
