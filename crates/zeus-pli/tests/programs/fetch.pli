 FETCHT: PROC OPTIONS(MAIN);
   DCL SUBA ENTRY(CHAR(*)) EXTERNAL;
   DCL OTHER ENTRY(CHAR(*));
   DCL MISSING ENTRY;
   FETCH SUBA;
   CALL SUBA('ONE');
   CALL SUBA('TWO');
   RELEASE SUBA;
   FETCH SUBA;
   CALL SUBA('AGAIN');
   FETCH OTHER TITLE('SUBA');
   CALL OTHER('TITLE');
   RELEASE *;
   ON ERROR BEGIN;
     PUT SKIP LIST('ERROR', ONCODE());
     GO TO DONE;
   END;
   FETCH MISSING;
   PUT SKIP LIST('NOT REACHED');
 DONE:
   PUT SKIP LIST('END');
 END FETCHT;
