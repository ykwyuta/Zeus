 T4: PROC OPTIONS(MAIN);
   DCL INFILE FILE RECORD INPUT;
   DCL OUTFILE FILE RECORD OUTPUT;
   DCL 1 REC,
         2 ID     CHAR(5),
         2 AMOUNT PIC '99999V99',
         2 REST   CHAR(68);
   DCL EOF BIT(1) INIT('0'B);
   DCL COUNT FIXED BIN(31) INIT(0);
   DCL SUM FIXED DEC(11,2) INIT(0);
   DCL (A, B, C) FIXED DEC(7,2);
   DCL NAME CHAR(12) VAR;
   DCL P POINTER;
   DCL 1 NODE BASED(P),
         2 VALUE FIXED BIN(31),
         2 NEXT  POINTER;
   DCL HEAD POINTER INIT(NULL());
   DCL I FIXED BIN(31);
   DCL WORD CHAR(8) INIT('ABCDEFGH');
   DCL PART CHAR(3) DEFINED WORD POSITION(4);
   DCL X FIXED BIN(15) INIT(-2);

   ON ENDFILE(INFILE) EOF = '1'B;
   OPEN FILE(INFILE), FILE(OUTFILE);
   READ FILE(INFILE) INTO(REC);
   DO WHILE (¬EOF);
     COUNT = COUNT + 1;
     SUM = SUM + AMOUNT;
     REST = 'SEEN';
     WRITE FILE(OUTFILE) FROM(REC);
     READ FILE(INFILE) INTO(REC);
   END;
   CLOSE FILE(INFILE), FILE(OUTFILE);
   PUT SKIP EDIT('RECORDS', COUNT, 'SUM', SUM)
     (A, F(5), X(2), A, F(12,2));

   GET LIST(A, B, NAME);
   C = A + B;
   PUT SKIP LIST(NAME, C);
   GET EDIT(A)(F(6,2));
   PUT SKIP LIST(A);

   DO I = 1 TO 3;
     ALLOCATE NODE;
     NODE.VALUE = I * 10;
     NODE.NEXT = HEAD;
     HEAD = P;
   END;
   P = HEAD;
   DO WHILE (P ¬= NULL());
     PUT SKIP LIST(P->VALUE);
     P = NEXT;
   END;
   PUT SKIP LIST(PART, UNSPEC(X), HEX(X));
   PUT SKIP EDIT(3.14159, -42, 'X')(E(12,4), F(6), A(3));
   PUT SKIP EDIT(12345.678)(P'ZZ,ZZ9.V99');
   CALL PLIRETC(4);
 END T4;
