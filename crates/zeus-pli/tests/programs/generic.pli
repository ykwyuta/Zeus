 GENT: PROC OPTIONS(MAIN);
   DCL SHOW GENERIC(SHOWN WHEN(FIXED),
                    SHOWC WHEN(CHAR),
                    SHOWF OTHERWISE);
   DEFINE ORDINAL COLOR (RED, GREEN VALUE(5), BLUE);
   DCL C TYPE COLOR;
   DCL K FIXED BIN(31);
   CALL SHOW(42);
   CALL SHOW('ABC');
   CALL SHOW(1.5E0);
   C = GREEN;
   PUT SKIP LIST(ORDINALNAME(C), BINVALUE(C),
                 ORDINALNAME(ORDINALSUCC(C)));
   DO C = FIRST(COLOR) UPTHRU LAST(COLOR);
     PUT SKIP LIST(ORDINALNAME(C));
   END;
   DO C = BLUE DOWNTHRU RED;
     PUT SKIP LIST(ORDINALNAME(C));
   END;
   DO K = 3 DOWNTHRU 1;
     PUT SKIP LIST(K);
   END;
 SHOWN: PROC(X); DCL X FIXED BIN(31); PUT SKIP LIST('FIXED', X); END;
 SHOWC: PROC(X); DCL X CHAR(*); PUT SKIP LIST('CHAR', X); END;
 SHOWF: PROC(X); DCL X FLOAT; PUT SKIP LIST('OTHER', X); END;
 END GENT;
