 T1: PROC OPTIONS(MAIN);
   DCL X FIXED DEC(5) INIT(42);
   DCL Y FIXED DEC(7,2) INIT(-3.5);
   DCL B FIXED BIN(31) INIT(12345);
   DCL F FLOAT DEC(6) INIT(1.5);
   DCL C CHAR(5) INIT('AB');
   DCL V CHAR(10) VAR INIT('HELLO');
   DCL Z FIXED DEC(15,5);
   PUT LIST(X, Y, B, F, C, V);
   PUT SKIP LIST(25+01/3);
   Z = 10/3;
   PUT SKIP LIST(Z);
   PUT SKIP EDIT(X, 'XYZ', Y) (F(6), A(5), F(8,2));
   PUT SKIP DATA(X, C);
 END T1;
