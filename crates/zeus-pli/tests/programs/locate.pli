 LOC: PROC OPTIONS(MAIN);
   DCL OUT  FILE RECORD OUTPUT;
   DCL INP  FILE RECORD INPUT;
   DCL REGO FILE RECORD KEYED DIRECT OUTPUT ENV(REGIONAL(1));
   DCL REGU FILE RECORD KEYED DIRECT UPDATE ENV(REGIONAL(1));
   DCL REGS FILE RECORD KEYED SEQUENTIAL INPUT ENV(REGIONAL(1));
   DCL RRO  FILE RECORD KEYED DIRECT OUTPUT;
   DCL RRS  FILE RECORD KEYED SEQUENTIAL INPUT;
   DCL Q POINTER;
   DCL 1 R BASED(Q),
         2 ID  CHAR(4),
         2 TXT CHAR(76);
   DCL BUF CHAR(80);
   DCL K CHAR(8);
   DCL (EOF, NOKEY) BIT(1) INIT('0'B);
   DCL I FIXED BIN(31);

   /* LOCATE: each buffer is written by the next LOCATE or the CLOSE */
   OPEN FILE(OUT);
   DO I = 1 TO 3;
     LOCATE R FILE(OUT);
     ID = SUBSTR('ABC', I, 1) || '001';
     TXT = 'LOCATED';
   END;
   CLOSE FILE(OUT);
   ON ENDFILE(INP) EOF = '1'B;
   OPEN FILE(INP);
   READ FILE(INP) INTO(BUF);
   DO WHILE (¬EOF);
     PUT SKIP LIST(SUBSTR(BUF, 1, 12));
     READ FILE(INP) INTO(BUF);
   END;
   CLOSE FILE(INP);

   /* REGIONAL(1): numbered regions from 0 */
   ON KEY(REGU) NOKEY = '1'B;
   OPEN FILE(REGO);
   BUF = 'REGION 2';
   WRITE FILE(REGO) FROM(BUF) KEYFROM('2');
   BUF = 'REGION 5';
   WRITE FILE(REGO) FROM(BUF) KEYFROM('5');
   BUF = 'REGION 0';
   WRITE FILE(REGO) FROM(BUF) KEYFROM('0');
   CLOSE FILE(REGO);
   OPEN FILE(REGU);
   READ FILE(REGU) INTO(BUF) KEY('5');
   PUT SKIP LIST(SUBSTR(BUF, 1, 10));
   BUF = 'REGION 5 UPDATED';
   REWRITE FILE(REGU) FROM(BUF) KEY('5');
   DELETE FILE(REGU) KEY('0');
   READ FILE(REGU) INTO(BUF) KEY('3');
   PUT SKIP LIST('KEY 3', NOKEY);
   CLOSE FILE(REGU);
   EOF = '0'B;
   ON ENDFILE(REGS) EOF = '1'B;
   OPEN FILE(REGS);
   READ FILE(REGS) INTO(BUF) KEYTO(K);
   DO WHILE (¬EOF);
     PUT SKIP LIST(K, SUBSTR(BUF, 1, 20));
     READ FILE(REGS) INTO(BUF) KEYTO(K);
   END;
   CLOSE FILE(REGS);

   /* VSAM RRDS: relative records from 1 */
   OPEN FILE(RRO);
   BUF = 'RECORD 7';
   WRITE FILE(RRO) FROM(BUF) KEYFROM('7');
   BUF = 'RECORD 1';
   WRITE FILE(RRO) FROM(BUF) KEYFROM('1');
   CLOSE FILE(RRO);
   EOF = '0'B;
   ON ENDFILE(RRS) EOF = '1'B;
   OPEN FILE(RRS);
   READ FILE(RRS) INTO(BUF) KEYTO(K);
   DO WHILE (¬EOF);
     PUT SKIP LIST(K, SUBSTR(BUF, 1, 8));
     READ FILE(RRS) INTO(BUF) KEYTO(K);
   END;
   CLOSE FILE(RRS);
 END LOC;
