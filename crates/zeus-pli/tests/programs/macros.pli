 %INCLUDE MACTRACE;
 %REPLACE TABSIZE BY 4;
 %DCL ENV CHAR;
 %ENV = 'TEST';
 /* a procedure that builds a statement */
 %SHOW: PROC(V) RETURNS(CHAR);
   DCL V CHAR;
   RETURN('PUT SKIP EDIT(''' || V || '='', ' || V || ')(A, F(6));');
 %END;
 %ACTIVATE SHOW NORESCAN;
 MAC: PROC OPTIONS(MAIN);
   DCL T(TABSIZE) FIXED BIN(31);
   DCL (I, TOTAL) FIXED BIN(31) INIT(0);
   %DCL K FIXED;
   %DO K = 1 TO TABSIZE;
     T(K) = K * 10;
   %END;
   DO I = 1 TO TABSIZE;
     TOTAL = TOTAL + T(I);
   END;
   SHOW(TOTAL)
   %IF ENV = 'PROD' %THEN %DO;
     PUT SKIP LIST('PRODUCTION');
   %END;
   %ELSE %DO;
     PUT SKIP LIST('NOT PRODUCTION');
   %END;
   %IF TRACE = 'ON' %THEN %DO;
     PUT SKIP LIST('TRACE IS ON');
   %END;
   %SELECT (TABSIZE);
     %WHEN (4) %DO; PUT SKIP LIST('FOUR'); %END;
     %OTHERWISE %DO; PUT SKIP LIST('OTHER'); %END;
   %END;
   %DEACTIVATE SHOW;
   CALL SHOW(1);
 SHOW: PROC(N);
   DCL N FIXED BIN(31);
   PUT SKIP LIST('CALLED', N);
 END SHOW;
 END MAC;
