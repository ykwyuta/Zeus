 REFERT: PROC OPTIONS(MAIN);
   DCL N FIXED BIN(31) INIT(3);
   DCL P POINTER;
   DCL 1 REC BASED(P),
         2 CNT FIXED BIN(31),
         2 ITEMS(N REFER(CNT)) CHAR(4),
         2 TAIL CHAR(5);
   ALLOCATE REC;
   ITEMS(1) = 'AAAA'; ITEMS(2) = 'BBBB'; ITEMS(3) = 'CCCC';
   TAIL = 'END!!';
   PUT SKIP LIST(CNT, ITEMS(3), TAIL, STG(REC));
   CNT = 2;
   PUT SKIP LIST(TAIL, STG(REC));
 END REFERT;
