 SQLT: PROC OPTIONS(MAIN);
   EXEC SQL INCLUDE SQLCA;
   EXEC SQL INCLUDE ACCTDCL;
   DCL NOTEI FIXED BIN(15);
   DCL N FIXED BIN(31);
   PUT SKIP LIST('SQLCA', STORAGE(SQLCA));
   EXEC SQL DROP TABLE PLIACCT;
   EXEC SQL CREATE TABLE PLIACCT (ID INTEGER NOT NULL,
            NAME VARCHAR(20), BAL DECIMAL(9,2), NOTE CHAR(10));
   DO ID = 1 TO 3;
     NAME = 'ACCOUNT ' || TRIM(CHAR(ID));
     BAL = ID * 100.25;
     EXEC SQL INSERT INTO PLIACCT VALUES (:ID, :NAME, :BAL, NULL);
   END;
   EXEC SQL SELECT COUNT(*), SUM(BAL) INTO :N, :BAL FROM PLIACCT;
   PUT SKIP LIST('COUNT', N, BAL, SQLCODE);
   EXEC SQL DECLARE C1 CURSOR FOR
            SELECT ID, NAME, BAL, NOTE FROM PLIACCT
            WHERE BAL > :BAL / 6 ORDER BY ID;
   BAL = 600;
   EXEC SQL WHENEVER NOT FOUND GO TO DONE;
   EXEC SQL OPEN C1;
   DO FOREVER;
     EXEC SQL FETCH C1 INTO :ID, :NAME, :BAL, :NOTE :NOTEI;
     PUT SKIP LIST(ID, NAME, BAL, NOTEI);
   END;
 DONE:
   EXEC SQL CLOSE C1;
   EXEC SQL WHENEVER NOT FOUND CONTINUE;
   EXEC SQL SELECT NAME INTO :NAME FROM PLIACCT WHERE ID = 9;
   PUT SKIP LIST('MISSING', SQLCODE, SQLSTATE);
   EXEC SQL UPDATE PLIACCT SET NOTE = 'RICH' WHERE ID = 3;
   PUT SKIP LIST('UPDATED', SQLERRD(3));
 END SQLT;
