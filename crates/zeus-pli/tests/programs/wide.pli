 WIDE: PROC OPTIONS(MAIN);
   DCL G GRAPHIC(4);
   DCL W WIDECHAR(5);
   DCL WV WIDECHAR(10) VARYING;
   DCL G2 GRAPHIC(4);
   DCL C CHAR(8);
   G = 'AB';
   W = 'Hello';
   WV = W || '!';
   G2 = G;
   C = W;
   PUT SKIP LIST(G, W, WV, LENGTH(WV));
   PUT SKIP LIST(STG(G), STG(W), STG(WV), C);
   PUT SKIP LIST(HEX(UNSPEC(G)));
   PUT SKIP LIST(HEX(UNSPEC(W)));
   PUT SKIP LIST(G2 = G, SUBSTR(W, 2, 3), INDEX(W, 'll'));
   PUT SKIP LIST(HEX(WIDECHAR(C)), HEX(GRAPHIC('X')));
   W = WIDECHAR('AB');
   PUT SKIP LIST(W, LENGTH(W));
 END WIDE;
