       CBL ARITH(EXTEND)
      * SPEC: ARITH AND FIXED-POINT INTERMEDIATE RESULTS; AUDIT A05.
      * SIZE ERROR USES A 30-DIGIT FINAL RECEIVER, NOT A 32-DIGIT
      * INTERMEDIATE THAT HAS ALREADY BEEN TRUNCATED TO 31 DIGITS.
      * ZA110A: 31-digit decimal precision and overflow
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZA110A.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REPORT-FILE ASSIGN TO REPORT.
       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE
           RECORDING MODE F
           RECORD CONTAINS 120 CHARACTERS.
       01  REPORT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
           COPY ZCVSRPT.
       01  WS-A PIC S9(31) COMP-3.
       01  WS-B PIC S9(31) DISPLAY.
       01  WS-SMALL PIC S9(30) COMP-3.
       01  WS-F PIC X.
       PROCEDURE DIVISION.
       MAIN-PROC SECTION.
       MAIN-000.
           MOVE 'ZA110A' TO ZCVS-PROG-ID.
           PERFORM ZCVS-BEGIN.

           MOVE 'EXTEND-PACKED-MAX' TO ZCVS-TEST-NAME.
           MOVE 9999999999999999999999999999999 TO WS-A.
           IF WS-A = 9999999999999999999999999999999
               PERFORM ZCVS-PASS
           ELSE
               MOVE '99999999999999999999' TO ZCVS-EXPECTED
               MOVE WS-A TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'EXTEND-DISPLAY-RT' TO ZCVS-TEST-NAME.
           MOVE WS-A TO WS-B.
           IF WS-B = WS-A
               PERFORM ZCVS-PASS
           ELSE
               MOVE '31-DIGIT ROUNDTRIP' TO ZCVS-EXPECTED
               MOVE WS-B TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'EXTEND-OVERFLOW' TO ZCVS-TEST-NAME.
           MOVE 123 TO WS-SMALL.
           MOVE 'N' TO WS-F.
           COMPUTE WS-SMALL = WS-A
             ON SIZE ERROR MOVE 'Y' TO WS-F
           END-COMPUTE.
           IF WS-F = 'Y' AND WS-SMALL = 123
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'Y/123' TO ZCVS-EXPECTED
               MOVE WS-F TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'EXTEND-CANCEL' TO ZCVS-TEST-NAME.
           SUBTRACT 9999999999999999999999999999999 FROM WS-A.
           IF WS-A = 0
               PERFORM ZCVS-PASS
           ELSE
               MOVE '0' TO ZCVS-EXPECTED
               MOVE WS-A TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'EXTEND-NEGATIVE' TO ZCVS-TEST-NAME.
           MOVE -9999999999999999999999999999999 TO WS-A.
           IF WS-A = -9999999999999999999999999999999
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'NEGATIVE 31 DIGITS' TO ZCVS-EXPECTED
               MOVE WS-A TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'EXTEND-INTERMEDIATE' TO ZCVS-TEST-NAME.
           COMPUTE WS-A =
             (1000000000000000000 * 1000000000000) / 10.
           IF WS-A = 100000000000000000000000000000
               PERFORM ZCVS-PASS
           ELSE
               MOVE '10 ** 29' TO ZCVS-EXPECTED
               MOVE WS-A TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           PERFORM ZCVS-END.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
           COPY ZCVSHEX.
           COPY ZCVSPROC.
