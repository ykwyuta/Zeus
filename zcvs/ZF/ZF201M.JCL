//ZF201M   JOB (ZCVS),'ZCVS TAPE VALIDATION',CLASS=A,MSGCLASS=X
//STEP1    EXEC PGM=ZF201M
//STEPLIB  DD DSN=USER.ZCVS.LOAD,DISP=SHR
//TAPE1    DD DSN=USER.ZCVS.TAPE1,UNIT=3480,VOL=SER=ZCVST1,
