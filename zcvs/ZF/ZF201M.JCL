//TAPE2    DD DSN=USER.ZCVS.TAPE2,UNIT=3480,VOL=SER=ZCVST2,
//            DISP=(NEW,PASS),DCB=(RECFM=U,BLKSIZE=12)
//REPORT   DD SYSOUT=*
