      * AUDIT: N06; SPECIFICATION AND LIMITS IN SCENARIOS.MD.
      * ZN113A: CCSID 1399 SBCS DBCS mixed independent conversion bytes
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZN113A.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REPORT-FILE ASSIGN TO REPORT.
       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE
           RECORDING MODE F
           RECORD CONTAINS 120 CHARACTERS.
       01  REPORT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
           COPY ZCVSRPT.
       01  NAT-TEXT PIC N(3) USAGE NATIONAL.
       01  DISPLAY-TEXT PIC X(8).
       01  BACK-TEXT PIC N(3) USAGE NATIONAL.
       PROCEDURE DIVISION.
       MAIN-PROC SECTION.
       MAIN-000.
           MOVE 'ZN113A' TO ZCVS-PROG-ID.
           PERFORM ZCVS-BEGIN.

           MOVE 'SBCS-ENCODE' TO ZCVS-TEST-NAME.
           MOVE NX'004100420043' TO NAT-TEXT.
           MOVE FUNCTION DISPLAY-OF(
             NAT-TEXT(1:3), 1399) TO DISPLAY-TEXT.
           IF DISPLAY-TEXT(1:3) = X'C1C2C3'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'SBCS-DECODE' TO ZCVS-TEST-NAME.
           MOVE FUNCTION NATIONAL-OF(
             DISPLAY-TEXT(1:3), 1399) TO BACK-TEXT.
           IF BACK-TEXT = NX'004100420043'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'DBCS-ENCODE' TO ZCVS-TEST-NAME.
           MOVE NX'65E5672C' TO NAT-TEXT.
           MOVE FUNCTION DISPLAY-OF(
             NAT-TEXT(1:2), 1399) TO DISPLAY-TEXT.
           IF DISPLAY-TEXT(1:6) = X'0E456245660F'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'DBCS-DECODE' TO ZCVS-TEST-NAME.
           MOVE FUNCTION NATIONAL-OF(
             DISPLAY-TEXT(1:6), 1399) TO BACK-TEXT.
           IF BACK-TEXT = NX'65E5672C0020'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'MIXED-ENCODE' TO ZCVS-TEST-NAME.
           MOVE NX'004165E50042' TO NAT-TEXT.
           MOVE FUNCTION DISPLAY-OF(
             NAT-TEXT(1:3), 1399) TO DISPLAY-TEXT.
           IF DISPLAY-TEXT(1:6) = X'C10E45620FC2'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'MIXED-DECODE' TO ZCVS-TEST-NAME.
           MOVE FUNCTION NATIONAL-OF(
             DISPLAY-TEXT(1:6), 1399) TO BACK-TEXT.
           IF BACK-TEXT = NX'004165E50042'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SPEC RESULT' TO ZCVS-EXPECTED
               MOVE 'MISMATCH' TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           PERFORM ZCVS-END.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
           COPY ZCVSHEX.
           COPY ZCVSPROC.
