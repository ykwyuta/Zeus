      * SPEC: POINTER SET/ENTRY/CALL; AUDIT P06.
      * ZP108A: Pointer copy rebinding and indirect ENTRY alias
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZP108A.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REPORT-FILE ASSIGN TO REPORT.
       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE
           RECORDING MODE F
           RECORD CONTAINS 120 CHARACTERS.
       01  REPORT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
           COPY ZCVSRPT.
       01  PP USAGE PROCEDURE-POINTER VALUE NULL.
       01  SAVED-PP USAGE PROCEDURE-POINTER VALUE NULL.
       01  DP USAGE POINTER VALUE NULL.
       01  SAVED-DP USAGE POINTER VALUE NULL.
       01  TARGET-NAME PIC X(8) VALUE 'ZPS04B'.
       01  INPUT-TEXT PIC X(4) VALUE 'ABCD'.
       01  OUTPUT-TEXT PIC X(8).
       01  BUFFER-A PIC X(8) VALUE 'ORIGIN-A'.
       01  BUFFER-B PIC X(8) VALUE 'ORIGIN-B'.
       01  RESULT-NUM PIC 9(4) COMP.
       LINKAGE SECTION.
       01  VIEW-ITEM PIC X(8).
       PROCEDURE DIVISION.
       MAIN-PROC SECTION.
       MAIN-000.
           MOVE 'ZP108A' TO ZCVS-PROG-ID.
           PERFORM ZCVS-BEGIN.

           MOVE 'DATA-PTR-COPY' TO ZCVS-TEST-NAME.
           SET DP TO ADDRESS OF BUFFER-A.
           SET SAVED-DP TO DP.
           SET DP TO NULL.
           SET ADDRESS OF VIEW-ITEM TO SAVED-DP.
           IF DP = NULL AND SAVED-DP NOT = NULL
             AND VIEW-ITEM = 'ORIGIN-A'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'NULL/ORIGIN-A' TO ZCVS-EXPECTED
               MOVE VIEW-ITEM TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'DATA-PTR-REBIND' TO ZCVS-TEST-NAME.
           SET ADDRESS OF VIEW-ITEM TO ADDRESS OF BUFFER-B.
           MOVE 'CHANGEDB' TO VIEW-ITEM.
           IF BUFFER-A = 'ORIGIN-A' AND BUFFER-B = 'CHANGEDB'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'ORIGIN-A/CHANGEDB' TO ZCVS-EXPECTED
               MOVE BUFFER-B TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'PROC-ALIAS-DYNAMIC' TO ZCVS-TEST-NAME.
           SET PP TO ENTRY TARGET-NAME.
           CALL PP USING INPUT-TEXT OUTPUT-TEXT.
           IF OUTPUT-TEXT = 'ENT:ABCD'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'ENT:ABCD' TO ZCVS-EXPECTED
               MOVE OUTPUT-TEXT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'PROC-COPY-AFTER-NULL' TO ZCVS-TEST-NAME.
           SET SAVED-PP TO PP.
           SET PP TO NULL.
           MOVE 'EFGH' TO INPUT-TEXT.
           CALL SAVED-PP USING INPUT-TEXT OUTPUT-TEXT.
           IF PP = NULL AND OUTPUT-TEXT = 'ENT:EFGH'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'NULL/ENT:EFGH' TO ZCVS-EXPECTED
               MOVE OUTPUT-TEXT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'PROC-REBIND-OTHER' TO ZCVS-TEST-NAME.
           SET PP TO ENTRY 'ZPS05A'.
           CALL PP RETURNING RESULT-NUM.
           IF RESULT-NUM = 10
               PERFORM ZCVS-PASS
           ELSE
               MOVE '10' TO ZCVS-EXPECTED
               MOVE RESULT-NUM TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'PROC-COPY-INDEP' TO ZCVS-TEST-NAME.
           MOVE 'IJKL' TO INPUT-TEXT.
           CALL SAVED-PP USING INPUT-TEXT OUTPUT-TEXT.
           IF OUTPUT-TEXT = 'ENT:IJKL'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'ENT:IJKL' TO ZCVS-EXPECTED
               MOVE OUTPUT-TEXT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'PROC-NULL-TRANSITION' TO ZCVS-TEST-NAME.
           SET PP SAVED-PP TO NULL.
           IF PP = NULL AND SAVED-PP = NULL
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'NULL/NULL' TO ZCVS-EXPECTED
               MOVE OUTPUT-TEXT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           PERFORM ZCVS-END.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
           COPY ZCVSHEX.
           COPY ZCVSPROC.
