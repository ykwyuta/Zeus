      * SPEC: REPLACE STATEMENT SCOPE; AUDIT S01/X04.
      * ZS105A: REPLACE exact partial OFF nested and program scope
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZS105A.
       ENVIRONMENT DIVISION.
       INPUT-OUTPUT SECTION.
       FILE-CONTROL.
           SELECT REPORT-FILE ASSIGN TO REPORT.
       DATA DIVISION.
       FILE SECTION.
       FD  REPORT-FILE
           RECORDING MODE F
           RECORD CONTAINS 120 CHARACTERS.
       01  REPORT-RECORD PIC X(120).
       WORKING-STORAGE SECTION.
           COPY ZCVSRPT.
       01  SHARED-RESULTS GLOBAL.
           05  NESTED-RESULT PIC X(8).
           05  OTHER-RESULT PIC X(8).
       01  EXPECTED-ORIGINAL PIC X(8) VALUE 'ORIGINAL'.
       REPLACE ==SEED== BY ==HARVEST==.
       01  SEED PIC X(8) VALUE 'PARENT'.
       01  SEEDLING PIC X(9) VALUE 'UNCHANGED'.
       01  LITERAL-TEXT PIC X(8) VALUE 'SEED'.
       REPLACE OFF.
       01  SEED PIC X(8) VALUE 'OFF'.
       REPLACE ==ALPHA== BY ==BETA==.
       01  ALPHA PIC X(8) VALUE 'FIRST'.
       REPLACE ==OMEGA== BY ==FINAL==.
       01  ALPHA PIC X(8) VALUE 'SECOND'.
       01  OMEGA PIC X(8) VALUE 'THIRD'.
       REPLACE OFF.
       REPLACE LEADING ==OLD-== BY ====.
       01  OLD-CUT PIC X(8) VALUE 'CUT'.
       REPLACE OFF.
       REPLACE ==NEST-SEED== BY ==NEST-FRUIT==
               =='ORIGINAL'== BY =='REPLACED'==.
       PROCEDURE DIVISION.
       MAIN-PROC SECTION.
       MAIN-000.
           MOVE 'ZS105A' TO ZCVS-PROG-ID.
           PERFORM ZCVS-BEGIN.

           MOVE 'REPLACE-EXACT-WORD' TO ZCVS-TEST-NAME.
           IF HARVEST = 'PARENT' AND SEEDLING = 'UNCHANGED'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'PARENT/UNCHANGED' TO ZCVS-EXPECTED
               MOVE HARVEST TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-LITERAL-SAFE' TO ZCVS-TEST-NAME.
           IF LITERAL-TEXT = 'SEED'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'SEED' TO ZCVS-EXPECTED
               MOVE LITERAL-TEXT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-OFF' TO ZCVS-TEST-NAME.
           IF SEED = 'OFF'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'OFF' TO ZCVS-EXPECTED
               MOVE SEED TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-NEW-SCOPE' TO ZCVS-TEST-NAME.
           IF BETA = 'FIRST' AND ALPHA = 'SECOND'
             AND FINAL = 'THIRD'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'FIRST/SECOND/THIRD' TO ZCVS-EXPECTED
               MOVE ALPHA TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-EMPTY-PART' TO ZCVS-TEST-NAME.
           IF CUT = 'CUT'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'CUT' TO ZCVS-EXPECTED
               MOVE CUT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-NEST-INHERIT' TO ZCVS-TEST-NAME.
           CALL 'ZSS05N'.
           IF NESTED-RESULT = 'REPLACED'
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'REPLACED' TO ZCVS-EXPECTED
               MOVE NESTED-RESULT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           MOVE 'REPLACE-PROGRAM-END' TO ZCVS-TEST-NAME.
           CALL 'ZSS05B' USING OTHER-RESULT.
           IF OTHER-RESULT = EXPECTED-ORIGINAL
               PERFORM ZCVS-PASS
           ELSE
               MOVE 'ORIGINAL' TO ZCVS-EXPECTED
               MOVE OTHER-RESULT TO ZCVS-ACTUAL
               PERFORM ZCVS-FAIL
           END-IF.

           PERFORM ZCVS-END.
           MOVE 0 TO RETURN-CODE.
           STOP RUN.
           COPY ZCVSHEX.
           COPY ZCVSPROC.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZSS05N.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01  NEST-SEED PIC X(8) VALUE 'ORIGINAL'.
       PROCEDURE DIVISION.
           MOVE NEST-FRUIT TO NESTED-RESULT.
           GOBACK.
       END PROGRAM ZSS05N.
       END PROGRAM ZS105A.
       IDENTIFICATION DIVISION.
       PROGRAM-ID. ZSS05B.
       DATA DIVISION.
       LINKAGE SECTION.
       01  LK-RESULT PIC X(8).
       PROCEDURE DIVISION USING LK-RESULT.
           MOVE 'ORIGINAL' TO LK-RESULT.
           GOBACK.
       END PROGRAM ZSS05B.
