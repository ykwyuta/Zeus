      *================================================================*
      * ZCVSPROC - ZCVS SELF-CHECKING REPORT PROCEDURES                *
      *================================================================*
       ZCVS-BEGIN SECTION.
       ZCVS-BEGIN-P.
           OPEN OUTPUT REPORT-FILE.
           MOVE SPACES TO REPORT-RECORD.
           STRING '  ZCVS TEST RESULTS FOR ' ZCVS-PROG-ID
             DELIMITED BY SIZE INTO REPORT-RECORD.
           WRITE REPORT-RECORD AFTER ADVANCING 1 LINE.
           MOVE SPACES TO REPORT-RECORD.
           WRITE REPORT-RECORD AFTER ADVANCING 1 LINE.
       ZCVS-BEGIN-EXIT.
           EXIT.

       ZCVS-PASS SECTION.
       ZCVS-PASS-P.
           ADD 1 TO ZCVS-PASS-COUNT.
           ADD 1 TO ZCVS-TOTAL-COUNT.
           MOVE 'PASS ' TO ZCVS-STATUS.
           MOVE ZCVS-TEST-NAME TO ZCVS-LINE-TEST.
           WRITE REPORT-RECORD FROM ZCVS-LINE AFTER ADVANCING 1 LINE.
           MOVE SPACES TO ZCVS-DETAIL.
       ZCVS-PASS-EXIT.
           EXIT.

       ZCVS-FAIL SECTION.
       ZCVS-FAIL-P.
           ADD 1 TO ZCVS-FAIL-COUNT.
           ADD 1 TO ZCVS-TOTAL-COUNT.
           MOVE 'FAIL*' TO ZCVS-STATUS.
           MOVE ZCVS-TEST-NAME TO ZCVS-LINE-TEST.
           MOVE SPACES TO ZCVS-DETAIL.
           STRING 'EXP=' ZCVS-EXPECTED ' ACT=' ZCVS-ACTUAL
             DELIMITED BY SIZE INTO ZCVS-DETAIL.
           WRITE REPORT-RECORD FROM ZCVS-LINE AFTER ADVANCING 1 LINE.
           MOVE SPACES TO ZCVS-DETAIL.
       ZCVS-FAIL-EXIT.
           EXIT.

       ZCVS-END SECTION.
       ZCVS-END-P.
           MOVE SPACES TO REPORT-RECORD.
           WRITE REPORT-RECORD AFTER ADVANCING 1 LINE.
           MOVE SPACES TO ZCVS-TOTAL-LINE.
           STRING '  ' ZCVS-PASS-COUNT ' OF ' ZCVS-TOTAL-COUNT
             ' TESTS WERE EXECUTED SUCCESSFULLY'
             DELIMITED BY SIZE INTO ZCVS-TOTAL-LINE.
           WRITE REPORT-RECORD FROM ZCVS-TOTAL-LINE
             AFTER ADVANCING 1 LINE.
           MOVE SPACES TO ZCVS-TOTAL-LINE.
           IF ZCVS-FAIL-COUNT = 0
               MOVE '       NO TEST(S) FAILED' TO ZCVS-TOTAL-LINE
           ELSE
               STRING '  ' ZCVS-FAIL-COUNT ' TEST(S) FAILED'
                 DELIMITED BY SIZE INTO ZCVS-TOTAL-LINE
           END-IF.
           WRITE REPORT-RECORD FROM ZCVS-TOTAL-LINE
             AFTER ADVANCING 1 LINE.
           MOVE '       NO TEST(S) DELETED' TO REPORT-RECORD.
           WRITE REPORT-RECORD AFTER ADVANCING 1 LINE.
           MOVE '       NO TEST(S) REQUIRE VISUAL INSPECTION'
             TO REPORT-RECORD.
           WRITE REPORT-RECORD AFTER ADVANCING 1 LINE.
           MOVE SPACES TO ZCVS-TOTAL-LINE.
           STRING '  END OF TEST-2 ' ZCVS-PROG-ID
             DELIMITED BY SIZE INTO ZCVS-TOTAL-LINE.
           WRITE REPORT-RECORD FROM ZCVS-TOTAL-LINE
             AFTER ADVANCING 1 LINE.
           CLOSE REPORT-FILE.
       ZCVS-END-EXIT.
           EXIT.
