         MACRO
         ZHVSSUM
         MVC ZLINE(120),ZBLANK
         UNPK ZLINE(6),ZPASS
         OI ZLINE+5,X'F0'
         MVC ZLINE+6(4),=C' OF '
         UNPK ZLINE+10(6),ZTOTAL
         OI ZLINE+15,X'F0'
         MVC ZLINE+16(33),=C' TESTS WERE EXECUTED SUCCESSFULLY'
         ZHVSPUT
         MVC ZLINE(120),ZBLANK
         UNPK ZLINE(6),ZFAIL
         OI ZLINE+5,X'F0'
         MVC ZLINE+6(15),=C' TEST(S) FAILED'
         ZHVSPUT
         MVC ZLINE(120),ZBLANK
         MVC ZLINE(18),=C'NO TEST(S) DELETED'
         ZHVSPUT
         MVC ZCMD(4),=F'2'
         LA 1,ZPLIST
         L 15,=V(ZHVRPT)
         BASR 14,15
         L 14,ZRETURN
         XR 15,15
         BR 14
ZRETURN  DS F
ZPASS    DC PL4'0'
ZFAIL    DC PL4'0'
ZTOTAL   DC PL4'0'
ZBLANK   DC CL120' '
ZPLIST   DC A(ZCMD+X'80000000')
ZCMD     DC F'0'
ZLINE    DS CL120
         MEND
