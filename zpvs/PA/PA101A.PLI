 PA101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL A FIXED DEC(5,2), B FIXED DEC(4,1);
 DCL R FIXED DEC(15,5);
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 /* FIXED-ADD */
 A=123.45; B=6.3; R=A+B;
 CALL ZCHECK('FIXED-ADD',
   R=129.75);

 /* FIXED-SUB */
 R=A-B;
 CALL ZCHECK('FIXED-SUB',
   R=117.15);

 /* FIXED-MUL */
 R=A*B;
 CALL ZCHECK('FIXED-MUL',
   R=777.735);

 /* FIXED-DIV */
 R=A/B;
 CALL ZCHECK('FIXED-DIV',
   R=19.59523);

 /* BINARY-MIXED */
 N=7; R=A+N;
 CALL ZCHECK('BINARY-MIXED',
   R=130.44531);

 /* EXPLICIT-ADD */
 R=ADD(A,B,12,3);
 CALL ZCHECK('EXPLICIT-ADD',
   R=129.75);

 /* EXPLICIT-MULTIPLY */
 R=MULTIPLY(A,B,12,3);
 CALL ZCHECK('EXPLICIT-MULTIPLY',
   R=777.735);

 /* EXPLICIT-DIVIDE */
 R=DIVIDE(A,B,15,5);
 CALL ZCHECK('EXPLICIT-DIVIDE',
   R=19.59523);

 /* POWER-NEG */
 R=2**(-3);
 CALL ZCHECK('POWER-NEG',
   R=0.125);

 /* POWER-ZERO */
 R=7**0;
 CALL ZCHECK('POWER-ZERO',
   R=1);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PA101A;
