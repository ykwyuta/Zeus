 PA102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED DEC(5,2);
 DCL C CHAR(10);
 DCL B BIT(8);

 OPEN FILE(REPORT);

 /* CHAR-TO-NUM */
 C=' -12.34'; N=C;
 CALL ZCHECK('CHAR-TO-NUM',
   N=-12.34);

 /* NUM-TO-CHAR */
 C=N;
 CALL ZCHECK('NUM-TO-CHAR',
   TRIM(C)='-12.34');

 /* BIN-TO-BIT */
 B=5;
 CALL ZCHECK('BIN-TO-BIT',
   B='01010000'B);

 /* BIT-TO-BIN */
 N=B;
 CALL ZCHECK('BIT-TO-BIN',
   N=80);

 /* AND-BITS */
 CALL ZCHECK('AND-BITS',
   ('1010'B & '1100'B)='1000'B);

 /* OR-BITS */
 CALL ZCHECK('OR-BITS',
   ('1010'B | '1100'B)='1110'B);

 /* NOT-BITS */
 CALL ZCHECK('NOT-BITS',
   ^'1010'B='0101'B);

 /* BOOL-XOR */
 CALL ZCHECK('BOOL-XOR',
   BOOL('1010'B,'1100'B,'0110'B)='0110'B);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PA102A;
