 PA103A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL P PIC'ZZZ9V.99';
 DCL F PIC'S9V.999ES99';
 DCL G PIC'99V99KS9';

 OPEN FILE(REPORT);

 /* PIC-POS */
 P=12.34;
 CALL ZCHECK('PIC-POS',
   HEX(UNSPEC(P))='4040F1F24BF3F4');

 /* PIC-ZERO */
 P=0;
 CALL ZCHECK('PIC-ZERO',
   HEX(UNSPEC(P))='404040F04BF0F0');

 /* PIC-MAX */
 P=9999.99;
 CALL ZCHECK('PIC-MAX',
   HEX(UNSPEC(P))='F9F9F9F94BF9F9');

 /* FLOAT-PIC-NORMAL */
 F=1234.5;
 CALL ZCHECK('FLOAT-PIC-NORMAL',
   HEX(UNSPEC(F))='4EF14BF2F3F4C54EF0F3');

 /* FLOAT-PIC-NEG */
 F=-0.05;
 CALL ZCHECK('FLOAT-PIC-NEG',
   HEX(UNSPEC(F))='60F54BF0F0F0C560F0F2');

 /* PIC-SCALE */
 G=12.5;
 CALL ZCHECK('PIC-SCALE',
   HEX(UNSPEC(G))='F1F2F5F04EF0');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PA103A;
