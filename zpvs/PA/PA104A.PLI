 PA104A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL A(2,3) FIXED BIN(31);
 DCL B(2,3) FIXED BIN(31);
 DCL S CHAR(6) INIT('ABCDEF');
 DCL 1 X, 2 FIRST FIXED BIN(31), 2 SECOND CHAR(2);
 DCL 1 Y, 2 SECOND CHAR(2), 2 FIRST FIXED BIN(31);

 OPEN FILE(REPORT);

 /* ARRAY-BROADCAST */
 A=7;
 CALL ZCHECK('ARRAY-BROADCAST',
   SUM(A)=42);

 /* ARRAY-ARITH */
 B=A+2;
 CALL ZCHECK('ARRAY-ARITH',
   SUM(B)=54);

 /* ARRAY-SECTION */
 A(*,2)=3;
 CALL ZCHECK('ARRAY-SECTION',
   A(1,2)=3 & A(2,2)=3 & A(1,1)=7);

 /* ARRAY-BOUNDS */
 CALL ZCHECK('ARRAY-BOUNDS',
   DIM(A,1)=2 & DIM(A,2)=3);

 /* BY-NAME */
 X.FIRST=17; X.SECOND='OK'; Y=X,BY NAME;
 CALL ZCHECK('BY-NAME',
   Y.FIRST=17 & Y.SECOND='OK');

 /* SUBSTR-PSEUDO */
 SUBSTR(S,3,2)='XY';
 CALL ZCHECK('SUBSTR-PSEUDO',
   S='ABXYEF');

 /* UNSPEC-PSEUDO */
 UNSPEC(S)='111100011111001011110011111101001111010111110110'B;
 CALL ZCHECK('UNSPEC-PSEUDO',
   S='123456');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PA104A;
