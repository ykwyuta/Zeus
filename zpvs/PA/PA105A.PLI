 PA105A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Numeric picture editing: a point without V is an insertion
    character, drifting and credit symbols, overpunched sign, and
    the arithmetic value of an edited image. */
 DCL P1 PIC'ZZ9.99';
 DCL P2 PIC'ZZ9V.99';
 DCL P3 PIC'$$$9V.99';
 DCL P4 PIC'ZZ9V.99CR';
 DCL P5 PIC'99T';
 DCL D FIXED DEC(7,2);

 OPEN FILE(REPORT);

 /* PIC-POINT-INSERTION */
 P1=12.3;
 CALL ZCHECK('PIC-POINT-INSERTION',
   HEX(UNSPEC(P1))='4040F04BF1F2');

 /* PIC-POINT-WITH-V */
 P2=12.3;
 CALL ZCHECK('PIC-POINT-WITH-V',
   HEX(UNSPEC(P2))='40F1F24BF3F0');

 /* PIC-DRIFT-CURRENCY */
 P3=1.23;
 CALL ZCHECK('PIC-DRIFT-CURRENCY',
   HEX(UNSPEC(P3))='40405BF14BF2F3');

 /* PIC-CREDIT-NEGATIVE */
 P4=-1.5;
 CALL ZCHECK('PIC-CREDIT-NEGATIVE',
   HEX(UNSPEC(P4))='4040F14BF5F0C3D9');

 /* PIC-CREDIT-POSITIVE */
 P4=1.5;
 CALL ZCHECK('PIC-CREDIT-POSITIVE',
   HEX(UNSPEC(P4))='4040F14BF5F04040');

 /* PIC-OVERPUNCH-NEGATIVE */
 P5=-123;
 CALL ZCHECK('PIC-OVERPUNCH-NEGATIVE',
   HEX(UNSPEC(P5))='F1F2D3');

 /* PIC-EDITED-VALUE */
 P4=-1.5; D=P4;
 CALL ZCHECK('PIC-EDITED-VALUE',
   D=-1.5);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PA105A;
