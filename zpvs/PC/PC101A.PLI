 PC101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL (I,J,T) FIXED BIN(31);

 OPEN FILE(REPORT);

 /* DO-TO-BY */
 T=0; DO I=1 TO 9 BY 2; T=T+I; END;
 CALL ZCHECK('DO-TO-BY',
   T=25);

 /* DO-NEG-BY */
 T=0; DO I=10 TO 1 BY -3; T=T+I; END;
 CALL ZCHECK('DO-NEG-BY',
   T=22);

 /* DO-WHILE-ZERO */
 I=0; DO WHILE(I<0); I=99; END;
 CALL ZCHECK('DO-WHILE-ZERO',
   I=0);

 /* DO-UNTIL-ONCE */
 I=0; DO UNTIL(I>0); I=I+1; END;
 CALL ZCHECK('DO-UNTIL-ONCE',
   I=1);

 /* DO-ITERATE */
 T=0; DO I=1 TO 5;
 IF MOD(I,2)=0 THEN ITERATE; T=T+I; END;
 CALL ZCHECK('DO-ITERATE',
   T=9);

 /* DO-LEAVE-LABEL */
 T=0; OUTER: DO I=1 TO 3;
 DO J=1 TO 3; IF J=3 THEN LEAVE OUTER; T=T+1; END;
 END OUTER;
 CALL ZCHECK('DO-LEAVE-LABEL',
   T=2);

 /* SELECT-WHEN */
 SELECT(2); WHEN(1) T=11;
 WHEN(2,3) T=12; OTHERWISE T=13; END;
 CALL ZCHECK('SELECT-WHEN',
   T=12);

 /* SELECT-OTHER */
 SELECT(9); WHEN(1) T=11;
 OTHERWISE T=13; END;
 CALL ZCHECK('SELECT-OTHER',
   T=13);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC101A;
