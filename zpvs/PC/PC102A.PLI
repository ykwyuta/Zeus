 PC102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31);
 DCL OUTER FIXED BIN(31) INIT(7);

 OPEN FILE(REPORT);

 /* RECURSIVE-0 */
 CALL ZCHECK('RECURSIVE-0',
   FACT(0)=1);

 /* RECURSIVE-1 */
 CALL ZCHECK('RECURSIVE-1',
   FACT(1)=1);

 /* RECURSIVE-2 */
 CALL ZCHECK('RECURSIVE-2',
   FACT(2)=2);

 /* RECURSIVE-3 */
 CALL ZCHECK('RECURSIVE-3',
   FACT(3)=6);

 /* RECURSIVE-4 */
 CALL ZCHECK('RECURSIVE-4',
   FACT(4)=24);

 /* RECURSIVE-5 */
 CALL ZCHECK('RECURSIVE-5',
   FACT(5)=120);

 /* RECURSIVE-6 */
 CALL ZCHECK('RECURSIVE-6',
   FACT(6)=720);

 /* RECURSIVE-7 */
 CALL ZCHECK('RECURSIVE-7',
   FACT(7)=5040);

 /* RECURSIVE-8 */
 CALL ZCHECK('RECURSIVE-8',
   FACT(8)=40320);

 /* LEXICAL-PARENT */
 CALL ZCHECK('LEXICAL-PARENT',
   READP()=7);

 /* LEXICAL-SHADOW */
 CALL ZCHECK('LEXICAL-SHADOW',
   SHADOW()=99 & OUTER=7);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 FACT: PROC(N) RETURNS(FIXED DEC(15)) RECURSIVE;
 DCL N FIXED BIN(31);
 DCL SAVED FIXED BIN(31);
 SAVED=N;
 IF N<2 THEN RETURN(1);
 RETURN(SAVED*FACT(N-1));
 END FACT;
 READP: PROC RETURNS(FIXED BIN(31));
 RETURN(OUTER);
 END READP;
 SHADOW: PROC RETURNS(FIXED BIN(31));
 DCL OUTER FIXED BIN(31) INIT(99);
 RETURN(OUTER);
 END SHADOW;
 END PC102A;
