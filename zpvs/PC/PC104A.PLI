 PC104A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL PCS01A ENTRY(FIXED BIN(31)) EXTERNAL;
 DCL OTHER ENTRY(FIXED BIN(31));
 DCL MISSING ENTRY;
 DCL (N,CODE) FIXED BIN(31);

 OPEN FILE(REPORT);

 /* FETCH-FIRST */
 FETCH PCS01A; CALL PCS01A(N);
 CALL ZCHECK('FETCH-FIRST',
   N=1);

 /* FETCH-STATIC */
 CALL PCS01A(N);
 CALL ZCHECK('FETCH-STATIC',
   N=2);

 /* RELEASE-RESET */
 RELEASE PCS01A; FETCH PCS01A; CALL PCS01A(N);
 CALL ZCHECK('RELEASE-RESET',
   N=1);

 /* FETCH-TITLE */
 FETCH OTHER TITLE('PCS01A'); CALL OTHER(N);
 CALL ZCHECK('FETCH-TITLE',
   N=2);

 /* FETCH-MISSING */
 ON ERROR BEGIN; CODE=ONCODE(); GO TO RECOVER; END;
 FETCH MISSING; RECOVER:;
 CALL ZCHECK('FETCH-MISSING',
   CODE=9251);

 /* FETCH-RECOVER */
 REVERT ERROR; CALL PCS01A(N);
 CALL ZCHECK('FETCH-RECOVER',
   N=3);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC104A;
