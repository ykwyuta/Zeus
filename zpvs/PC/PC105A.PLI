 PC105A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL FLAG FIXED BIN(31) INIT(0);
 DCL BAD CONDITION;

 OPEN FILE(REPORT);

 /* SIGNAL-DYNAMIC */
 ON CONDITION(BAD) FLAG=FLAG+1;
 CALL CHILD;
 CALL ZCHECK('SIGNAL-DYNAMIC',
   FLAG=1);

 /* REVERT-PARENT */
 CALL OVERRIDE;
 CALL ZCHECK('REVERT-PARENT',
   FLAG=12);

 /* OUTER-REMAINS */
 SIGNAL CONDITION(BAD);
 CALL ZCHECK('OUTER-REMAINS',
   FLAG=13);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 CHILD: PROC;
 SIGNAL CONDITION(BAD); END CHILD;
 OVERRIDE: PROC;
 ON CONDITION(BAD) FLAG=FLAG+10;
 SIGNAL CONDITION(BAD);
 REVERT CONDITION(BAD);
 SIGNAL CONDITION(BAD);
 END OVERRIDE;
 END PC105A;
