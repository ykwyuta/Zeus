 PC106A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL FLAG FIXED BIN(31) INIT(0);
 DCL CODE FIXED BIN(31);
 DCL R FIXED BIN(31), Z FIXED BIN(31) INIT(0);
 DCL SMALL FIXED DEC(2);

 OPEN FILE(REPORT);

 /* ZERODIVIDE-HANDLER */
 ON ZERODIVIDE BEGIN; FLAG=1; CODE=ONCODE();
 GO TO AFTERDIV; END;
 R=1/Z; AFTERDIV:;
 CALL ZCHECK('ZERODIVIDE-HANDLER',
   FLAG=1 & CODE=320);

 /* SIZE-HANDLER */
 ON SIZE FLAG=2; (SIZE): SMALL=123;
 CALL ZCHECK('SIZE-HANDLER',
   FLAG=2);

 /* RECOVER-ARITH */
 R=12+5;
 CALL ZCHECK('RECOVER-ARITH',
   R=17);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC106A;
