 PC107A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL S CHAR(5) INIT('12X45');
 DCL N FIXED DEC(5), SEEN CHAR(1);
 DCL CALLS FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* CONVERSION-REPAIR */
 ON CONVERSION BEGIN; SEEN=ONCHAR(); CALLS=CALLS+1;
 ONCHAR()='3'; END; N=S;
 CALL ZCHECK('CONVERSION-REPAIR',
   N=12345 & SEEN='X' & CALLS=1);

 /* CONVERSION-INPUT-KEPT */
 CALL ZCHECK('CONVERSION-INPUT-KEPT',
   S='12X45');

 /* CONVERSION-SUCCESS */
 S='54321'; N=S;
 CALL ZCHECK('CONVERSION-SUCCESS',
   N=54321 & CALLS=1);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC107A;
