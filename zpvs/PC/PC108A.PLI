 PC108A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL S CHAR(8), N FIXED DEC(5);
 DCL SEEN CHAR(8);
 DCL CALLS FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* ONSOURCE-REPAIR */
 ON CONVERSION BEGIN; SEEN=ONSOURCE(); CALLS=CALLS+1;
 ONSOURCE()='54321'; END; S='BAD'; N=S;
 CALL ZCHECK('ONSOURCE-REPAIR',
   N=54321 & SEEN='BAD' & CALLS=1);

 /* ONSOURCE-INPUT-KEPT */
 CALL ZCHECK('ONSOURCE-INPUT-KEPT',
   S='BAD');

 /* ONSOURCE-REPEAT */
 S='INVALID'; N=S;
 CALL ZCHECK('ONSOURCE-REPEAT',
   N=54321 & CALLS=2);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC108A;
