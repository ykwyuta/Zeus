 PC109A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Names resolve in the block where a procedure is declared (static
    scope), not in its caller; STATIC storage survives calls while
    AUTOMATIC storage is reinitialized at each activation. */
 DCL X FIXED BIN(31) INIT(1);
 DCL (R1,R2,R3,R4) FIXED BIN(31);

 OPEN FILE(REPORT);

 /* SCOPE-CALLER-SHADOW */
 CALL OUTER(R1,R2);
 CALL ZCHECK('SCOPE-CALLER-SHADOW',
   R1=1);

 /* SCOPE-NESTED-PARENT */
 CALL ZCHECK('SCOPE-NESTED-PARENT',
   R2=2);

 /* SCOPE-MAIN-UNCHANGED */
 CALL ZCHECK('SCOPE-MAIN-UNCHANGED',
   X=1);

 /* STATIC-PERSIST */
 CALL BUMP(R3,R4); CALL BUMP(R3,R4); CALL BUMP(R3,R4);
 CALL ZCHECK('STATIC-PERSIST',
   R3=3);

 /* AUTOMATIC-REINIT */
 CALL ZCHECK('AUTOMATIC-REINIT',
   R4=1);

 /* STATIC-INIT-ONCE */
 CALL ZCHECK('STATIC-INIT-ONCE',
   PEEK()=7 & PEEK()=8);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 OUTER: PROC(A,B);
   DCL (A,B) FIXED BIN(31);
   DCL X FIXED BIN(31) INIT(2);
   A=SHOW();
   B=INNER();
   INNER: PROC RETURNS(FIXED BIN(31));
     RETURN(X);
   END INNER;
 END OUTER;
 SHOW: PROC RETURNS(FIXED BIN(31));
   RETURN(X);
 END SHOW;
 BUMP: PROC(S,A);
   DCL (S,A) FIXED BIN(31);
   DCL C FIXED BIN(31) STATIC INIT(0);
   DCL L FIXED BIN(31) INIT(0);
   C=C+1; L=L+1;
   S=C; A=L;
 END BUMP;
 PEEK: PROC RETURNS(FIXED BIN(31));
   DCL K FIXED BIN(31) STATIC INIT(6);
   K=K+1;
   RETURN(K);
 END PEEK;
 END PC109A;
