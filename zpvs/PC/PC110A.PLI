 PC110A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Condition codes and the HFP range conditions. OVERFLOW and
    UNDERFLOW are raised when a floating-point result leaves the
    hexadecimal range (below 16**63, at least 16**-65); UNDERFLOW
    gives zero (Language Reference). The ONCODE values follow the
    condition codes of Enterprise PL/I Messages and Codes: 612 is a
    character to arithmetic conversion error (600 is SIGNAL). */
 DCL F6 FLOAT DEC(6);
 DCL S CHAR(6) INIT('ABCDEF');
 DCL D3 FIXED DEC(3);
 DCL R FIXED DEC(5,2);
 DCL (CODE, I) FIXED BIN(31);
 DCL A(3) FIXED BIN(31) INIT(1,2,3);
 DCL FLAG BIT(1);

 OPEN FILE(REPORT);

 FLAG='0'B; CODE=0;
 ON OVERFLOW BEGIN; FLAG='1'B; CODE=ONCODE(); GO TO L1; END;
 F6=1E70;
 F6=F6*1E70;
 L1:
 CALL ZCHECK('OVERFLOW-HFP-RANGE', FLAG);
 CALL ZCHECK('ONCODE-OVERFLOW', CODE=300);

 FLAG='0'B; CODE=0;
 ON UNDERFLOW BEGIN; FLAG='1'B; CODE=ONCODE(); END;
 F6=1E-70;
 F6=F6*1E-70;
 CALL ZCHECK('UNDERFLOW-HFP-RANGE', FLAG & F6=0);
 CALL ZCHECK('ONCODE-UNDERFLOW', CODE=330);

 CODE=0;
 ON ZERODIVIDE BEGIN; CODE=ONCODE(); GO TO L2; END;
 I=0;
 I=5/I;
 L2:
 CALL ZCHECK('ONCODE-ZERODIVIDE', CODE=320);

 CODE=0;
 ON CONVERSION BEGIN; CODE=ONCODE(); GO TO L3; END;
 R='1X';
 L3:
 CALL ZCHECK('ONCODE-CONVERSION', CODE=612);

 CODE=0;
 ON STRINGRANGE BEGIN; CODE=ONCODE(); GO TO L4; END;
 (STRINGRANGE): S=SUBSTR(S,5,4);
 L4:
 CALL ZCHECK('ONCODE-STRINGRANGE', CODE=350);

 CODE=0;
 ON SUBSCRIPTRANGE BEGIN; CODE=ONCODE(); GO TO L5; END;
 I=4;
 (SUBSCRIPTRANGE): CODE=A(I);
 L5:
 CALL ZCHECK('ONCODE-SUBSCRIPTRNG', CODE=520);

 CODE=0;
 ON SIZE BEGIN; CODE=ONCODE(); GO TO L6; END;
 (SIZE): D3=12345;
 L6:
 CALL ZCHECK('ONCODE-SIZE', CODE=340);

 CODE=0;
 ON ERROR BEGIN; CODE=ONCODE(); GO TO L7; END;
 SIGNAL ERROR;
 L7:
 CALL ZCHECK('ONCODE-SIGNAL-ERROR', CODE=9);
 REVERT ERROR;

 CODE=0;
 ON CONDITION(MINE) CODE=ONCODE();
 SIGNAL CONDITION(MINE);
 CALL ZCHECK('ONCODE-CONDITION', CODE=500);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC110A;
