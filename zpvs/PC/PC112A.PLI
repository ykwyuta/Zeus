*PROCESS ASSERT(CONDITION);
 PC112A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* The ASSERT statement under the ASSERT(CONDITION) compiler option,
    the ASSERTION condition and its ON built-in functions (ONTEXT,
    ONACTUAL, ONEXPECTED, ONOPERATOR, ONPACKAGE), the conditions
    ANYCONDITION, FINISH and INVALIDOP, and ONSUBSCRIPT, ONLBOUND,
    ONHBOUND, ONLINE and ONAREA (Enterprise PL/I 6.1 Language
    Reference). Condition codes follow Messages and Codes: 430
    SIGNAL ASSERTION, 431/432 ASSERT TRUE or FALSE without/with
    TEXT, 433/434 UNREACHABLE, 435/436 COMPARE, 290 INVALIDOP, 360
    AREA, 4 SIGNAL FINISH. A normal return from an ASSERTION ON-unit
    resumes at the next statement. */
 DCL N FIXED BIN(31) INIT(1);
 DCL (CODE, ID, I, X, EXPECT) FIXED BIN(31);
 DCL (TXT, ACT, EXP, OP, PKG, AN) CHAR(32) VARYING;
 DCL HIT BIT(1);
 DCL A(2:4) FIXED BIN(31) INIT(7, 8, 9);
 DCL (SUB, LB, HB) FIXED BIN(63);
 DCL AR AREA(16);
 DCL BIG CHAR(64) BASED;
 DCL P POINTER;
 DCL MINE CONDITION;

 OPEN FILE(REPORT);

 ON ASSERTION BEGIN;
   CODE=ONCODE(); ID=ONCONDID(); TXT=ONTEXT();
   ACT=ONACTUAL(); EXP=ONEXPECTED(); OP=ONOPERATOR();
   PKG=ONPACKAGE();
 END;

 CODE=0;
 ASSERT TRUE(N>0);
 CALL ZCHECK('ASSERT-TRUE-PASS', CODE=0);
 ASSERT TRUE(N=2) TEXT('N IS NOT 2');
 CALL ZCHECK('ASSERT-TRUE-TEXT',
   CODE=432 & ID=24 & TXT='N IS NOT 2');
 CODE=0;
 ASSERT FALSE('0'B);
 CALL ZCHECK('ASSERT-FALSE-PASS', CODE=0);
 ASSERT FALSE(N=1);
 CALL ZCHECK('ASSERT-FALSE-FAIL', CODE=431 & TXT='');
 ASSERT COMPARE(N,2);
 CALL ZCHECK('ASSERT-COMPARE-EQ', CODE=435 &
   TRIM(ACT)='1' & TRIM(EXP)='2' & OP='EQ');
 CODE=0;
 ASSERT COMPARE(N,0,'GT');
 CALL ZCHECK('ASSERT-COMPARE-PASS', CODE=0);
 ASSERT COMPARE(N,5,'ge') TEXT('LOW');
 CALL ZCHECK('ASSERT-COMPARE-OP', CODE=436 & OP='GE' &
   TXT='LOW');
 ASSERT UNREACHABLE;
 CALL ZCHECK('ASSERT-UNREACHABLE', CODE=433);
 SIGNAL ASSERTION;
 CALL ZCHECK('SIGNAL-ASSERTION', CODE=430);
 CALL ZCHECK('ONPACKAGE', PKG='PC112A');
 REVERT ASSERTION;

 ON SUBSCRIPTRANGE BEGIN;
   SUB=ONSUBSCRIPT(); LB=ONLBOUND(); HB=ONHBOUND();
   GO TO L1;
 END;
 I=5;
 (SUBSCRIPTRANGE): X=A(I);
 L1:
 CALL ZCHECK('ONSUBSCRIPT-BOUNDS', SUB=5 & LB=2 & HB=4);

 ON ZERODIVIDE BEGIN; X=ONLINE(); GO TO L2; END;
 I=0;
 EXPECT=SOURCELINE()+1;
 X=1/I;
 L2:
 CALL ZCHECK('ONLINE', X=EXPECT);

 ON AREA BEGIN; AN=ONAREA(); CODE=ONCODE(); GO TO L3; END;
 ALLOCATE BIG IN(AR) SET(P);
 L3:
 CALL ZCHECK('ONAREA', AN='AR' & CODE=360);

 HIT='0'B;
 ON ANYCONDITION BEGIN; HIT='1'B; ID=ONCONDID(); END;
 SIGNAL CONDITION(MINE);
 CALL ZCHECK('ANYCONDITION', HIT & ID=3);
 REVERT ANYCONDITION;

 HIT='0'B;
 ON FINISH BEGIN; HIT='1'B; CODE=ONCODE(); END;
 SIGNAL FINISH;
 CALL ZCHECK('FINISH-SIGNAL', HIT & CODE=4);
 REVERT FINISH;

 ON INVALIDOP BEGIN; CODE=ONCODE(); GO TO L4; END;
 SIGNAL INVALIDOP;
 L4:
 CALL ZCHECK('INVALIDOP-SIGNAL', CODE=290);

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC112A;
