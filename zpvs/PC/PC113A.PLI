 PC113A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* The UTF built-in functions ULENGTH, ULENGTH8, ULENGTH16, UPOS,
    USUBSTR, USUPPLEMENTARY, UVALID and UWIDTH (Enterprise PL/I 6.1
    Language Reference). CHARACTER strings hold UTF-8 and WIDECHAR
    strings UTF-16; positions and widths count bytes for CHARACTER
    and widechars for WIDECHAR. The strings are those of the LRM
    examples: '4B_C3_A4_66_65_72'X (Kafer with an a umlaut) and the
    G clef surrogate pair 'D834_DD1E'WX. */
 DCL K CHAR(6) VARYING;
 DCL W WCHAR(20) VARYING;
 DCL SUB CHAR(6) VARYING;
 DCL HIT BIT(1);

 OPEN FILE(REPORT);

 K = '4B_C3_A4_66_65_72'X;
 CALL ZCHECK('ULENGTH-UTF8', ULENGTH(K) = 5);
 CALL ZCHECK('ULENGTH-COMBINING',
   ULENGTH('61_CC_88'X) = 2 & ULENGTH('C3_A4'X) = 1);
 CALL ZCHECK('ULENGTH8-WIDECHAR',
   ULENGTH8('004B_00E4_0073_0065'WX) = 5);
 CALL ZCHECK('ULENGTH8-CHAR-LENGTH', ULENGTH8(K) = 6);
 CALL ZCHECK('ULENGTH16-UTF8', ULENGTH16('4B_C3_A4_73_65'X) = 4);
 CALL ZCHECK('UPOS-BYTES',
   UPOS(K,1) = 1 & UPOS(K,2) = 2 & UPOS(K,3) = 4 & UPOS(K,5) = 6);
 CALL ZCHECK('UPOS-OUT-OF-RANGE', UPOS(K,0) = 0 & UPOS(K,6) = 0);
 CALL ZCHECK('UWIDTH-BYTES',
   UWIDTH(K,1) = 1 & UWIDTH(K,2) = 2 & UWIDTH(K,3) = 1);
 SUB = USUBSTR(K,1,2);
 CALL ZCHECK('USUBSTR-1-2', SUB = '4B_C3_A4'X);
 SUB = USUBSTR(K,2,1);
 CALL ZCHECK('USUBSTR-2-1', SUB = 'C3_A4'X);
 SUB = USUBSTR(K,3,2);
 CALL ZCHECK('USUBSTR-3-2', SUB = '66_65'X);
 HIT = '0'B;
 ON ERROR BEGIN; HIT = '1'B; GOTO AFTER_RANGE; END;
 SUB = USUBSTR(K,5,2);
 AFTER_RANGE:
 REVERT ERROR;
 CALL ZCHECK('USUBSTR-RANGE-ERROR', HIT);
 W = '0020_0020_D834_DD1E'WX;
 CALL ZCHECK('USUPPLEMENTARY-PAIR', USUPPLEMENTARY(W) = 3);
 CALL ZCHECK('USUPPLEMENTARY-NONE', USUPPLEMENTARY(K) = 0);
 CALL ZCHECK('ULENGTH-SURROGATES', ULENGTH(W) = 3);
 CALL ZCHECK('UWIDTH-SURROGATES', UWIDTH(W,3) = 2);
 CALL ZCHECK('UVALID-VALID', UVALID(K) = 0 & UVALID(W) = 0);
 CALL ZCHECK('UVALID-UTF8-INVALID',
   UVALID('41_80_42'X) = 2 & UVALID('E0_80_80'X) = 1);
 CALL ZCHECK('UVALID-UTF16-INVALID',
   UVALID('0041_DC00'WX) = 2);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC113A;
