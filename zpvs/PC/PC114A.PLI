 PC114A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* The UTF-8 conversion built-in functions UTF8, UTF8TOCHAR and
    UTF8TOWCHAR, and MEMUVALID8 and MEMUVALID16 (Enterprise PL/I 6.1
    Language Reference). UTF8(x,c) reads CHAR x in code page c, the
    CODEPAGE option when c is omitted, and WIDECHAR x as UTF-16; the
    LRM example: on code page 1140 'BA'X and 'BB'X are the UTF-8
    characters '5B'X and '5D'X, and on code page 1141 '63'X and 'FC'X
    are. Invalid UTF-8 raises ERROR. MEMUVALID8/16 return the index
    of the first invalid byte of a buffer, or zero. */
 DCL C CHAR(8) VARYING;
 DCL W WCHAR(8) VARYING;
 DCL B8 CHAR(3) INIT('41_80_42'X);
 DCL G8 CHAR(3) INIT('41_C3_A4'X);
 DCL B16 WCHAR(2) INIT('0041_DC00'WX);
 DCL HIT BIT(1);

 OPEN FILE(REPORT);

 C = UTF8('BA_BB'X, 1140);
 CALL ZCHECK('UTF8-CODEPAGE-1140', C = '5B_5D'X);
 C = UTF8('63_FC'X, 1141);
 CALL ZCHECK('UTF8-CODEPAGE-1141', C = '5B_5D'X);
 C = UTF8('C1_81'X);
 CALL ZCHECK('UTF8-CODEPAGE-OPTION', C = '41_61'X);
 C = UTF8('004B_00E4'WX);
 CALL ZCHECK('UTF8-WIDECHAR', C = '4B_C3_A4'X);
 C = UTF8TOCHAR('5B_5D'X, 1140);
 CALL ZCHECK('UTF8TOCHAR-1140', C = 'BA_BB'X);
 W = UTF8TOWCHAR('4B_C3_A4'X);
 CALL ZCHECK('UTF8TOWCHAR', W = '004B_00E4'WX);
 HIT = '0'B;
 ON ERROR BEGIN; HIT = '1'B; GOTO AFTER_BAD; END;
 W = UTF8TOWCHAR('41_C3'X);
 AFTER_BAD:
 REVERT ERROR;
 CALL ZCHECK('UTF8TOWCHAR-INVALID', HIT);
 CALL ZCHECK('MEMUVALID8-INVALID', MEMUVALID8(ADDR(B8), 3) = 2);
 CALL ZCHECK('MEMUVALID8-VALID', MEMUVALID8(ADDR(G8), 3) = 0);
 CALL ZCHECK('MEMUVALID16-INVALID', MEMUVALID16(ADDR(B16), 4) = 3);
 CALL ZCHECK('MEMUVALID16-VALID', MEMUVALID16(ADDR(B16), 2) = 0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC114A;
