 PC122A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* ONUCHAR, ONUSOURCE, ONWCHAR and ONWSOURCE (Enterprise PL/I 6.1
    Language Reference). In an ON-unit for CONVERSION raised by a UCHAR
    source, ONUSOURCE is the field being converted and ONUCHAR the
    character that caused the condition; for a WIDECHAR source,
    ONWSOURCE and ONWCHAR. Out of context ONUCHAR is a UTF-8 blank,
    ONWCHAR a widechar blank, ONUSOURCE and ONWSOURCE null strings. */
 DCL U UCHAR(3);
 DCL W WCHAR(3);
 DCL N FIXED BIN(31);
 DCL (US, UC) UCHAR(3) VARYING;
 DCL (WS, WC) WCHAR(3) VARYING;
 DCL HIT BIT(1);

 OPEN FILE(REPORT);

 CALL ZCHECK('ONUCHAR-OUT-OF-CONTEXT',
   ONUCHAR() = '20'UX & LENGTH(ONUSOURCE()) = 0);
 CALL ZCHECK('ONWCHAR-OUT-OF-CONTEXT',
   ONWCHAR() = '0020'WX & LENGTH(ONWSOURCE()) = 0);
 U = '1A3';
 HIT = '0'B;
 ON CONVERSION BEGIN;
   HIT = '1'B; US = ONUSOURCE(); UC = ONUCHAR(); GOTO AFTER_U;
 END;
 N = U;
 AFTER_U:
 REVERT CONVERSION;
 CALL ZCHECK('ONUSOURCE', HIT & US = '314133'UX);
 CALL ZCHECK('ONUCHAR', UC = '41'UX);
 W = '0031_0042_0033'WX;
 HIT = '0'B;
 ON CONVERSION BEGIN;
   HIT = '1'B; WS = ONWSOURCE(); WC = ONWCHAR(); GOTO AFTER_W;
 END;
 N = W;
 AFTER_W:
 REVERT CONVERSION;
 CALL ZCHECK('ONWSOURCE', HIT & WS = '0031_0042_0033'WX);
 CALL ZCHECK('ONWCHAR', WC = '0042'WX);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC122A;
