 PC124A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31) INIT(0);
 DCL MSG CHAR(20) INIT('ZPVS PC124A DISPLAY');

 OPEN FILE(REPORT);

 /* DISPLAY: the message is shown and execution goes on */
 DISPLAY ('ZPVS PC124A COMMUNICATION LINK ESTABLISHED.');
 N = N + 1;
 DISPLAY (MSG || ' ' || TRIM(CHAR(N)));
 N = N + 1;
 CALL ZCHECK('DISPLAY',
   N=2);

 /* DISPLAY-ROUTCDE-DESC: WTO options */
 DISPLAY ('ZPVS PC124A ROUTCDE') ROUTCDE(11) DESC(7);
 DISPLAY (12345) ROUTCDE(2, 11) DESC(6, 7);
 N = N + 1;
 CALL ZCHECK('DISPLAY-ROUTCDE-DESC',
   N=3);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC124A;
