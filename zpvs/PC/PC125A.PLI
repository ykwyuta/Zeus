 PC125P: PACKAGE EXPORTS(MAIN);
 PC125A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31) INIT(1);
 DCL C CHAR(4) INIT('PLI ');

 OPEN FILE(REPORT);

 /* ASSEMBLER-RETURN-CODE: PLIRETV at exit is the return value */
 CALL PLIRETC(0);
 CALL ASMP(N, C);
 CALL ZCHECK('ASSEMBLER-RETURN-CODE',
   PLIRETV()=7);
 CALL PLIRETC(0);

 /* ASSEMBLER-ARGUMENTS: passed by address, no descriptors */
 CALL ZCHECK('ASSEMBLER-ARGUMENTS',
   N=2 & C='ASM ');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC125A;

 ASMP: PROC(K, T) OPTIONS(ASSEMBLER);
   DCL K FIXED BIN(31);
   DCL T CHAR(4);
   K = K + 1;
   T = 'ASM';
   CALL PLIRETC(7);
 END ASMP;
 END PC125P;
