 PC126P: PACKAGE EXPORTS(MAIN);
 DCL GOT FIXED BIN(31) EXTERNAL;
 DCL GOTF FLOAT BIN(53) EXTERNAL;

 PC126A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL I1 FIXED BIN(31) INIT(1729);
 DCL I2 FIXED BIN(31) INIT(6);
 DCL D1 FLOAT BIN(53) INIT(17.25);
 DCL H FIXED BIN(15);
 DCL C5 CHAR(5);

 OPEN FILE(REPORT);

 /* VARGLIST-BYVALUE: the values one after another */
 CALL VARG1('II      ', I1, I2);
 CALL ZCHECK('VARGLIST-BYVALUE',
   GOT=1735);
 CALL VARG1('ID      ', I1, D1);
 CALL ZCHECK('VARGLIST-BYVALUE-FLOAT',
   GOT=1729 & GOTF=17.25);

 /* VARGLIST-NONE: no further arguments */
 CALL VARG1('        ');
 CALL ZCHECK('VARGLIST-NONE',
   GOT=0);

 /* VARGLIST-BYADDR: the addresses of the arguments */
 CALL VARG2('II      ', I1, I2);
 CALL ZCHECK('VARGLIST-BYADDR',
   GOT=1735 & I1=1730 & I2=7);

 /* VARGSIZE: SIZE rounded up to a multiple of 4 */
 CALL ZCHECK('VARGSIZE',
   VARGSIZE(H)=4 & VARGSIZE(C5)=8 & VARGSIZE(D1)=8 &
   VARGSIZE(I1)=4);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PC126A;

 /* by value: each argument takes VARGSIZE bytes */
 VARG1: PROC(TEXT) OPTIONS(NODESCRIPTOR BYVALUE);
   DCL TEXT CHAR(8) LIST BYADDR NONASGN;
   DCL P POINTER;
   DCL I FIXED BIN(31) BASED;
   DCL D FLOAT BIN(53) BASED;
   DCL K FIXED BIN(31);
   GOT = 0;
   P = VARGLIST();
   DO K = 1 TO 8 WHILE(SUBSTR(TEXT, K, 1) ^= ' ');
     IF SUBSTR(TEXT, K, 1) = 'I' THEN DO;
       GOT = GOT + P->I;
       P = POINTERADD(P, VARGSIZE(P->I));
     END;
     ELSE DO;
       GOTF = P->D;
       P = POINTERADD(P, VARGSIZE(P->D));
     END;
   END;
 END VARG1;

 /* by address: each argument is a pointer */
 VARG2: PROC(TEXT) OPTIONS(NODESCRIPTOR BYADDR);
   DCL TEXT CHAR(8) LIST BYADDR NONASGN;
   DCL P POINTER;
   DCL PP POINTER BASED;
   DCL I FIXED BIN(31) BASED;
   DCL K FIXED BIN(31);
   GOT = 0;
   P = VARGLIST();
   DO K = 1 TO 8 WHILE(SUBSTR(TEXT, K, 1) ^= ' ');
     GOT = GOT + P->PP->I;
     P->PP->I = P->PP->I + 1;
     P = POINTERADD(P, STORAGE(P));
   END;
 END VARG2;
 END PC126P;
