 PD101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL D1 FIXED DEC(1);
 DCL D2 FIXED DEC(2);
 DCL D3 FIXED DEC(3);
 DCL D4 FIXED DEC(4);
 DCL D5 FIXED DEC(5);
 DCL D7 FIXED DEC(7);
 DCL D9 FIXED DEC(9);
 DCL D15 FIXED DEC(15);
 DCL D31 FIXED DEC(31);

 OPEN FILE(REPORT);

 /* DEC-1-0 */
 D1=0;
 CALL ZCHECK('DEC-1-0',
   HEX(UNSPEC(D1))='0C');

 /* DEC-1-1 */
 D1=1;
 CALL ZCHECK('DEC-1-1',
   HEX(UNSPEC(D1))='1C');

 /* DEC-1-2 */
 D1=9;
