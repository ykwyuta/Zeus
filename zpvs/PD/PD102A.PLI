 PD102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL C CHAR(5);
 DCL V CHAR(8) VARYING;
 DCL B BIT(5) UNALIGNED;
 DCL 1 PACKED UNALIGNED, 2 A BIT(3), 2 D BIT(5);

 OPEN FILE(REPORT);

 /* CHAR-PAD */
 C='AB';
 CALL ZCHECK('CHAR-PAD',
   C='AB   ' & HEX(C)='C1C2404040');

 /* CHAR-TRUNC */
 C='ABCDEFG';
 CALL ZCHECK('CHAR-TRUNC',
   C='ABCDE');

 /* VAR-LENGTH */
 V='ABC';
 CALL ZCHECK('VAR-LENGTH',
   LENGTH(V)=3 & MAXLENGTH(V)=8);

 /* VAR-PREFIX */
 CALL ZCHECK('VAR-PREFIX',
   SUBSTR(HEX(UNSPEC(V)),1,10)='0003C1C2C3');

 /* VAR-EMPTY */
 V='';
 CALL ZCHECK('VAR-EMPTY',
   LENGTH(V)=0);

 /* VAR-MAX */
 V='ABCDEFGHIJK';
 CALL ZCHECK('VAR-MAX',
   LENGTH(V)=8 & V='ABCDEFGH');

 /* BIT-PAD */
 B='11'B;
 CALL ZCHECK('BIT-PAD',
   B='11000'B);

 /* BIT-TRUNC */
 B='1010111'B;
 CALL ZCHECK('BIT-TRUNC',
   B='10101'B);

 /* BIT-BOUNDARY */
 A='101'B; D='10011'B;
 CALL ZCHECK('BIT-BOUNDARY',
   HEX(UNSPEC(PACKED))='B3');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD102A;
