 PD103A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL 1 S UNALIGNED, 2 A CHAR(1), 2 B FIXED BIN(31),
   2 C FIXED DEC(5), 2 D CHAR(2);
 DCL 1 T ALIGNED, 2 X FIXED BIN(31), 2 Y FIXED BIN(31);

 OPEN FILE(REPORT);

 /* UNALIGNED-SIZE */
 CALL ZCHECK('UNALIGNED-SIZE',
   STG(S)=10);

 /* UNALIGNED-BYTES */
 S.A='A'; S.B=258; S.C=-123; S.D='BC';
 CALL ZCHECK('UNALIGNED-BYTES',
   HEX(UNSPEC(S))='C10000010200123DC2C3');

 /* ALIGNED-SIZE */
 CALL ZCHECK('ALIGNED-SIZE',
   STG(T)=8);

 /* ALIGNED-BYTES */
 T.X=1; T.Y=-1;
 CALL ZCHECK('ALIGNED-BYTES',
   HEX(UNSPEC(T))='00000001FFFFFFFF');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD103A;
