 PD104A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE STRUCTURE 1 POINT, 2 X FIXED BIN(31),
   2 Y FIXED BIN(31);
 DEFINE ALIAS MONEY FIXED DEC(9,2);
 DCL P TYPE POINT;
 DCL Q LIKE P;
 DCL M TYPE MONEY;

 OPEN FILE(REPORT);

 /* TYPE-MEMBERS */
 P.X=3; P.Y=4;
 CALL ZCHECK('TYPE-MEMBERS',
   P.X=3 & P.Y=4);

 /* LIKE-COPY */
 Q=P;
 CALL ZCHECK('LIKE-COPY',
   Q.X=3 & Q.Y=4);

 /* LIKE-INDEPENDENT */
 Q.X=8;
 CALL ZCHECK('LIKE-INDEPENDENT',
   P.X=3 & Q.X=8);

 /* ALIAS-SCALE */
 M=12.345;
 CALL ZCHECK('ALIAS-SCALE',
   M=12.34);

 /* TYPE-SIZES */
 CALL ZCHECK('TYPE-SIZES',
   STG(P)=8 & STG(Q)=8 & STG(M)=5);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD104A;
