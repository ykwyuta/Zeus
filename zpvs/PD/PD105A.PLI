 PD105A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE ORDINAL COLOR(RED,GREEN VALUE(5),BLUE);
 DCL C TYPE COLOR;
 DFT RANGE(I:N) FIXED BIN(15);
 DCL ICOUNT INIT(7);

 OPEN FILE(REPORT);

 /* ORDINAL-FIRST */
 CALL ZCHECK('ORDINAL-FIRST',
   ORDINALNAME(FIRST(COLOR))='RED');

 /* ORDINAL-LAST */
 CALL ZCHECK('ORDINAL-LAST',
   ORDINALNAME(LAST(COLOR))='BLUE');

 /* ORDINAL-VALUE */
 C=GREEN;
 CALL ZCHECK('ORDINAL-VALUE',
   BINVALUE(C)=5);

 /* ORDINAL-SUCC */
 CALL ZCHECK('ORDINAL-SUCC',
   ORDINALNAME(ORDINALSUCC(C))='BLUE');

 /* ORDINAL-PRED */
 CALL ZCHECK('ORDINAL-PRED',
   ORDINALNAME(ORDINALPRED(C))='RED');

 /* DEFAULT-I-N */
 CALL ZCHECK('DEFAULT-I-N',
   STG(ICOUNT)=2 & ICOUNT=7);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD105A;
