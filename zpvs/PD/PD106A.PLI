 PD106A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL W WIDECHAR(4);
 DCL G GRAPHIC(3);
 DCL Z COMPLEX FIXED DEC(7,2);
 DCL F FLOAT DEC(6), H FLOAT DEC(16);

 OPEN FILE(REPORT);

 /* WIDE-BYTES */
 W='AB';
 CALL ZCHECK('WIDE-BYTES',
   HEX(UNSPEC(W))='0041004200200020');

 /* GRAPHIC-BYTES */
 G='AB';
 CALL ZCHECK('GRAPHIC-BYTES',
   HEX(UNSPEC(G))='42C142C24040');

 /* COMPLEX-REAL */
 Z=(1+2I)*(3-1I);
 CALL ZCHECK('COMPLEX-REAL',
   REAL(Z)=5 & IMAG(Z)=5);

 /* COMPLEX-CONJ */
 CALL ZCHECK('COMPLEX-CONJ',
   REAL(CONJG(Z))=5 & IMAG(CONJG(Z))=-5);

 /* COMPLEX-MAGNITUDE */
 CALL ZCHECK('COMPLEX-MAGNITUDE',
   ABS(3+4I)=5);

 /* HFP-SHORT */
 F=1;
 CALL ZCHECK('HFP-SHORT',
   HEX(UNSPEC(F))='41100000');

 /* HFP-LONG */
 H=-12.5;
 CALL ZCHECK('HFP-LONG',
   HEX(UNSPEC(H))='C1C8000000000000');

 /* FLOAT-SIZES */
 CALL ZCHECK('FLOAT-SIZES',
   STG(F)=4 & STG(H)=8);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD106A;
