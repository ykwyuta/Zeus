 PD109A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Implementation-defined representations. The Language Reference
    does not fix these values; every check has basis zos in
    basis.json and expects the current Zeus behavior, so a run on
    z/OS confirms or corrects it: decimal 0.1 in HFP (rounding),
    FLOAT to FIXED DEC and to CHAR, STORAGE of program-control
    data, NULL and SYSNULL, the empty AREA header, overlapping
    SUBSTR assignment, FIXED DEC overflow with SIZE disabled,
    STATIC without INITIAL, and RANDOM. */
 DCL F6 FLOAT DEC(6), F16 FLOAT DEC(16), FB FLOAT BIN(21);
 DCL EV ENTRY VARIABLE, LV LABEL VARIABLE, FV FILE VARIABLE;
 DEFINE STRUCTURE 1 T, 2 X FIXED BIN(31);
 DCL AR AREA(100);
 DCL AR2 AREA;
 DCL H HANDLE T, O OFFSET(AR);
 DCL S CHAR(6);
 DCL D3 FIXED DEC(3) INIT(999);
 DCL ST FIXED BIN(31) STATIC;
 DCL STC CHAR(4) STATIC;
 DCL C CHAR(30) VAR;
 DCL R FIXED DEC(5,2);
 DCL RN FLOAT BIN(53);

 OPEN FILE(REPORT);

 F6=0.1; F16=0.1; FB=0.1;
 CALL ZCHECK('HFP-SHORT-TENTH', HEX(F6)='40199999');
 CALL ZCHECK('HFP-LONG-TENTH', HEX(F16)='401999999999999A');
 CALL ZCHECK('HFP-BIN21-TENTH', HEX(FB)='40199999');
 R=F6;
 CALL ZCHECK('TENTH-TO-FIXED-DEC', R=0.09);
 C=F6;
 CALL ZCHECK('FLOAT-TO-CHAR', C=' 1.00000E-0001');
 CALL ZCHECK('STG-ENTRY-VARIABLE', STG(EV)=8);
 CALL ZCHECK('STG-LABEL-VARIABLE', STG(LV)=8);
 CALL ZCHECK('STG-FILE-VARIABLE', STG(FV)=4);
 CALL ZCHECK('STG-HANDLE-OFFSET', STG(H)=4 & STG(O)=4);
 CALL ZCHECK('STG-AREA', STG(AR)=116 & STG(AR2)=1016);
 CALL ZCHECK('NULL-VALUE', HEX(NULL())='FF000000');
 CALL ZCHECK('SYSNULL-VALUE', HEX(SYSNULL())='00000000');
 CALL ZCHECK('AREA-EMPTY-HEADER',
   HEX(SUBSTR(UNSPEC(AR),1,128))=REPEAT('0',31));
 S='ABCDEF';
 SUBSTR(S,2,5)=SUBSTR(S,1,5);
 CALL ZCHECK('OVERLAP-SUBSTR-RIGHT', S='AABCDE');
 S='ABCDEF';
 SUBSTR(S,1,5)=SUBSTR(S,2,5);
 CALL ZCHECK('OVERLAP-SUBSTR-LEFT', S='BCDEFF');
 D3=D3+1;
 CALL ZCHECK('DEC-OVER-NO-SIZE', D3=0 & HEX(D3)='000C');
 CALL ZCHECK('STATIC-NO-INIT',
   HEX(ST)='00000000' & HEX(STC)='00000000');
 RN=RANDOM(1);
 CALL ZCHECK('RANDOM-SEED-ONE', ABS(RN-0.4977440861790998E0)<1E-12);
 RN=RANDOM();
 CALL ZCHECK('RANDOM-NEXT', ABS(RN-0.8923507647386716E0)<1E-12);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD109A;
