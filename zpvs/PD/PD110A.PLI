 PD110A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Data attributes the suite did not use (Enterprise PL/I Language
    Reference): SIGNED/UNSIGNED binary ranges and sizes, VARYINGZ
    (a null-terminated string one byte longer than its maximum),
    NONVARYING, the default representations written explicitly
    (HEXADEC, BIGENDIAN), a BYVALUE parameter (the procedure gets a
    copy), OPTIONAL with PRESENT/OMITTED and an argument written as
    *, and a NONASSIGNABLE parameter that is read. */
 DCL U FIXED BIN(8) UNSIGNED INIT(255);
 DCL S FIXED BIN(7) SIGNED INIT(-128);
 DCL V CHAR(5) VARYINGZ INIT('AB');
 DCL VB CHAR(6) BASED(ADDR(V));
 DCL NV CHAR(3) NONVARYING INIT('AB');
 DCL F FLOAT DEC(6) HEXADEC INIT(1);
 DCL B FIXED BIN(31) BIGENDIAN INIT(1);
 DCL (N, M) FIXED BIN(31);
 DCL (P1, P2) BIT(1);

 OPEN FILE(REPORT);

 CALL ZCHECK('UNSIGNED-RANGE', U=255 & STG(U)=1);
 CALL ZCHECK('SIGNED-RANGE', S=-128 & STG(S)=1);
 CALL ZCHECK('VARYINGZ-LENGTH', LENGTH(V)=2 & STG(V)=6);
 CALL ZCHECK('VARYINGZ-NULL',
   SUBSTR(VB,1,2)='AB' & SUBSTR(VB,3,1)=LOW(1));
 CALL ZCHECK('NONVARYING-PADDED', LENGTH(NV)=3 & NV='AB ');
 CALL ZCHECK('HEXADEC-DEFAULT', UNSPEC(F)='41100000'BX);
 CALL ZCHECK('BIGENDIAN-DEFAULT', UNSPEC(B)='00000001'BX);
 N=1;
 CALL BV(N);
 CALL ZCHECK('BYVALUE-COPY', N=1 & M=5);
 N=7;
 CALL OPT(N);
 CALL ZCHECK('OPTIONAL-PRESENT', P1 & ^P2);
 CALL OPT(*);
 CALL ZCHECK('OPTIONAL-OMITTED', ^P1 & P2);
 N=3;
 CALL NA(N);
 CALL ZCHECK('NONASSIGNABLE-READ', M=3);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 BV: PROC(A);
   DCL A FIXED BIN(31) BYVALUE;
   A=5;
   M=A;
 END BV;
 OPT: PROC(A);
   DCL A FIXED BIN(31) OPTIONAL;
   P1=PRESENT(A);
   P2=OMITTED(A);
 END OPT;
 NA: PROC(A);
   DCL A FIXED BIN(31) NONASSIGNABLE;
   M=A;
 END NA;
 END PD110A;
