*PROCESS CHECK(STORAGE);
 PD111A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* The storage built-in functions ALLOCATE, ALLOC31, ALLOCNEXT,
    AVAILABLEAREA, ALLOCSIZE, CHECKSTG and UNALLOCATED (Enterprise
    PL/I 6.1 Language Reference), under CHECK(STORAGE). An
    allocation in an AREA is rounded up to a multiple of 8, so
    after a 100-byte allocation an AREA(1000) has 896 bytes left,
    as in the LRM example. Each heap allocation is followed by
    eight 'FF'X bytes; CHECKSTG says whether they are unchanged. */
 DCL UAREA AREA(1000);
 DCL SMALL AREA(40);
 DCL (P, Q, R, S) POINTER;
 DCL C99Z CHAR(99) VARYINGZ BASED(P);
 DCL C9 CHAR(896) BASED(Q);
 DCL BUF CHAR(24) BASED(R);
 DCL OVER CHAR(25) BASED(R);
 DCL (B1, A1) FIXED BIN(31);
 DCL HIT BIT(1) INIT('0'B);

 OPEN FILE(REPORT);

 B1 = AVAILABLEAREA(UAREA);
 ALLOCATE C99Z IN(UAREA);
 A1 = AVAILABLEAREA(UAREA);
 CALL ZCHECK('AVAILABLEAREA-LRM', B1 = 1000 & A1 = 896);
 ALLOCATE C9 IN(UAREA);
 CALL ZCHECK('AVAILABLEAREA-FULL', AVAILABLEAREA(UAREA) = 0);

 S = ALLOCATE(10, SMALL);
 CALL ZCHECK('ALLOCATE-AREA-ROUND', S ^= SYSNULL() &
   AVAILABLEAREA(SMALL) = 24);
 S = ALLOCNEXT(25, SMALL);
 CALL ZCHECK('ALLOCNEXT-NULL', S = SYSNULL() &
   AVAILABLEAREA(SMALL) = 24);
 S = ALLOCNEXT(24, SMALL);
 CALL ZCHECK('ALLOCNEXT-FITS', S ^= SYSNULL() &
   AVAILABLEAREA(SMALL) = 0);
 ON AREA BEGIN; HIT = '1'B; GO TO L1; END;
 S = ALLOCATE(1, SMALL);
 L1:
 CALL ZCHECK('ALLOCATE-AREA-COND', HIT);

 R = ALLOCATE(24);
 CALL ZCHECK('ALLOCSIZE', ALLOCSIZE(R) = 24 &
   ALLOCSIZE(ADDR(B1)) = 0);
 CALL ZCHECK('UNALLOCATED', ^UNALLOCATED(R) &
   UNALLOCATED(ADDR(B1)));
 BUF = 'ABC';
 CALL ZCHECK('CHECKSTG-CLEAN', CHECKSTG(R) & CHECKSTG());
 OVER = (25)'X';
 CALL ZCHECK('CHECKSTG-CORRUPT', ^CHECKSTG(R) & ^CHECKSTG());
 Q = ALLOC31(8);
 CALL ZCHECK('ALLOC31', ALLOCSIZE(Q) = 8 & CHECKSTG(Q));
 ALLOCATE C99Z;
 CALL ZCHECK('ALLOCATE-STMT', ALLOCSIZE(P) = 100 &
   ^UNALLOCATED(P));
 FREE C99Z;
 CALL ZCHECK('FREE-UNALLOCATED', UNALLOCATED(P));

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD111A;
