 %DCL TWICE ENTRY;
 %TWICE: XPROC(A) RETURNS(FIXED);
   DCL A FIXED;
   RETURN(A * 2);
 %END TWICE;
 %TWICE: XPROC(A) RETURNS(FIXED);
   DCL A FIXED;
   RETURN(A * 3);
 %END TWICE;
 PD114A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* XDECLARE, XDEFINE ALIAS, XDEFINE ORDINAL, XDEFINE STRUCTURE and
    the preprocessor XPROCEDURE (Enterprise PL/I 6.1 Language
    Reference). They are the same as DECLARE, DEFINE and %PROCEDURE,
    except that a later one for a name already declared or defined
    is accepted and ignored (XDECLARE with the same attributes), as
    an include file may declare its names more than once. The second
    TWICE (times 3) is ignored. */
 XDCL K FIXED BIN(31) INIT(5);
 XDCL K FIXED BIN(31) INIT(5);
 XDEFINE ALIAS SMALL FIXED BIN(15);
 XDEFINE ALIAS SMALL FIXED BIN(15);
 XDEFINE ORDINAL HUE (RED, GREEN);
 XDEFINE ORDINAL HUE (RED, GREEN);
 XDEFINE STRUCTURE 1 PT, 2 X1 FIXED BIN(31), 2 Y1 FIXED BIN(31);
 XDEFINE STRUCTURE 1 PT, 2 X1 FIXED BIN(31), 2 Y1 FIXED BIN(31);
 DCL S TYPE SMALL;
 DCL C ORDINAL HUE;
 DCL P TYPE PT;
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 CALL ZCHECK('XDECLARE-TWICE', K = 5);
 CALL ZCHECK('XDEFINE-ALIAS', STORAGE(S) = 2);
 C = GREEN;
 CALL ZCHECK('XDEFINE-ORDINAL', BINARYVALUE(C) = 1);
 CALL ZCHECK('XDEFINE-STRUCTURE', STORAGE(P) = 8);
 N = TWICE(4);
 CALL ZCHECK('XPROCEDURE-FIRST-KEPT', N = 8);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD114A;
