 PD116A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE ALIAS NUMERIC_MONTH FIXED BIN(7) VALUERANGE(1,12);
 DEFINE ORDINAL COLOR (RED, GREEN, BLUE);
 DCL IMONTH TYPE NUMERIC_MONTH;
 DCL CMONTH CHAR(3)
       VALUELIST('Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun',
                 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec');
 DCL HUE TYPE COLOR VALUELIST(RED, BLUE);
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 /* VALIDVALUE-LIST */
 CMONTH = 'Feb';
 CALL ZCHECK('VALIDVALUE-LIST',
   VALIDVALUE(CMONTH) & VALIDVALUE(CMONTH,'Dec') &
   ^VALIDVALUE(CMONTH,'FEB') & ^VALIDVALUE(CMONTH,'Foo'));

 /* VALIDVALUE-RANGE: inclusive at both ends */
 IMONTH = 12;
 N = 0;
 CALL ZCHECK('VALIDVALUE-RANGE',
   VALIDVALUE(IMONTH) & VALIDVALUE(IMONTH,1) &
   ^VALIDVALUE(IMONTH,N) & ^VALIDVALUE(IMONTH,N+13));

 /* VALIDVALUE-EQUIVALENT: as BETWEEN and the comparisons */
 DO N = -1 TO 14;
   IF VALIDVALUE(IMONTH,N) ^= BETWEEN(N,1,12) |
      VALIDVALUE(IMONTH,N) ^= ((1 <= N) & (N <= 12)) THEN
     LEAVE;
 END;
 CALL ZCHECK('VALIDVALUE-EQUIVALENT',
   N=15);

 /* VALIDVALUE-CONVERT: y takes the type of x */
 CALL ZCHECK('VALIDVALUE-CONVERT',
   VALIDVALUE(CMONTH,'Mar of') & VALIDVALUE(IMONTH,'7') &
   VALIDVALUE(IMONTH,12.0));

 /* VALIDVALUE-ORDINAL */
 HUE = BLUE;
 CALL ZCHECK('VALIDVALUE-ORDINAL',
   VALIDVALUE(HUE) & VALIDVALUE(HUE,RED) &
   ^VALIDVALUE(HUE,GREEN));
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD116A;
