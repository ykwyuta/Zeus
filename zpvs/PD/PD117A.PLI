 PD117A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL X FIXED BIN(15) BIGENDIAN;
 DCL Y FIXED BIN(15) LITTLEENDIAN;
 DCL Z FIXED BIN(31) NONNATIVE;
 DCL 1 S LITTLEENDIAN,
       2 A FIXED BIN(31),
       2 B FIXED BIN(31) BIGENDIAN;
 DCL V CHAR(8) VARYING LITTLEENDIAN;
 DCL FL FLOAT BIN(53) IEEE;
 DCL FS FLOAT BIN(21) IEEE;
 DCL FD FLOAT DEC(16) IEEE;
 DCL FH FLOAT BIN(53) HEXADEC;

 OPEN FILE(REPORT);

 /* LITTLEENDIAN-STORAGE: the example of the LRM */
 X = 258; Y = 258;
 CALL ZCHECK('LITTLEENDIAN-STORAGE',
   HEXIMAGE(ADDR(X), STG(X))='0102' &
   HEXIMAGE(ADDR(Y), STG(Y))='0201');

 /* LITTLEENDIAN-HEX: HEX shows the big-endian form */
 CALL ZCHECK('LITTLEENDIAN-HEX',
   HEX(X)='0102' & HEX(Y)='0102');

 /* LITTLEENDIAN-SEMANTICS: no effect on operations */
 Z = -2;
 CALL ZCHECK('LITTLEENDIAN-SEMANTICS',
   Y+1=259 & X=Y & Z*Z=4 &
   HEXIMAGE(ADDR(Z), STG(Z))='FEFFFFFF');

 /* LITTLEENDIAN-STRUCTURE: propagated to the members */
 S.A = 1; S.B = 1;
 CALL ZCHECK('LITTLEENDIAN-STRUCTURE',
   HEXIMAGE(ADDR(S.A), 4)='01000000' &
   HEXIMAGE(ADDR(S.B), 4)='00000001');

 /* LITTLEENDIAN-VARYING: the length prefix */
 V = 'AB';
 CALL ZCHECK('LITTLEENDIAN-VARYING',
   HEXIMAGE(ADDR(V), 2)='0200' & LENGTH(V)=2 & V='AB');

 /* IEEE-STORAGE: IEEE binary format */
 FL = 1; FS = 1; FD = 0.5E0; FH = 1;
 CALL ZCHECK('IEEE-STORAGE',
   HEXIMAGE(ADDR(FL), 8)='3FF0000000000000' &
   HEXIMAGE(ADDR(FS), 4)='3F800000' &
   HEXIMAGE(ADDR(FD), 8)='3FE0000000000000' &
   HEXIMAGE(ADDR(FH), 8)='4110000000000000');

 /* IEEE-SEMANTICS: the same values as HEXADEC */
 FL = 2.5E0;
 FH = FL * 2;
 CALL ZCHECK('IEEE-SEMANTICS',
   FH=5 & FL+FL=FH & FS=1);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD117A;
