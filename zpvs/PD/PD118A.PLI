 PD118A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 PAINT: QUALIFY;
   DEFINE ORDINAL COLOR (RED, ORANGE, YELLOW, GREEN);
   DCL MAXC FIXED BIN(31) VALUE(4);
   DEPTH: QUALIFY;
     DEFINE ORDINAL INTENSITY (HIGH, MEDIUM, LOW);
   END DEPTH;
 END PAINT;
 DCL RED FIXED BIN(31) INIT(99);
 DCL C TYPE PAINT.COLOR;
 DCL I ORDINAL PAINT.DEPTH.INTENSITY;

 OPEN FILE(REPORT);

 /* QUALIFY-TYPE: a variable of type PAINT.COLOR */
 C = PAINT.ORANGE;
 CALL ZCHECK('QUALIFY-TYPE',
   BINVALUE(C)=1 & C=PAINT.ORANGE &
   ORDINALSUCC(C)=PAINT.YELLOW & ORDINALNAME(C)='ORANGE');

 /* QUALIFY-NESTED: PAINT.DEPTH.INTENSITY */
 I = PAINT.DEPTH.LOW;
 CALL ZCHECK('QUALIFY-NESTED',
   BINVALUE(I)=2 & I=PAINT.DEPTH.LOW);

 /* QUALIFY-VALUE: a named constant of the block */
 CALL ZCHECK('QUALIFY-VALUE',
   PAINT.MAXC=4);

 /* QUALIFY-NAMESPACE: names not unique to the containing block */
 CALL ZCHECK('QUALIFY-NAMESPACE',
   RED=99 & BINVALUE(PAINT.RED)=0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD118A;
