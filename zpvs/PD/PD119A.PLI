*PROCESS FLOAT(DFP);
 PD119A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL (A, B, C) FLOAT DEC(16);
 DCL S FLOAT DEC(7);
 DCL AX CHAR(8) BASED(ADDR(A));

 OPEN FILE(REPORT);

 /* DFP-EXACT: decimal fractions are exact */
 A = 0.1E0; B = 0.2E0;
 C = A + B;
 CALL ZCHECK('DFP-EXACT',
   C=0.3E0 & A*3=0.3E0);

 /* DFP-STORAGE: the IEEE decimal formats */
 A = 1; S = 1;
 CALL ZCHECK('DFP-STORAGE',
   HEXIMAGE(ADDR(A), 8)='2238000000000001' &
   HEXIMAGE(ADDR(S), 4)='22500001');

 /* DFP-DIVIDE: 16 digits, rounded to nearest */
 A = 1; B = 3;
 C = A / B;
 CALL ZCHECK('DFP-DIVIDE',
   C=0.3333333333333333E0 & 2/B=0.6666666666666667E0);

 /* ISZERO-ISNORMAL: zero and an ordinary value */
 A = 0; B = 1;
 CALL ZCHECK('ISZERO-ISNORMAL',
   ISZERO(A) & ^ISNORMAL(A) & ISFINITE(A) &
   ^ISZERO(B) & ISNORMAL(B) & ISFINITE(B));

 /* ISINF: positive and negative infinity */
 AX = '7800000000000000'X;
 B = 1;
 CALL ZCHECK('ISINF',
   ISINF(A) & ^ISFINITE(A) & ^ISNAN(A) & ^ISNORMAL(A));
 AX = 'F800000000000000'X;
 CALL ZCHECK('ISINF-NEGATIVE',
   ISINF(A) & ^ISFINITE(A));

 /* ISNAN: a quiet NaN */
 AX = '7C00000000000000'X;
 CALL ZCHECK('ISNAN',
   ISNAN(A) & ^ISINF(A) & ^ISFINITE(A) & ^ISZERO(A));

 /* ISNORMAL-SUBNORMAL: 1E-398, below the normal range */
 AX = '0000000000000001'X;
 CALL ZCHECK('ISNORMAL-SUBNORMAL',
   ^ISNORMAL(A) & ISFINITE(A) & ^ISZERO(A));
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PD119A;
