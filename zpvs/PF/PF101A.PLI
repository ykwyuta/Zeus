 PF101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL S CHAR(80), NAME CHAR(8);
 DCL A FIXED DEC(7,2), B FIXED BIN(31);

 OPEN FILE(REPORT);

 /* PUT-STRING-EDIT */
 PUT STRING(S) EDIT(12.34,':',7,':','ABC')
 (F(6,2),A,F(4),A,A);
 CALL ZCHECK('PUT-STRING-EDIT',
   SUBSTR(S,1,15)=' 12.34:   7:ABC');

 /* GET-STRING-EDIT */
 GET STRING(S) EDIT(A,B)(F(6,2),X(1),F(4));
 CALL ZCHECK('GET-STRING-EDIT',
   A=12.34 & B=7);

 /* GET-STRING-LIST */
 S='-1.25,17,ALPHA'; GET STRING(S) LIST(A,B,NAME);
 CALL ZCHECK('GET-STRING-LIST',
   A=-1.25 & B=17 & NAME='ALPHA');

 /* PUT-STRING-DATA */
 PUT STRING(S) DATA(A);
 CALL ZCHECK('PUT-STRING-DATA',
   INDEX(S,'A=')>0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF101A;
