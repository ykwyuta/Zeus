 PF102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL F FILE STREAM OUTPUT PRINT ENV(F RECSIZE(21));
 DCL N FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* PRINT-FIRST-SKIP */
 OPEN FILE(F) TITLE('PFPRINT') LINESIZE(20) PAGESIZE(3);
 PUT FILE(F) SKIP EDIT('ABC')(A);
 CALL ZCHECK('PRINT-FIRST-SKIP',
   LINENO(F)=1);

 /* PRINT-NEXT-SKIP */
 PUT FILE(F) SKIP EDIT('DEF')(A);
 CALL ZCHECK('PRINT-NEXT-SKIP',
   LINENO(F)=2);

 /* PRINT-LINE */
 PUT FILE(F) LINE(3) EDIT('GHI')(A);
 CALL ZCHECK('PRINT-LINE',
   LINENO(F)=3);

 /* PRINT-ENDPAGE */
 ON ENDPAGE(F) N=N+1;
 PUT FILE(F) SKIP EDIT('OUTSIDE')(A);
 CALL ZCHECK('PRINT-ENDPAGE',
   N=1 & LINENO(F)=4);

 /* PRINT-ENDPAGE-ONCE */
 PUT FILE(F) SKIP EDIT('MORE')(A);
 CALL ZCHECK('PRINT-ENDPAGE-ONCE',
   N=1 & LINENO(F)=5);

 /* PRINT-PAGE */
 PUT FILE(F) PAGE EDIT('PAGE2')(A);
 CALL ZCHECK('PRINT-PAGE',
   PAGENO(F)=2 & LINENO(F)=1);

 /* PRINT-REOPEN */
 CLOSE FILE(F); OPEN FILE(F) TITLE('PFPRNEW');
 CALL ZCHECK('PRINT-REOPEN',
   PAGENO(F)=1 & LINENO(F)=1);
 CLOSE FILE(F);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF102A;
