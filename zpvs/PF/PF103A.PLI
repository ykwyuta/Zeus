 PF103A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL OUT FILE RECORD OUTPUT ENV(F RECSIZE(8));
 DCL INP FILE RECORD INPUT ENV(F RECSIZE(8));
 DCL REC CHAR(8), EOF BIT(1) INIT('0'B);

 OPEN FILE(REPORT);

 /* RECORD-CREATE */
 OPEN FILE(OUT) TITLE('XXXXX001');
 REC='FIRST001'; WRITE FILE(OUT) FROM(REC);
 REC='SECOND02'; WRITE FILE(OUT) FROM(REC);
 CLOSE FILE(OUT);
 ON ENDFILE(INP) EOF='1'B;
 OPEN FILE(INP) TITLE('XXXXX001');
 CALL ZCHECK('RECORD-CREATE',
   EOF='0'B);

 /* RECORD-FIRST */
 READ FILE(INP) INTO(REC);
 CALL ZCHECK('RECORD-FIRST',
   REC='FIRST001' & ^EOF);

 /* RECORD-SECOND */
 READ FILE(INP) INTO(REC);
 CALL ZCHECK('RECORD-SECOND',
   REC='SECOND02' & ^EOF);

 /* RECORD-EOF */
 READ FILE(INP) INTO(REC);
 CALL ZCHECK('RECORD-EOF',
   EOF);

 /* RECORD-REOPEN */
 CLOSE FILE(INP); EOF='0'B;
 OPEN FILE(INP) TITLE('XXXXX001');
 READ FILE(INP) INTO(REC);
 CALL ZCHECK('RECORD-REOPEN',
   REC='FIRST001' & ^EOF);

 /* RECORD-CLOSE */
 CLOSE FILE(INP);
 CALL ZCHECK('RECORD-CLOSE',
   REC='FIRST001');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF103A;
