 PF104M: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL KF FILE RECORD KEYED DIRECT UPDATE
   ENV(F RECSIZE(8) KEYLENGTH(2) KEYLOC(1));
 DCL REC CHAR(8), FLAG BIT(1) INIT('0'B);
 DCL CODE FIXED BIN(31);

 OPEN FILE(REPORT);

 /* KSDS-WRITE */
 ON KEY(KF) BEGIN; FLAG='1'B; CODE=ONCODE(); END;
 OPEN FILE(KF) OUTPUT TITLE('XXXXX001');
 REC='01FIRST '; WRITE FILE(KF) FROM(REC) KEYFROM('01');
 CLOSE FILE(KF); OPEN FILE(KF) UPDATE TITLE('XXXXX001');
 CALL ZCHECK('KSDS-WRITE',
   ^FLAG);

 /* KSDS-READ */
 READ FILE(KF) INTO(REC) KEY('01');
 CALL ZCHECK('KSDS-READ',
   REC='01FIRST ');

 /* KSDS-DUPLICATE */
 WRITE FILE(KF) FROM(REC) KEYFROM('01');
 CALL ZCHECK('KSDS-DUPLICATE',
   FLAG & CODE>0);

 /* KSDS-RECOVER */
 FLAG='0'B; READ FILE(KF) INTO(REC) KEY('01');
 CALL ZCHECK('KSDS-RECOVER',
   REC='01FIRST ' & ^FLAG);

 /* KSDS-REWRITE */
 REC='01EDITED'; REWRITE FILE(KF) FROM(REC) KEY('01');
 READ FILE(KF) INTO(REC) KEY('01');
 CALL ZCHECK('KSDS-REWRITE',
   REC='01EDITED');

 /* KSDS-DELETE */
 DELETE FILE(KF) KEY('01');
 READ FILE(KF) INTO(REC) KEY('01');
 CALL ZCHECK('KSDS-DELETE',
   FLAG);

 /* KSDS-REINSERT */
 FLAG='0'B; REC='01NEW';
 WRITE FILE(KF) FROM(REC) KEYFROM('01');
 READ FILE(KF) INTO(REC) KEY('01');
 CALL ZCHECK('KSDS-REINSERT',
   REC='01NEW   ' & ^FLAG);

 /* KSDS-CLOSE */
 CLOSE FILE(KF);
 CALL ZCHECK('KSDS-CLOSE',
   ^FLAG);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF104M;
