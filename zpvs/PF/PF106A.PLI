 PF106A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Without an ENDPAGE on-unit the standard action starts a new page;
    KEY raises ONCODE 51 for a missing key and 52 for a duplicate. */
 DCL F FILE STREAM OUTPUT PRINT ENV(F RECSIZE(21));
 DCL KF FILE RECORD KEYED DIRECT UPDATE
   ENV(F RECSIZE(8) KEYLENGTH(2) KEYLOC(1));
 DCL REC CHAR(8), CODE FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* ENDPAGE-DEFAULT-NEWPAGE */
 OPEN FILE(F) TITLE('PFPRINT') LINESIZE(20) PAGESIZE(2);
 PUT FILE(F) SKIP EDIT('A')(A);
 PUT FILE(F) SKIP EDIT('B')(A);
 PUT FILE(F) SKIP EDIT('C')(A);
 CALL ZCHECK('ENDPAGE-DEFAULT-NEWPAGE',
   PAGENO(F)=2 & LINENO(F)=1);
 CLOSE FILE(F);

 /* KEY-DUPLICATE-ONCODE */
 ON KEY(KF) CODE=ONCODE();
 OPEN FILE(KF) OUTPUT TITLE('XXXXX001');
 REC='01FIRST '; WRITE FILE(KF) FROM(REC) KEYFROM('01');
 CLOSE FILE(KF); OPEN FILE(KF) UPDATE TITLE('XXXXX001');
 WRITE FILE(KF) FROM(REC) KEYFROM('01');
 CALL ZCHECK('KEY-DUPLICATE-ONCODE',
   CODE=52);

 /* KEY-MISSING-ONCODE */
 CODE=0; READ FILE(KF) INTO(REC) KEY('99');
 CALL ZCHECK('KEY-MISSING-ONCODE',
   CODE=51);
 CLOSE FILE(KF);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF106A;
