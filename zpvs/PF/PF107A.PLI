 PF107A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* A KEYED SEQUENTIAL BUFFERED file (Enterprise PL/I 6.1 Language
    Reference): records written with KEYFROM in ascending key order
    are read back in key order, KEYTO gives each key, a READ with
    KEY positions the file and the next sequential READ follows it.
    ONKEY gives the key of a record that raised KEY. Keys are
    unique here, so SAMEKEY is '0'B; it is also '0'B for a file
    that is not open. */
 DCL KF FILE RECORD KEYED SEQUENTIAL BUFFERED
   ENV(F RECSIZE(8) KEYLENGTH(2) KEYLOC(1));
 DCL REC CHAR(8);
 DCL K CHAR(2);
 DCL KS CHAR(6) VARYING INIT('');
 DCL OK CHAR(2) VARYING INIT('');
 DCL CODE FIXED BIN(31) INIT(0);
 DCL EOF BIT(1) INIT('0'B);

 OPEN FILE(REPORT);

 OPEN FILE(KF) OUTPUT TITLE('XXXXX001');
 REC = '01ONE   '; WRITE FILE(KF) FROM(REC) KEYFROM('01');
 REC = '03THREE '; WRITE FILE(KF) FROM(REC) KEYFROM('03');
 REC = '05FIVE  '; WRITE FILE(KF) FROM(REC) KEYFROM('05');
 CLOSE FILE(KF);

 OPEN FILE(KF) INPUT TITLE('XXXXX001');
 ON ENDFILE(KF) EOF = '1'B;
 READ FILE(KF) INTO(REC) KEYTO(K);
 DO WHILE(^EOF);
   KS = KS || K;
   READ FILE(KF) INTO(REC) KEYTO(K);
 END;
 CALL ZCHECK('KEYTO-SEQUENTIAL', KS = '010305');
 CALL ZCHECK('SAMEKEY-UNIQUE', ^SAMEKEY(KF));
 CLOSE FILE(KF);
 CALL ZCHECK('SAMEKEY-CLOSED', ^SAMEKEY(KF));

 OPEN FILE(KF) INPUT TITLE('XXXXX001');
 EOF = '0'B;
 READ FILE(KF) INTO(REC) KEY('03');
 READ FILE(KF) INTO(REC) KEYTO(K);
 CALL ZCHECK('KEY-THEN-NEXT', K = '05' & REC = '05FIVE  ');

 ON KEY(KF) BEGIN; CODE = ONCODE(); OK = ONKEY(); END;
 READ FILE(KF) INTO(REC) KEY('04');
 CALL ZCHECK('ONKEY-MISSING', CODE = 51 & OK = '04');
 CLOSE FILE(KF);

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF107A;
