 PF108A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* FILEOPEN, FILEID, FILENEW, FILEDDTEST, FILEDDINT and FILEDDWORD
    (Enterprise PL/I 6.1 Language Reference). FILEOPEN tells whether
    a file is open. FILEID and the FILEDD functions raise ERROR with
    ONCODE 1010 when the file is not open; FILEID is otherwise the
    system token of the file. FILEDDWORD gives TYPE (RECORD or
    STREAM), ACCESS (SEQUENTIAL or DIRECT), ACTION (INPUT, OUTPUT or
    UPDATE) and CHARSET; FILEDDINT gives RECSIZE; FILEDDTEST gives 1
    for an attribute that applies. FILENEW(x) is a new file with the
    attributes of x, not yet open. */
 DCL F FILE RECORD OUTPUT ENV(F RECSIZE(8));
 DCL P FILE STREAM OUTPUT PRINT ENV(F RECSIZE(21));
 DCL G FILE VARIABLE;
 DCL REC CHAR(8) INIT('RECORD01');
 DCL (CODE, ID) FIXED BIN(31);
 DCL HIT BIT(1);

 OPEN FILE(REPORT);

 CALL ZCHECK('FILEOPEN-CLOSED', ^FILEOPEN(F));
 HIT = '0'B; CODE = 0;
 ON ERROR BEGIN; HIT = '1'B; CODE = ONCODE(); GOTO AFTER_ID; END;
 ID = FILEID(F);
 AFTER_ID:
 REVERT ERROR;
 CALL ZCHECK('FILEID-NOT-OPEN', HIT & CODE = 1010);
 OPEN FILE(F) TITLE('XXXXX001');
 CALL ZCHECK('FILEOPEN-OPEN', FILEOPEN(F));
 CALL ZCHECK('FILEID-OPEN', FILEID(F) ^= 0);
 CALL ZCHECK('FILEDDWORD-RECORD',
   FILEDDWORD(F, 'TYPE') = 'RECORD' &
   FILEDDWORD(F, 'ACCESS') = 'SEQUENTIAL' &
   FILEDDWORD(F, 'ACTION') = 'OUTPUT');
 CALL ZCHECK('FILEDDWORD-CHARSET', FILEDDWORD(F, 'CHARSET') = 'EBCDIC');
 CALL ZCHECK('FILEDDINT-RECSIZE', FILEDDINT(F, 'recsize') = 8);
 OPEN FILE(P) TITLE('XXXXX002');
 CALL ZCHECK('FILEDDWORD-STREAM', FILEDDWORD(P, 'TYPE') = 'STREAM');
 CALL ZCHECK('FILEDDTEST-PRINT',
   FILEDDTEST(P, 'print') = 1 & FILEDDTEST(F, 'print') = 0);
 G = FILENEW(F);
 CALL ZCHECK('FILENEW-NOT-OPEN', ^FILEOPEN(G) & FILEOPEN(F));
 WRITE FILE(F) FROM(REC);
 CLOSE FILE(F), FILE(P);
 CALL ZCHECK('FILEOPEN-AFTER-CLOSE', ^FILEOPEN(F));
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF108A;
