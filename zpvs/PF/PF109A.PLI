 PF109A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL F FILE STREAM ENV(F RECSIZE(80));
 DCL (A, B) FIXED BIN(31) INIT(0);
 DCL FIELD CHAR(20) VAR INIT('');
 DCL N FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* DATAFIELD-OUT-OF-CONTEXT: a null string */
 CALL ZCHECK('DATAFIELD-OUT-OF-CONTEXT',
   LENGTH(DATAFIELD())=0);

 OPEN FILE(F) OUTPUT TITLE('XXXXX001');
 PUT FILE(F) EDIT('A=1 C=5 B=2;')(A);
 CLOSE FILE(F);

 ON NAME(F) BEGIN;
   N = N + 1;
   FIELD = DATAFIELD();
 END;
 OPEN FILE(F) INPUT TITLE('XXXXX001');
 GET FILE(F) DATA(A, B);
 CLOSE FILE(F);

 /* NAME-RAISED: a name not in the data list */
 CALL ZCHECK('NAME-RAISED',
   N=1);

 /* DATAFIELD: the field that raised NAME */
 CALL ZCHECK('DATAFIELD',
   TRIM(FIELD)='C=5');

 /* NAME-NORMAL-RETURN: the GET goes on with the next name */
 CALL ZCHECK('NAME-NORMAL-RETURN',
   A=1 & B=2);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PF109A;
