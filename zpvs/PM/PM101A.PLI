 %DCL (I,MACVALUE) FIXED;
 %MACVALUE=0;
 %DO I=1 TO 5;
 %MACVALUE=MACVALUE+I;
 %END;
 %IF MACVALUE=15 %THEN %MACVALUE=17;
 PM101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 /* MACRO-LOOP */
 N=MACVALUE;
 CALL ZCHECK('MACRO-LOOP',
   N=17);

 /* MACRO-INACTIVE */
 %DEACTIVATE MACVALUE;
 MACVALUE: N=3;
 CALL ZCHECK('MACRO-INACTIVE',
   N=3);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM101A;
