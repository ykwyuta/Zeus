 %DCL SQUARE ENTRY;
 %SQUARE: PROC(X) RETURNS(FIXED);
 DCL X FIXED;
 RETURN(X*X);
 %END SQUARE;
 %ACTIVATE SQUARE;
 PM102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 /* MACRO-PROC */
 N=SQUARE(7);
 CALL ZCHECK('MACRO-PROC',
   N=49);

 /* MACRO-PROC-ZERO */
 N=SQUARE(0);
 CALL ZCHECK('MACRO-PROC-ZERO',
   N=0);

 /* MACRO-PROC-NEG */
 N=SQUARE(-3);
 CALL ZCHECK('MACRO-PROC-NEG',
   N=9);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM102A;
