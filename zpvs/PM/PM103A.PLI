 PM103A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;

 OPEN FILE(REPORT);

 /* BIF-TRIM */
 CALL ZCHECK('BIF-TRIM',
   TRIM('  AB  ')='AB');

 /* BIF-REVERSE */
 CALL ZCHECK('BIF-REVERSE',
   REVERSE('ABCDE')='EDCBA');

 /* BIF-COPY */
 CALL ZCHECK('BIF-COPY',
   COPY('AB',3)='ABABAB');

 /* BIF-TRANSLATE */
 CALL ZCHECK('BIF-TRANSLATE',
   TRANSLATE('ABCA','xy','AB')='xyCx');

 /* BIF-LOWER */
 CALL ZCHECK('BIF-LOWER',
   LOWERCASE('AbC')='abc');

 /* BIF-UPPER */
 CALL ZCHECK('BIF-UPPER',
   UPPERCASE('aBc')='ABC');

 /* BIF-INDEX */
 CALL ZCHECK('BIF-INDEX',
   INDEX('ABABA','BA')=2);

 /* BIF-SEARCH */
 CALL ZCHECK('BIF-SEARCH',
   SEARCH('ABCDE','DX')=4);

 /* BIF-VERIFY */
 CALL ZCHECK('BIF-VERIFY',
   VERIFY('ABX','ABC')=3);

 /* BIF-TALLY */
 CALL ZCHECK('BIF-TALLY',
   TALLY('ABABA','AB')=2);

 /* BIF-LENGTH */
 CALL ZCHECK('BIF-LENGTH',
   LENGTH('')=0);

 /* BIF-CENTER */
 CALL ZCHECK('BIF-CENTER',
   CENTER('AB',6)='  AB  ');

 /* BIF-LEFT */
 CALL ZCHECK('BIF-LEFT',
   LEFT('AB',4)='AB  ');

 /* BIF-RIGHT */
 CALL ZCHECK('BIF-RIGHT',
   RIGHT('AB',4)='  AB');

 /* BIF-MOD */
 CALL ZCHECK('BIF-MOD',
   MOD(-5,3)=1);

 /* BIF-REM */
 CALL ZCHECK('BIF-REM',
   REM(-5,3)=-2);

 /* BIF-FLOOR */
 CALL ZCHECK('BIF-FLOOR',
   FLOOR(-1.2)=-2);

 /* BIF-CEIL */
 CALL ZCHECK('BIF-CEIL',
   CEIL(-1.2)=-1);

 /* BIF-ROUND */
 CALL ZCHECK('BIF-ROUND',
   ROUND(12.345,2)=12.35);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM103A;
