 PM104M: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL PMS01A ENTRY(FIXED BIN(31),CHAR(4)) OPTIONS(COBOL);
 DCL PMS02A ENTRY(FIXED BIN(31),CHAR(4)) OPTIONS(ASM RETCODE);
 DCL N FIXED BIN(31), TEXTIN CHAR(4);

 OPEN FILE(REPORT);

 /* PLI-COBOL-SHARED */
 N=10; TEXTIN='INIT'; CALL PMS01A(N,TEXTIN);
 CALL ZCHECK('PLI-COBOL-SHARED',
   N=17 & TEXTIN='COBL');

 /* PLI-HLASM-SHARED */
 CALL PMS02A(N,TEXTIN);
 CALL ZCHECK('PLI-HLASM-SHARED',
   N=28 & TEXTIN='ASML');

 /* PLI-HLASM-RETCODE */
 CALL ZCHECK('PLI-HLASM-RETCODE',
   PLIRETV()=9);

 /* PLI-COBOL-REPEAT */
 CALL PMS01A(N,TEXTIN);
 CALL ZCHECK('PLI-COBOL-REPEAT',
   N=35 & TEXTIN='COBL');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM104M;
