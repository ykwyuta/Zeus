 PM105A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;

 OPEN FILE(REPORT);

 /* LILIAN-ORIGIN */
 CALL ZCHECK('LILIAN-ORIGIN',
   DAYS('15821015','YYYYMMDD')=1);

 /* LILIAN-LEAP */
 CALL ZCHECK('LILIAN-LEAP',
   DAYSTODATE(DAYS('20000229','YYYYMMDD'),
   'YYYYMMDD')='20000229');

 /* DATE-DELTA */
 CALL ZCHECK('DATE-DELTA',
   DAYS('20000301','YYYYMMDD')-
   DAYS('20000228','YYYYMMDD')=2);

 /* SQRT */
 CALL ZCHECK('SQRT',
   SQRT(81)=9);

 /* SIN-ZERO */
 CALL ZCHECK('SIN-ZERO',
   SIN(0)=0);

 /* COS-ZERO */
 CALL ZCHECK('COS-ZERO',
   COS(0)=1);

 /* LOG-ONE */
 CALL ZCHECK('LOG-ONE',
   LOG(1)=0);

 /* ABS-NEG */
 CALL ZCHECK('ABS-NEG',
   ABS(-17)=17);

 /* MINMAX */
 CALL ZCHECK('MINMAX',
   MAX(1,7,3)=7 & MIN(1,7,3)=1);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM105A;
