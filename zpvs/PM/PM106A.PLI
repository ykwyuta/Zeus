 %DCL SETVAL ENTRY;
 %SETVAL: PROC(NAME,VALUE) STATEMENT RETURNS(CHAR);
 DCL (NAME,VALUE) CHAR;
 RETURN(NAME||'='||VALUE||';');
 %END SETVAL;
 %ACTIVATE SETVAL;
 PM106A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31);

 OPEN FILE(REPORT);

 /* STATEMENT-POSITIONAL */
 SETVAL(N,42);
 CALL ZCHECK('STATEMENT-POSITIONAL',
   N=42);

 /* STATEMENT-KEYWORD */
 SETVAL VALUE(-7) NAME(N);
 CALL ZCHECK('STATEMENT-KEYWORD',
   N=-7);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM106A;
