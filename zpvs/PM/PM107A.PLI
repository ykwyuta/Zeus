 PM107A: PROC(P) OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL P CHAR(*) VARYING;

 OPEN FILE(REPORT);

 /* MAIN-PARM-TEXT */
 CALL ZCHECK('MAIN-PARM-TEXT',
   P='HELLO');

 /* MAIN-PARM-LENGTH */
 CALL ZCHECK('MAIN-PARM-LENGTH',
   LENGTH(P)=5);

 /* PLIRETC-VALUE */
 CALL PLIRETC(4);
 CALL ZCHECK('PLIRETC-VALUE',
   PLIRETV()=4);
 CALL ZFINISH;
 CALL PLIRETC(4);
 STOP;
 END PM107A;
