 PM109A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Built-in functions the suite did not use before. Expected values
    follow the Enterprise PL/I Language Reference definitions: the
    mathematical functions (checked to 1E-12 in FLOAT DEC(16)), SIGN
    and TRUNC, HIGH/LOW/COLLATE, array inquiry, WEEKDAY (Lilian day 1,
    15 October 1582, was a Friday: 6 with Sunday 1), the integer
    manipulation functions on FIXED BIN(31), SEARCHR/VERIFYR, CHARVAL
    and BYTE, VALIDDATE, DAYSTOSECS/SECSTODAYS, the hexadecimal
    floating-point model (radix 16, exponents -64..63, 6 hexadecimal
    digits in FLOAT DEC(6)) and POINTERDIFF. */
 DCL (X, R) FLOAT DEC(16);
 DCL F6 FLOAT DEC(6);
 DCL A(3) FIXED BIN(31) INIT(1,2,3);
 DCL AN(-1:1) FIXED BIN(31) INIT(0,0,0);
 DCL BA(2) BIT(3) INIT('101'B,'111'B);
 DCL V CHAR(10) VAR INIT('ABC');
 DCL 1 S, 2 S1 CHAR(3), 2 S2 CHAR(1);
 DCL CLOSE BIT(1);
 DCL ABS BUILTIN;

 OPEN FILE(REPORT);

 X=1; R=ATAN(X);
 CALL ZCHECK('ATAN-ONE', ABS(R-0.7853981633974483E0)<1E-12);
 R=ATAN(X,X);
 CALL ZCHECK('ATAN-TWO-ARGS', ABS(R-0.7853981633974483E0)<1E-12);
 R=ATAND(X);
 CALL ZCHECK('ATAND-ONE', ABS(R-45E0)<1E-12);
 X=60; R=COSD(X);
 CALL ZCHECK('COSD-60', ABS(R-0.5E0)<1E-12);
 X=30; R=SIND(X);
 CALL ZCHECK('SIND-30', ABS(R-0.5E0)<1E-12);
 X=45; R=TAND(X);
 CALL ZCHECK('TAND-45', ABS(R-1E0)<1E-12);
 X=1; R=COSH(X);
 CALL ZCHECK('COSH-ONE', ABS(R-1.5430806348152437E0)<1E-12);
 R=SINH(X);
 CALL ZCHECK('SINH-ONE', ABS(R-1.1752011936438014E0)<1E-12);
 R=TANH(X);
 CALL ZCHECK('TANH-ONE', ABS(R-0.7615941559557649E0)<1E-12);
 X=0.5; R=ATANH(X);
 CALL ZCHECK('ATANH-HALF', ABS(R-0.5493061443340548E0)<1E-12);
 X=1; R=EXP(X);
 CALL ZCHECK('EXP-ONE', ABS(R-2.718281828459045E0)<1E-12);
 X=1000; R=LOG10(X);
 CALL ZCHECK('LOG10-1000', ABS(R-3E0)<1E-12);
 X=8; R=LOG2(X);
 CALL ZCHECK('LOG2-8', ABS(R-3E0)<1E-12);
 CALL ZCHECK('SIGN-VALUES', SIGN(-3)=-1 & SIGN(0)=0 & SIGN(2)=1);
 CALL ZCHECK('TRUNC-TOWARD-ZERO', TRUNC(-2.7)=-2 & TRUNC(2.7)=2);
 CALL ZCHECK('HIGH-LOW',
   UNSPEC(HIGH(2))='FFFF'BX & UNSPEC(LOW(2))='0000'BX);
 CALL ZCHECK('COLLATE-ORDER',
   LENGTH(COLLATE())=256 & SUBSTR(COLLATE(),194,1)='A');
 CALL ZCHECK('PROD-ARRAY', PROD(A)=6);
 CALL ZCHECK('BOUNDS', LBOUND(AN,1)=-1 & HBOUND(AN,1)=1
   & LBOUND(A,1)=1 & HBOUND(A,1)=3);
 CALL ZCHECK('ALL-ANY', ALL(BA)='101'B & ANY(BA)='111'B);
 CALL ZCHECK('WEEKDAY-LILIAN-ONE', WEEKDAY(1)=6);
 CALL ZCHECK('SIZE-CSTG-VARYING', SIZE(V)=12 & CSTG(V)=5);
 CALL ZCHECK('IAND-IOR-IEOR',
   IAND(12,10)=8 & IOR(12,10)=14 & IEOR(12,10)=6);
 CALL ZCHECK('INOT-ZERO', INOT(0)=-1);
 CALL ZCHECK('ISLL-ISRL',
   ISLL(1,4)=16 & ISRL(16,2)=4 & ISRL(-1,28)=15);
 CALL ZCHECK('RAISE2', RAISE2(10)=1024);
 CALL ZCHECK('SEARCHR',
   SEARCHR('ABCABC','B')=5 & SEARCHR('ABCABC','B',4)=2);
 CALL ZCHECK('VERIFYR',
   VERIFYR('ABCXX','X')=3 & VERIFYR('XX','X')=0);
 CALL ZCHECK('CHARVAL-BYTE', CHARVAL(193)='A' & BYTE(194)='B');
 CALL ZCHECK('VALIDDATE',
   VALIDDATE('20240229') & ^VALIDDATE('20230229')
   & VALIDDATE('2024366','YYYYDDD'));
 CALL ZCHECK('DAYSTOSECS-SECSTODAYS',
   DAYSTOSECS(1)=86400 & SECSTODAYS(172800)=2);
 F6=1;
 CALL ZCHECK('FLOAT-MODEL-INTS',
   RADIX(F6)=16 & MAXEXP(F6)=63 & MINEXP(F6)=-64);
 F6=HUGE(F6);
 CALL ZCHECK('HUGE-SHORT', UNSPEC(F6)='7FFFFFFF'BX);
 F6=TINY(F6);
 CALL ZCHECK('TINY-SHORT', UNSPEC(F6)='00100000'BX);
 F6=EPSILON(F6);
 CALL ZCHECK('EPSILON-SHORT', UNSPEC(F6)='3C100000'BX);
 CALL ZCHECK('POINTERDIFF', POINTERDIFF(ADDR(S2),ADDR(S1))=3);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM109A;
