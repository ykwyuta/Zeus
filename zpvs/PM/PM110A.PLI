 PM110A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Built-in functions, statements and preprocessor statements the
    suite did not use. Expected values follow the Enterprise PL/I
    Language Reference: ACOS/ASIN/TAN (checked to 1E-12), CENTRE of
    an even margin, COMPLEX, SUBTRACT and PRECISION (truncating),
    FLOAT, the lengths of DATE (6), TIME (9) and DATETIME (17),
    POINTERVALUE/BINARYVALUE, ONCOUNT outside an on-unit, DO LOOP with
    LEAVE, a remote FORMAT, RESIGNAL to the enclosing on-unit, and the
    preprocessor %ITERATE, %LEAVE, %GO TO and %REPLACE. */
 DCL (X, R) FLOAT DEC(16);
 DCL ABS BUILTIN;
 DCL C CHAR(6);
 DCL Z CPLX FLOAT DEC(6);
 DCL D FIXED DEC(5,1);
 DCL F FLOAT DEC(6);
 DCL P PTR;
 DCL (N, K) FIXED BIN(31);
 DCL S CHAR(5);
 %DCL (PI, PJ, PK) FIXED;

 OPEN FILE(REPORT);

 X=1; R=ACOS(X);
 CALL ZCHECK('ACOS-ONE', ABS(R)<1E-12);
 R=ASIN(X);
 CALL ZCHECK('ASIN-ONE', ABS(R-1.570796326794897E0)<1E-12);
 X=0.5; R=TAN(X);
 CALL ZCHECK('TAN-HALF', ABS(R-0.5463024898437905E0)<1E-12);
 C=CENTRE('AB',6);
 CALL ZCHECK('CENTRE-EVEN', C='  AB  ');
 Z=COMPLEX(1,2);
 CALL ZCHECK('COMPLEX', REAL(Z)=1 & IMAG(Z)=2);
 D=SUBTRACT(5.5,3,5,1);
 CALL ZCHECK('SUBTRACT', D=2.5);
 D=PRECISION(1.25,3,1);
 CALL ZCHECK('PRECISION-TRUNC', D=1.2);
 F=FLOAT(3);
 CALL ZCHECK('FLOAT', F=3);
 CALL ZCHECK('DATE-TIME-LENGTHS', LENGTH(DATE())=6 & LENGTH(TIME())=9
   & LENGTH(DATETIME())=17);
 CALL ZCHECK('DATETIME-PATTERN',
   VERIFY(DATETIME('YYYYMMDD'),'0123456789')=0);
 P=POINTERVALUE(16);
 CALL ZCHECK('POINTERVALUE', BINARYVALUE(P)=16);
 CALL ZCHECK('ONCOUNT-OUTSIDE', ONCOUNT()=0);
 N=0;
 DO LOOP;
   N=N+1;
   IF N=3 THEN LEAVE;
 END;
 CALL ZCHECK('DO-LOOP-LEAVE', N=3);
 PUT STRING(S) EDIT(42)(R(F1));
 F1: FORMAT(F(5));
 CALL ZCHECK('REMOTE-FORMAT', S='   42');
 N=0;
 ON ERROR BEGIN; N=N+1; GO TO L1; END;
 BEGIN;
   ON ERROR BEGIN; N=N+10; RESIGNAL; END;
   SIGNAL ERROR;
 END;
 L1:
 CALL ZCHECK('RESIGNAL', N=11);
 REVERT ERROR;
 %PJ=0;
 %DO PI=1 TO 5;
 %IF PI=2 %THEN %ITERATE;
 %IF PI=4 %THEN %LEAVE;
 %PJ=PJ+PI;
 %END;
 N=PJ;
 CALL ZCHECK('PP-ITERATE-LEAVE', N=4);
 %PK=1;
 %GO TO PSKIP;
 %PK=9;
 %PSKIP:;
 N=PK;
 CALL ZCHECK('PP-GO-TO', N=1);
 %REPLACE ZZ BY 42;
 N=ZZ;
 CALL ZCHECK('PP-REPLACE', N=42);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM110A;
