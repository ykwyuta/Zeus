 PM111A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Built-in functions for storage, locators and the hexadecimal
    model (Enterprise PL/I Language Reference). ADDRDATA is the
    address of the data; BITLOCATION the bit offset in its byte;
    CS/CDS compare the word or doubleword at p with the one at q and
    either store x at p (0) or copy p to q (1); POINTERSUBTRACT and
    the OFFSET functions move and measure locators; RANK gives the
    code of a character; EXPONENT and SCALE follow x = f * 16**e
    (1/16 <= f < 1); SECSTODATE counts seconds from 00:00:00 on
    14 October 1582 (DAYSTOSECS(1) = 86400). */
 DCL X FIXED BIN(31);
 DCL 1 S, 2 A BIT(3), 2 B BIT(2);
 DCL (O, T, N) FIXED BIN(31);
 DCL (OD, TD) FIXED BIN(63);
 DCL AR AREA(100);
 DCL (OF1, OF2) OFFSET(AR);
 DCL P PTR;
 DCL F FLOAT DEC(6) INIT(1);
 DCL C CHAR(1) INIT('A');

 OPEN FILE(REPORT);

 CALL ZCHECK('ADDRDATA',
   BINARYVALUE(ADDRDATA(X))=BINARYVALUE(ADDR(X)));
 CALL ZCHECK('BITLOCATION', BITLOCATION(B)=3 & BITLOCATION(A)=0);
 O=1; T=1;
 N=CS(ADDR(O),ADDR(T),5);
 CALL ZCHECK('CS-EQUAL', N=0 & O=5 & T=1);
 O=7; T=1;
 N=CS(ADDR(O),ADDR(T),5);
 CALL ZCHECK('CS-UNEQUAL', N=1 & O=7 & T=7);
 OD=2; TD=2;
 N=CDS(ADDR(OD),ADDR(TD),9);
 CALL ZCHECK('CDS-EQUAL', N=0 & OD=9);
 P=POINTERSUBTRACT(POINTERVALUE(20),4);
 CALL ZCHECK('POINTERSUBTRACT', BINARYVALUE(P)=16);
 OF1=OFFSETVALUE(8);
 OF2=OFFSETADD(OF1,4);
 CALL ZCHECK('OFFSETADD-DIFF', OFFSETDIFF(OF2,OF1)=4);
 OF2=OFFSETSUBTRACT(OF2,12);
 CALL ZCHECK('OFFSETSUBTRACT', OFFSETDIFF(OF2,OF1)=-8);
 CALL ZCHECK('RANK-CHAR', RANK(C)=193);
 CALL ZCHECK('EXPONENT-ONE', EXPONENT(F)=1);
 F=SCALE(F,1);
 CALL ZCHECK('SCALE-BY-16', F=16);
 CALL ZCHECK('SECSTODATE-DAY-ONE',
   SECSTODATE(86400,'YYYYMMDD')='15821015');
 CALL ZCHECK('SECSTODATE-TIME',
   SECSTODATE(90061,'YYYYMMDDHHMISS')='15821015010101');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM111A;
