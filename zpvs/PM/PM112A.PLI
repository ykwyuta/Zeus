 PM112A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Built-in functions of the Enterprise PL/I 6.1 Language Reference,
    with its examples where it gives them: BETWEEN and its exclusive
    forms, INLIST, IFTHENELSE (only the chosen operand is evaluated),
    ICLZ, IRLL/IRRL, LOWER2 (SRA), POPCNT (per byte),
    ISIGNED/IUNSIGNED,
    ROUNDAWAYFROMZERO/ROUNDTOEVEN, MAXVAL/MINVAL, PRED/SUCC (HFP),
    PLACES
    (hexadecimal digits), PRECVAL/SCALEVAL, Y4DATE/Y4JULIAN/Y4YEAR,
    REPLACEBY2, HEXIMAGE, COMPARE, LOCATION, ERF/ERFC/GAMMA/LOGGAMMA (to
    1E-12) and ONCONDID/ONCONDCOND. */
 DCL ABS BUILTIN;
 DCL (B31, X, N, Z) FIXED BIN(31);
 DCL U FIXED BIN(32) UNSIGNED INIT(4294967295);
 DCL U8 FIXED BIN(8) UNSIGNED;
 DCL D52 FIXED DEC(5,2);
 DCL D93 FIXED DEC(9,3);
 DCL F FLOAT DEC(6) INIT(1);
 DCL F16 FLOAT DEC(16);
 DCL (R, Y) FLOAT DEC(16);
 DCL C4 CHAR(4) INIT('ABCD');
 DCL C8 CHAR(8) INIT('ABCDEFGH');
 DCL (CA, CB) CHAR(3);
 DCL 1 S, 2 SA CHAR(3), 2 SB CHAR(2), 2 SC CHAR(1);
 DCL FLAG BIT(1);
 DCL NAME CHAR(10) VAR;

 OPEN FILE(REPORT);

 CALL ZCHECK('BETWEEN', BETWEEN(5,1,5) & ^BETWEEN(6,1,5));
 CALL ZCHECK('BETWEEN-EXCLUSIVE',
   ^BETWEENEXCLUSIVE(5,1,5) & BETWEENEXCLUSIVE(3,1,5));
 CALL ZCHECK('BETWEEN-LEFT-EXCL',
   ^BETWEENLEFTEXCLUSIVE(1,1,5) & BETWEENLEFTEXCLUSIVE(5,1,5));
 CALL ZCHECK('BETWEEN-RIGHT-EXCL',
   BETWEENRIGHTEXCLUSIVE(1,1,5) & ^BETWEENRIGHTEXCLUSIVE(5,1,5));
 CALL ZCHECK('INLIST', INLIST(3,1,2,3) & ^INLIST('B','A','C'));
 FLAG='0'B; Z=0;
 ON ZERODIVIDE BEGIN; FLAG='1'B; GO TO L1; END;
 N=IFTHENELSE('1'B,7,1/Z);
 L1:
 CALL ZCHECK('IFTHENELSE-LAZY', N=7 & ^FLAG);
 N=IFTHENELSE('0'B,7,8);
 CALL ZCHECK('IFTHENELSE-FALSE', N=8);
 REVERT ZERODIVIDE;
 X=1;
 CALL ZCHECK('ICLZ', ICLZ(X)=31);
 X=16909060;
 CALL ZCHECK('IRRL', IRRL(X,8)=67174915);
 CALL ZCHECK('IRLL', IRLL(X,8)=33752065);
 CALL ZCHECK('LOWER2', LOWER2(+6,1)=3 & LOWER2(-6,1)=-3
   & LOWER2(-7,1)=-4);
 CALL ZCHECK('POPCNT-PER-BYTE', POPCNT(X)=16843265);
 X=84281096;
 CALL ZCHECK('POPCNT-SECOND', POPCNT(X)=33686273);
 CALL ZCHECK('ISIGNED', ISIGNED(U)=-1);
 B31=-1;
 CALL ZCHECK('IUNSIGNED', IUNSIGNED(B31)=4294967295);
 D52=ROUNDAWAYFROMZERO(24.5,0);
 CALL ZCHECK('ROUND-AWAY-FROM-ZERO',
   D52=25 & ROUNDAWAYFROMZERO(-24.5,0)=-25);
 CALL ZCHECK('ROUND-TO-EVEN', ROUNDTOEVEN(23.5,0)=24
   & ROUNDTOEVEN(24.5,0)=24 & ROUNDTOEVEN(-24.5,0)=-24);
 CALL ZCHECK('MAXVAL-MINVAL', MAXVAL(B31)=2147483647
   & MINVAL(B31)=-2147483648 & MAXVAL(D52)=999.99 & MINVAL(U8)=0);
 F=SUCC(F);
 CALL ZCHECK('SUCC-HFP', UNSPEC(F)='41100001'BX);
 F=1;
 F=PRED(F);
 CALL ZCHECK('PRED-HFP', UNSPEC(F)='40FFFFFF'BX);
 CALL ZCHECK('PLACES-HFP', PLACES(F)=6 & PLACES(F16)=14);
 CALL ZCHECK('PRECVAL-SCALEVAL',
   PRECVAL(D93)=9 & SCALEVAL(D93)=3 & SCALEVAL(F)=0);
 CALL ZCHECK('Y4DATE', Y4DATE('990101',1950)='19990101'
   & Y4DATE('000101',1950)='20000101');
 CALL ZCHECK('Y4JULIAN-Y4YEAR',
   Y4JULIAN('99001',1950)='1999001' & Y4YEAR('49',1950)='2049');
 CALL ZCHECK('REPLACEBY2', REPLACEBY2('ABCA','XYZW','AC')='XYBZWXY');
 CALL ZCHECK('HEXIMAGE', HEXIMAGE(ADDR(C4),4)='C1C2C3C4');
 CALL ZCHECK('HEXIMAGE-SEPARATOR',
   HEXIMAGE(ADDR(C8),8,'-')='C1C2C3C4-C5C6C7C8');
 CA='ABC'; CB='ABD';
 CALL ZCHECK('COMPARE', COMPARE(ADDR(CA),ADDR(CB),3)<0
   & COMPARE(ADDR(CB),ADDR(CA),3)>0 & COMPARE(ADDR(CA),ADDR(CA),3)=0);
 CALL ZCHECK('LOCATION', LOCATION(SA)=0 & LOCATION(SB)=3
   & LOCATION(SC)=5);
 Y=0.5; R=ERF(Y);
 CALL ZCHECK('ERF', ABS(R-0.5204998778130465E0)<1E-12);
 Y=1; R=ERFC(Y);
 CALL ZCHECK('ERFC', ABS(R-0.1572992070502851E0)<1E-12);
 Y=5; R=GAMMA(Y);
 CALL ZCHECK('GAMMA-INTEGER', ABS(R-24E0)<1E-11);
 Y=0.5; R=GAMMA(Y);
 CALL ZCHECK('GAMMA-HALF', ABS(R-1.772453850905516E0)<1E-12);
 Y=10; R=LOGGAMMA(Y);
 CALL ZCHECK('LOGGAMMA', ABS(R-12.80182748008147E0)<1E-11);
 N=-1; NAME='?';
 ON CONDITION(MINE) BEGIN; N=ONCONDID(); NAME=ONCONDCOND(); END;
 SIGNAL CONDITION(MINE);
 CALL ZCHECK('ONCONDID-CONDITION', N=3 & NAME='MINE');
 N=-1; Z=0;
 ON ZERODIVIDE BEGIN; N=ONCONDID(); GO TO L2; END;
 X=1/Z;
 L2:
 CALL ZCHECK('ONCONDID-ZERODIVIDE', N=23);
 CALL ZCHECK('ONCONDID-OUTSIDE', ONCONDID()=0 & ONCONDCOND()='');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM112A;
