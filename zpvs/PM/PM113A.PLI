 PM113A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* String and buffer built-in functions of the Enterprise PL/I 6.1
    Language Reference: COLLAPSE (runs to one, trimmed), SQUEEZE,
    INDEXR, REPLACE (at most i replacements, default 1, 0 all),
    SCRUBOUT, UNHEX, HEX8, MEMINDEX, MEMSEARCH/MEMSEARCHR,
    MEMVERIFY/MEMVERIFYR, MEMCOLLAPSE, MEMSQUEEZE, MEMREPLACE,
    WSCOLLAPSE, WSREPLACE, HEXENCODE/HEXDECODE (EBCDIC digits) and
    the 8 forms (UTF-8 digits), BASE64ENCODE/BASE64DECODE with the
    LRM example 'please' in EBCDIC giving l5OFgaKF, WHEREDIFF. A buffer
    function returns the bytes written, the length needed when the
    target address is zero, and -1 when the target is too short. */
 DCL C6 CHAR(6) INIT('ABCABC');
 DCL PL CHAR(6) INIT('please');
 DCL T CHAR(20);
 DCL S CHAR(8);
 DCL N FIXED BIN(63);
 DCL (CA, CB) CHAR(3);
 DCL F CHAR(1) INIT('#');
 DCL R CHAR(2) INIT('--');

 OPEN FILE(REPORT);

 CALL ZCHECK('COLLAPSE', COLLAPSE('  A  B  ',' ')='A B');
 CALL ZCHECK('SQUEEZE', SQUEEZE('  A  B  ',' ')=' A B ');
 CALL ZCHECK('INDEXR', INDEXR('ABCABC','BC')=5
   & INDEXR('ABCABC','BC',4)=2);
 CALL ZCHECK('REPLACE-ONCE', REPLACE('A#A#','#','-')='A-A#');
 CALL ZCHECK('REPLACE-ALL', REPLACE('A#A#','#','-',1,0)='A-A-');
 CALL ZCHECK('SCRUBOUT', SCRUBOUT('A1B2C3','0123456789')='ABC'
   & SCRUBOUT('12A3','0123456789',3)='12A');
 CALL ZCHECK('UNHEX', UNHEX('C1C2')='AB'
   & UNHEX('C1C2C3C4-C5','-')='ABCDE');
 CALL ZCHECK('HEX8-UTF8-DIGITS', HEX(HEX8('AB'))='43314332');
 CALL ZCHECK('MEMINDEX', MEMINDEX(ADDR(C6),6,'BC')=2);
 CALL ZCHECK('MEMSEARCH', MEMSEARCH(ADDR(C6),6,'CX')=3
   & MEMSEARCHR(ADDR(C6),6,'AX')=4);
 CALL ZCHECK('MEMVERIFY', MEMVERIFY(ADDR(C6),6,'A')=2
   & MEMVERIFYR(ADDR(C6),6,'C')=5 & MEMVERIFY(ADDR(C6),6,'ABC')=0);
 S='  A  B  ';
 T='';
 N=MEMCOLLAPSE(ADDR(T),20,ADDR(S),8,' ');
 CALL ZCHECK('MEMCOLLAPSE', N=3 & SUBSTR(T,1,3)='A B');
 N=MEMSQUEEZE(ADDR(T),20,ADDR(S),8,' ');
 CALL ZCHECK('MEMSQUEEZE', N=5 & SUBSTR(T,1,5)=' A B ');
 S='A#A#A#';
 N=MEMREPLACE(ADDR(T),20,ADDR(S),6,ADDR(F),1,ADDR(R),2,1,0);
 CALL ZCHECK('MEMREPLACE-ALL', N=9 & SUBSTR(T,1,9)='A--A--A--');
 S='A'||'05'X||'B'||'0D'X||'  C ';
 N=WSREPLACE(ADDR(T),20,ADDR(S),8);
 CALL ZCHECK('WSREPLACE', N=8 & SUBSTR(T,1,8)='A B   C ');
 N=WSCOLLAPSE(ADDR(T),20,ADDR(S),8);
 CALL ZCHECK('WSCOLLAPSE', N=5 & SUBSTR(T,1,5)='A B C');
 CA='AB';
 N=HEXENCODE(ADDR(T),20,ADDR(CA),2);
 CALL ZCHECK('HEXENCODE', N=4 & SUBSTR(T,1,4)='C1C2');
 N=HEXDECODE(ADDR(S),8,ADDR(T),4);
 CALL ZCHECK('HEXDECODE', N=2 & SUBSTR(S,1,2)='AB');
 N=HEXENCODE8(ADDR(T),20,ADDR(CA),2);
 CALL ZCHECK('HEXENCODE8', N=4 & HEX(SUBSTR(T,1,4))='43314332');
 N=BASE64ENCODE(ADDR(T),20,ADDR(PL),6);
 CALL ZCHECK('BASE64ENCODE', N=8 & SUBSTR(T,1,8)='l5OFgaKF');
 N=BASE64DECODE(ADDR(S),8,ADDR(T),8);
 CALL ZCHECK('BASE64DECODE', N=6 & SUBSTR(S,1,6)='please');
 N=BASE64ENCODE8(ADDR(T),20,ADDR(PL),5);
 CALL ZCHECK('BASE64ENCODE8',
   N=8 & HEX(SUBSTR(T,1,8))='6C354F466761493D');
 N=BASE64ENCODE(SYSNULL(),0,ADDR(PL),6);
 CALL ZCHECK('BUFFER-MEASURE', N=8);
 N=BASE64ENCODE(ADDR(T),4,ADDR(PL),6);
 CALL ZCHECK('BUFFER-TOO-SHORT', N=-1);
 CA='ABC'; CB='ABD';
 CALL ZCHECK('WHEREDIFF', WHEREDIFF(ADDR(CA),ADDR(CB),3)=3
   & WHEREDIFF(ADDR(CA),ADDR(CA),3)=0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM113A;
