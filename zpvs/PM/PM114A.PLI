 PM114A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Date/time built-in functions of the Enterprise PL/I 6.1 Language
    Reference. Values are in Lilian form: day 1 is 15 October 1582,
    so DAYSTOMICROSECS(1) and MICROSECS('15821015','YYYYMMDD') are
    86400000000 and the earliest value is 14 October 1582 (MINDATE
    under NONULLDATE). Patterns follow Table 65: Mmm is the month
    name in mixed case, DDD the day of the year, YY a year widened
    with the window w. A STCK value counts 2**-12 microseconds from
    1 January 1900 (Principles of Operation, TOD clock), so
    X'B361183F48000000' is 1 January 2000. The SMF date is X'0cyydddF'
    with c=1 for 20xx. TIMESTAMP, UTCDATETIME, UTCSECS, UTCMICROSECS
    and the PLISTCK family read the clock: only their form, their
    order against a fixed date and the condition code 0 are checked. */
 DCL N FIXED BIN(63);
 DCL F FLOAT BIN(53);
 DCL C CHAR(32) VARYING;
 DCL TS CHAR(26);
 DCL T FIXED BIN(64) UNSIGNED;
 DCL TE CHAR(16);
 DCL RC FIXED BIN(31);
 DCL K FIXED BIN(64) UNSIGNED INIT(0);
 DCL K2 FIXED BIN(64) UNSIGNED;

 OPEN FILE(REPORT);

 C=MAXDATE('YYYY-MM-DD-HH.MI.SS.999999');
 CALL ZCHECK('MAXDATE-TIMESTAMP',
   C='9999-12-31-23.59.59.999999');
 C=MINDATE('YYYY-MM-DD-HH.MI.SS.999999');
 CALL ZCHECK('MINDATE-NONULLDATE',
   C='1582-10-14-00.00.00.000000');
 C=MAXDATE('YYYYDDD');
 CALL ZCHECK('MAXDATE-JULIAN', C='9999365');

 N=DAYSTOMICROSECS(1);
 CALL ZCHECK('DAYSTOMICROSECS-ONE', N=86400000000);
 N=MICROSECSTODAYS(3*86400000000+5);
 CALL ZCHECK('MICROSECSTODAYS-DROP', N=3);
 N=MICROSECS('15821015','YYYYMMDD');
 CALL ZCHECK('MICROSECS-DAY-ONE', N=86400000000);
 C=MICROSECSTODATE(86400000000,'YYYYMMDD');
 CALL ZCHECK('MICROSECSTODATE-DAY-ONE', C='15821015');
 C=MICROSECSTODATE(86400000000+3723000004);
 CALL ZCHECK('MICROSECSTODATE-DEFAULT',
   C='1582-10-15-01.02.03.000004');
 F=SECS('15821015','YYYYMMDD');
 CALL ZCHECK('SECS-DAY-ONE', F=86400);
 N=MICROSECS('2024-02-29-12.30.45.123456');
 C=MICROSECSTODATE(N,'YYYYDDDHHMISS999999');
 CALL ZCHECK('MICROSECS-ROUNDTRIP', C='2024060123045123456');

 C=DAYSTODATE(1,'Mmm DD, YYYY');
 CALL ZCHECK('PATTERN-MMM-MIXED', C='Oct 15, 1582');
 C=DAYSTODATE(DAYS('29FEB2024','DDMMMYYYY'),'YYYYDDD');
 CALL ZCHECK('PATTERN-MMM-UPPER', C='2024060');
 C=DAYSTODATE(DAYS('491231','YYMMDD',1950),'YYYYMMDD');
 CALL ZCHECK('PATTERN-WINDOW-HIGH', C='20491231');
 C=DAYSTODATE(DAYS('500101','YYMMDD',1950),'YYYYMMDD');
 CALL ZCHECK('PATTERN-WINDOW-LOW', C='19500101');

 UNSPEC(K2)='B361183F48000000'BX;
 C=STCKTODATE(K2);
 CALL ZCHECK('STCKTODATE-2000',
   C='2000-01-01-00.00.00.000000');
 TE='00B361183F48000000'X||'00000000000000'X;
 C=STCKETODATE(TE,'YYYYMMDD');
 CALL ZCHECK('STCKETODATE-2000', C='20000101');

 C=JULIANTOSMF('2024001');
 CALL ZCHECK('JULIANTOSMF-20XX', C='0124001F'X);
 C=SMFTOJULIAN('0099365F'X);
 CALL ZCHECK('SMFTOJULIAN-19XX', C='1999365');

 TS=TIMESTAMP();
 CALL ZCHECK('TIMESTAMP-FORM', SUBSTR(TS,5,1)='-' &
   SUBSTR(TS,11,1)='-' & SUBSTR(TS,14,1)='.' &
   SUBSTR(TS,20,1)='.' & TS>'2024-01-01');
 C=UTCDATETIME();
 CALL ZCHECK('UTCDATETIME-FORM',
   LENGTH(C)=17 & VERIFY(C,'0123456789')=0 & C>'2024');
 F=UTCSECS();
 CALL ZCHECK('UTCSECS-AFTER',
   F>SECS('20240101000000000'));
 N=UTCMICROSECS();
 CALL ZCHECK('UTCMICROSECS-AFTER',
   N>MICROSECS('20240101','YYYYMMDD'));

 RC=PLISTCK(T);
 CALL ZCHECK('PLISTCK-CC-DATE',
   RC=0 & STCKTODATE(T,'YYYY')>='2024');
 RC=PLISTCKE(TE);
 CALL ZCHECK('PLISTCKE-CC-DATE',
   RC=0 & STCKETODATE(TE,'YYYY')>='2024');
 RC=PLISTCKF(T)+PLISTCKLOCAL(T)+PLISTCKUTC(T);
 CALL ZCHECK('PLISTCK-FORMS-CC', RC=0 & T>K);
 RC=PLISTCKELOCAL(TE)+PLISTCKEUTC(TE);
 CALL ZCHECK('PLISTCKE-FORMS-CC', RC=0);
 RC=PLISTCKP(T)+PLISTCKPLOCAL(T)+PLISTCKPUTC(T);
 CALL ZCHECK('PLISTCKP-FORMS-CC', RC=0 & T>K);

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM114A;
