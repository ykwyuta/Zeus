 PM115A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* Built-in functions and subroutines of the Enterprise PL/I 6.1
    Language Reference that the suite did not use: FIXEDBIN,
    FIXEDDEC, FLOATBIN, FLOATDEC, SIGNED, UNSIGNED, CENTERRIGHT (the
    LRM example), COUNT, HEXIMAGE8, HEXDECODE8, BASE64DECODE8,
    ONFILE, ONPROCEDURE/ONLOC, PLIFILL, PLIMOVE, PLIOVER, WHIGH, WLOW,
    SUBTO, POLY, WSCOLLAPSE16, WSREPLACE16, BASE64ENCODE16 (the LRM
    table: 'please' in EBCDIC is l5OFgaKF), BASE64DECODE16,
    PROCEDURENAME, PACKAGENAME (no PACKAGE: the outermost procedure),
    SOURCELINE, SOURCEFILE, ISMAIN, MAINNAME, GETENV, PUTENV, UUID4
    and VALID. */
 DCL F FILE STREAM OUTPUT;
 DCL NOFILE FILE RECORD INPUT;
 DCL (S, S2) CHAR(8);
 DCL X CHAR(2) INIT('AB');
 DCL T CHAR(24);
 DCL H8 CHAR(4) INIT('43314332'X);
 DCL B8 CHAR(8) INIT('6C354F4667614B46'X);
 DCL PL CHAR(6) INIT('please');
 DCL W16 CHAR(12) INIT('00200041000900420020000A'X);
 DCL N FIXED BIN(63);
 DCL A(0:2) FLOAT BIN(53) INIT(1,2,3);
 DCL A1(3) FLOAT BIN(53) INIT(1,2,3);
 DCL C CHAR(64) VARYING;
 DCL (U1, U2) CHAR(36);
 DCL P3 PIC'999';
 DCL D3 FIXED DEC(3);
 DCL FLAG BIT(1);
 DCL L FIXED BIN(31);

 OPEN FILE(REPORT);

 CALL ZCHECK('FIXEDBIN-FRACTION', FIXEDBIN(1.5)=1.5);
 CALL ZCHECK('FIXEDBIN-PRECISION', FIXEDBIN(7.9,15)=7);
 CALL ZCHECK('FIXEDDEC-SCALE', FIXEDDEC(7.25,5,1)=7.2);
 CALL ZCHECK('FLOATBIN-FLOATDEC',
   FLOATBIN(3)=3 & FLOATDEC(0.5,6)=0.5);
 CALL ZCHECK('SIGNED-UNSIGNED',
   SIGNED(-3,7)=-3 & UNSIGNED(200,8)=200);
 CALL ZCHECK('CENTERRIGHT-LRM',
   CENTERRIGHT('Feel the Power',20,'*')='***Feel the Power***');
 CALL ZCHECK('CENTRERIGHT-ODD', CENTRERIGHT('ABC',6,'*')='**ABC*');

 OPEN FILE(F) TITLE('PMCOUNT');
 PUT FILE(F) LIST(1,2,3);
 CALL ZCHECK('COUNT-PUT-LIST', COUNT(F)=3);
 CLOSE FILE(F);

 CALL ZCHECK('HEXIMAGE8-UTF8',
   HEXIMAGE8(ADDR(X),2)='43314332'X);
 N=HEXDECODE8(ADDR(T),24,ADDR(H8),4);
 CALL ZCHECK('HEXDECODE8-UTF8', N=2 & SUBSTR(T,1,2)='AB');
 N=BASE64DECODE8(ADDR(T),24,ADDR(B8),8);
 CALL ZCHECK('BASE64DECODE8-LRM', N=6 & SUBSTR(T,1,6)='please');

 C='';
 ON UNDEFINEDFILE(NOFILE) BEGIN; C=ONFILE(); GO TO L1; END;
 OPEN FILE(NOFILE);
 L1:
 CALL ZCHECK('ONFILE-UNDEFINEDFILE', C='NOFILE');
 C='';
 ON ZERODIVIDE BEGIN; C=ONPROCEDURE()||'/'||ONLOC(); GO TO L2; END;
 CALL RAISER;
 L2:
 CALL ZCHECK('ONPROCEDURE-ONLOC', C='RAISER/RAISER');

 S='ABCDEFGH';
 CALL PLIFILL(ADDR(S),'*',3);
 CALL ZCHECK('PLIFILL', S='***DEFGH');
 S2=' ';
 CALL PLIMOVE(ADDR(S2),ADDR(S),8);
 CALL ZCHECK('PLIMOVE', S2='***DEFGH');
 S='ABCDEFGH';
 CALL PLIOVER(ADDR(S2),ADDR(S),8);
 CALL PLIOVER(POINTERADD(ADDR(S2),1),ADDR(S2),7);
 CALL ZCHECK('PLIOVER-OVERLAP', S2='AABCDEFG');

 CALL ZCHECK('WHIGH-WLOW',
   UNSPEC(WHIGH(2))='FFFFFFFF'BX & LENGTH(WLOW(3))=3 &
   UNSPEC(WLOW(1))='0000'BX);
 CALL ZCHECK('SUBTO',
   SUBTO('ABCDEF',2,4)='BCD' & SUBTO('ABCDEF',3)='CDEF' &
   LENGTH(SUBTO('ABCDEF',3,2))=0);
 CALL ZCHECK('POLY-ZERO-BASED', POLY(A,2)=17);
 CALL ZCHECK('POLY-ONE-BASED', POLY(A1,2)=17);

 N=WSCOLLAPSE16(ADDR(T),24,ADDR(W16),12);
 CALL ZCHECK('WSCOLLAPSE16',
   N=6 & SUBSTR(T,1,6)='004100200042'X);
 N=WSREPLACE16(ADDR(T),24,ADDR(W16),12);
 CALL ZCHECK('WSREPLACE16',
   N=12 & SUBSTR(T,1,12)='002000410020004200200020'X);
 N=BASE64ENCODE16(ADDR(T),24,ADDR(PL),6);
 CALL ZCHECK('BASE64ENCODE16-LRM', N=16 &
   SUBSTR(T,1,16)='006C0035004F004600670061004B0046'X);
 N=BASE64DECODE16(ADDR(S),8,ADDR(T),16);
 CALL ZCHECK('BASE64DECODE16-ROUNDTRIP',
   N=6 & SUBSTR(S,1,6)='please');

 CALL ZCHECK('PROCEDURENAME-MAIN', PROCEDURENAME()='PM115A');
 CALL ZCHECK('PROCEDURENAME-INNER', INNERNAME()='INNERNAME');
 CALL ZCHECK('PACKAGENAME', PACKAGENAME()='PM115A');
 L=SOURCELINE();
 CALL ZCHECK('SOURCELINE', L=104);
 CALL ZCHECK('SOURCEFILE', INDEX(SOURCEFILE(),'PM115A')>0);
 CALL ZCHECK('ISMAIN', ISMAIN() & ^INNERMAIN());
 CALL ZCHECK('MAINNAME', MAINNAME()='PM115A');

 FLAG=PUTENV('ZPVSVAR=HELLO');
 CALL ZCHECK('PUTENV-GETENV', FLAG & GETENV('ZPVSVAR')='HELLO');

 U1=UUID4(); U2=UUID4();
 CALL ZCHECK('UUID4-FORM', SUBSTR(U1,9,1)='-' &
   SUBSTR(U1,14,1)='-' & SUBSTR(U1,19,1)='-' &
   SUBSTR(U1,24,1)='-' & SUBSTR(U1,15,1)='4' & U1^=U2);

 P3=123;
 FLAG=VALID(P3);
 UNSPEC(P3)=UNSPEC('1A3');
 CALL ZCHECK('VALID-PICTURE', FLAG & ^VALID(P3));
 D3=12;
 FLAG=VALID(D3);
 UNSPEC(D3)='0120'BX;
 CALL ZCHECK('VALID-FIXED-DEC', FLAG & ^VALID(D3));

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;

 RAISER: PROC;
   DCL (Z, Q) FIXED BIN(31) INIT(0);
   Q=1/Z;
 END RAISER;

 INNERNAME: PROC RETURNS(CHAR(32) VARYING);
   RETURN(PROCEDURENAME());
 END INNERNAME;

 INNERMAIN: PROC RETURNS(BIT(1));
   RETURN(ISMAIN());
 END INNERMAIN;
 END PM115A;
