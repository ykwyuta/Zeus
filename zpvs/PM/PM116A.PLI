 PM116A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* The SHA built-in functions of the Enterprise PL/I 6.1 Language
    Reference: SHAnDIGESTx hashes a buffer; SHAnINITx returns a token,
    SHAnUPDATEx adds a buffer and SHAnFINALx adds the last buffer and
    returns the hash, of length x/8 (20 for SHA-1). The buffers hold
    EBCDIC text, so the expected values are the FIPS 180-4 and FIPS
    202 hashes of the EBCDIC bytes of 'abc' and 'abcdefgh'. */
 DCL S CHAR(3) INIT('abc');
 DCL S8 CHAR(8) INIT('abcdefgh');
 DCL TK POINTER;
 DCL H CHAR(128) VARYING;

 OPEN FILE(REPORT);

 H=HEX(SHA1DIGEST(ADDR(S),3));
 CALL ZCHECK('SHA1-DIGEST', H=
   '80ADD764A3B1057058473DC9FCC7B461DDD62749');
 TK=SHA1INIT();
 TK=SHA1UPDATE(TK,ADDR(S8),3);
 TK=SHA1UPDATE(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA1FINAL(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA1-STREAM', H=
   'ECC79740BFE689F3C977655FF30D351287367BAF');

 H=HEX(SHA2DIGEST224(ADDR(S),3));
 CALL ZCHECK('SHA2-224-DIGEST', H=
   '6621B9F4BE7CAE62AB4126F5765581BF2C7C95F26D94194592B0EB6A');
 TK=SHA2INIT224();
 TK=SHA2UPDATE224(TK,ADDR(S8),3);
 TK=SHA2UPDATE224(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA2FINAL224(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA2-224-STREAM', H=
   '84427132D60035AA193ADF8ACB70B71BAAA50717243E8713A75D63CE');

 H=HEX(SHA2DIGEST256(ADDR(S),3));
 CALL ZCHECK('SHA2-256-DIGEST', H=
   'B58EA6D31995A4D8CE092EB718DDFA58B6CEF2288B41FAF1DCD52FF3D6D8'||
   'FA01');
 TK=SHA2INIT256();
 TK=SHA2UPDATE256(TK,ADDR(S8),3);
 TK=SHA2UPDATE256(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA2FINAL256(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA2-256-STREAM', H=
   '10F7977E3DD19CF27B71F14B1E64BDB8D743A0265A1448AC204836A3DDBA'||
   '27C0');

 H=HEX(SHA2DIGEST384(ADDR(S),3));
 CALL ZCHECK('SHA2-384-DIGEST', H=
   '79331CBC7DE8A13318BCD518A0204E6B49B35CFF2A378E19282FCC8F1ED8'||
   'ADCD2D4653F5FAC94D65DE63C7C7D3760BB4');
 TK=SHA2INIT384();
 TK=SHA2UPDATE384(TK,ADDR(S8),3);
 TK=SHA2UPDATE384(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA2FINAL384(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA2-384-STREAM', H=
   '07112A91EAFC8DF66E3639E09CBA0B3C3338658C3CB6A4152276C7357A3E'||
   '1A6529ECE25F877377C89F2C8EA0584BC659');

 H=HEX(SHA2DIGEST512(ADDR(S),3));
 CALL ZCHECK('SHA2-512-DIGEST', H=
   '1702CBC13BFAA52F139F340DD0088CBBDBCC9560C892759AFFFC0ED062C9'||
   '494A9CC8D43FA79BABBE9F2C92DD0C415E4AC041EFC413B82849C65A132F'||
   'D0BDD539');
 TK=SHA2INIT512();
 TK=SHA2UPDATE512(TK,ADDR(S8),3);
 TK=SHA2UPDATE512(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA2FINAL512(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA2-512-STREAM', H=
   '527015B8F79A753D283DEB27F98FA65522461983B524157AE50E001B71AF'||
   '444C521B8627D0E344C833AC2AAC03F9E85010479287B88FFDDF24C04AEB'||
   'EC0386E6');

 H=HEX(SHA3DIGEST224(ADDR(S),3));
 CALL ZCHECK('SHA3-224-DIGEST', H=
   '22F3BEAE4749FF985F1E7DE259CCFF23A8E8EC75C56080046AB7DCF3');
 TK=SHA3INIT224();
 TK=SHA3UPDATE224(TK,ADDR(S8),3);
 TK=SHA3UPDATE224(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA3FINAL224(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA3-224-STREAM', H=
   '51D7C01E34E2BACAA3F5E95CFBC281CF11BF7AA2FF64F9EE8439F322');

 H=HEX(SHA3DIGEST256(ADDR(S),3));
 CALL ZCHECK('SHA3-256-DIGEST', H=
   '72D9CC313CB01609143D0CDE3D42D9D39E4F7E6E6AEECA3DA8DAC55FE205'||
   '45AD');
 TK=SHA3INIT256();
 TK=SHA3UPDATE256(TK,ADDR(S8),3);
 TK=SHA3UPDATE256(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA3FINAL256(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA3-256-STREAM', H=
   '043AE1A5568BDA72195CFA9B51AD0ED94621CBC134DC62B79D4EBD030D62'||
   '28A9');

 H=HEX(SHA3DIGEST384(ADDR(S),3));
 CALL ZCHECK('SHA3-384-DIGEST', H=
   '915FA99FAB4BEBB82C124874828D28EC74D0231B3AB1C931B48F5384C9AD'||
   '3AA954E7DCAB12C7EC5E120958C229F928AF');
 TK=SHA3INIT384();
 TK=SHA3UPDATE384(TK,ADDR(S8),3);
 TK=SHA3UPDATE384(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA3FINAL384(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA3-384-STREAM', H=
   '59C65C3F10DBC90E8F72500F6634CDD9C67E2B927D1DC671EC3CBD912E28'||
   'CC5D3D262D0C2F18E82762BBDEEE077084D3');

 H=HEX(SHA3DIGEST512(ADDR(S),3));
 CALL ZCHECK('SHA3-512-DIGEST', H=
   '4CD66C4E31CF2A9F07F9D15ADC571C39B7E6B9A5B77492591AEDA5193127'||
   '3F69C9FD23DB155CD21C97AF40873268F73B0862C91544D24254E979D193'||
   'DAF5BCED');
 TK=SHA3INIT512();
 TK=SHA3UPDATE512(TK,ADDR(S8),3);
 TK=SHA3UPDATE512(TK,POINTERADD(ADDR(S8),3),2);
 H=HEX(SHA3FINAL512(TK,POINTERADD(ADDR(S8),5),3));
 CALL ZCHECK('SHA3-512-STREAM', H=
   '58100E43B53FED60EA476210C35BA97BE26D9989889E0670DA6B5E6409D7'||
   '3899A8E514E5610AC1DF34DF0D3E63E4DD5D5581880DCD943B74139DE5F2'||
   '5BA08E58');

 TK=SHA2INIT256();
 H=HEX(SHA2FINAL256(TK,SYSNULL(),0));
 CALL ZCHECK('SHA2-256-EMPTY', H=
   'E3B0C44298FC1C149AFBF4C8996FB92427AE41E4649B934CA495991B7852'||
   'B855');
 CALL ZCHECK('DIGEST-LENGTHS', LENGTH(SHA1DIGEST(ADDR(S),3))=20 &
   LENGTH(SHA2DIGEST384(ADDR(S),3))=48 &
   LENGTH(SHA3DIGEST224(ADDR(S),3))=28);

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM116A;
