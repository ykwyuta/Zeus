*PROCESS CODEPAGE(1140);
 PM118A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 /* INARRAY, WCHARVAL, PICSPEC and CODEPAGE (Enterprise PL/I 6.1
    Language Reference). INARRAY compares a scalar with every
    element of an array as the comparison operator would.
    WCHARVAL(n) has the bits of n as UNSIGNED FIXED BIN(16).
    PICSPEC changes only the type of a CHARACTER value, so its
    digits are read as the picture says. CODEPAGE is the CODEPAGE
    compiler option, here CODEPAGE(1140) (Programming Guide). */
 DCL CCS(3) CHAR(2) STATIC NONASGN INIT('AT', 'DE', 'CH');
 DCL NUM(2:5) FIXED DEC(5,2) INIT(1.5, 2, 3.25, -4);
 DCL M(2,2) FIXED BIN(31) INIT(1, 2, 3, 4);
 DCL CC CHAR(2) INIT('DE');
 DCL W WIDECHAR(1);
 DCL X CHAR(5) INIT('00123');
 DCL Y CHAR(4) INIT('-045');
 DCL N FIXED BIN(31);
 DCL D FIXED DEC(7,2);
 DCL CP FIXED BIN(31);

 OPEN FILE(REPORT);

 CALL ZCHECK('INARRAY-CHAR', INARRAY(CC, CCS));
 CALL ZCHECK('INARRAY-CHAR-PAD', INARRAY('CH  ', CCS));
 CALL ZCHECK('INARRAY-MISS', ^INARRAY('FR', CCS));
 CALL ZCHECK('INARRAY-NUMERIC', INARRAY(3.25E0, NUM) &
   INARRAY(-4, NUM) & ^INARRAY(1.49, NUM));
 CALL ZCHECK('INARRAY-2D', INARRAY(4, M) & ^INARRAY(5, M));

 W = WCHARVAL(4660);
 CALL ZCHECK('WCHARVAL-BITS', HEX(W) = '1234');
 CALL ZCHECK('WCHARVAL-RANK', RANK(WCHARVAL(65)) = 65);
 CALL ZCHECK('WCHARVAL-UNSPEC',
   UNSPEC(WCHARVAL(255)) = '0000000011111111'B);

 N = PICSPEC(X, '(5)9');
 CALL ZCHECK('PICSPEC-DIGITS', N = 123);
 D = PICSPEC(X, '999V99');
 CALL ZCHECK('PICSPEC-V', D = 1.23);
 N = PICSPEC(Y, 'S999');
 CALL ZCHECK('PICSPEC-SIGN', N = -45);
 N = 1 + PICSPEC(X, '(5)9');
 CALL ZCHECK('PICSPEC-EXPR', N = 124);

 CP = CODEPAGE;
 CALL ZCHECK('CODEPAGE-OPTION', CP = 1140);

 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM118A;
