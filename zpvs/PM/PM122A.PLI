 PM122A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL X FLOAT BIN(53) INIT(2E0);
 DCL Y FLOAT DEC(16);
 DCL N FIXED BIN(31) INIT(144);

 OPEN FILE(REPORT);

 /* SQRTF-EXACT: a perfect square */
 CALL ZCHECK('SQRTF-EXACT',
   SQRTF(81E0)=9E0 & SQRTF(N)=12);

 /* SQRTF-ZERO */
 CALL ZCHECK('SQRTF-ZERO',
   SQRTF(0E0)=0E0);

 /* SQRTF-AS-SQRT: the same function as SQRT */
 Y = SQRTF(X);
 CALL ZCHECK('SQRTF-AS-SQRT',
   ABS(Y-1.414213562373095E0) < 1E-12 &
   ABS(SQRTF(X)-SQRT(X)) < 1E-12);

 /* SQRTF-SQUARE */
 CALL ZCHECK('SQRTF-SQUARE',
   ABS(SQRTF(X)*SQRTF(X)-2E0) < 1E-12);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM122A;
