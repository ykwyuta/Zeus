 PM123A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL G3 GRAPHIC(3);
 DCL G6 GRAPHIC(6);
 DCL KANJI GRAPHIC(1);
 DCL C CHAR(2);
 DCL RAISED BIT(1) INIT('0'B);
 DCL X CHAR(8) INIT('C1C20E42C142C20F'X);

 OPEN FILE(REPORT);
 G3 = GRAPHIC('ABC');
 G6 = GRAPHIC('ABCDEF');

 /* CHARGRAPHIC-FULL: SO, the DBCS characters, SI */
 CALL ZCHECK('CHARGRAPHIC-FULL',
   CHARGRAPHIC(G3)='0E42C142C242C30F'X &
   LENGTH(CHARGRAPHIC(G3))=8 & CHARG(G3)=CHARGRAPHIC(G3));

 /* CHARGRAPHIC-PAD: SBCS blanks */
 CALL ZCHECK('CHARGRAPHIC-PAD',
   CHARGRAPHIC(G3,10)='0E42C142C242C30F4040'X);

 /* CHARGRAPHIC-TRUNC: after a graphic, SI, then a blank */
 CALL ZCHECK('CHARGRAPHIC-TRUNC',
   CHARGRAPHIC(G6,11)='0E42C142C242C342C40F40'X &
   CHARGRAPHIC(G6,12)='0E42C142C242C342C442C50F'X);

 /* CHARGRAPHIC-ZERO-ONE */
 CALL ZCHECK('CHARGRAPHIC-ZERO-ONE',
   LENGTH(CHARGRAPHIC(G3,0))=0 & CHARGRAPHIC(G3,1)=' ');

 /* GRAPHIC-MIXED: SBCS to DBCS, the DBCS part kept */
 CALL ZCHECK('GRAPHIC-MIXED',
   HEX(GRAPHIC('F1F2F30E42C142C20F'X,5))='42F142F242F342C142C2' &
   HEX(GRAPHIC('F1F2F30E42C142C20F'X,6))='42F142F242F342C142C24040'
   & HEX(GRAPHIC('A B',3))='42C1404042C2');

 /* CHARACTER-CONVERSION: no SBCS equivalent */
 KANJI = GRAPHIC('0E4E4F0F'X);
 ON CONVERSION BEGIN;
   RAISED = '1'B;
   GO TO CONVERTED;
 END;
 C = CHARACTER(KANJI);
 CONVERTED:
 REVERT CONVERSION;
 CALL ZCHECK('CHARACTER-CONVERSION',
   RAISED);

 /* MPSTR-SQUEEZE: S removes null DBCS strings */
 CALL ZCHECK('MPSTR-SQUEEZE',
   MPSTR('C10E0FC2'X,'S')='C1C24040'X &
   MPSTR('C10E0FC2'X,'s',2)='C1C2'X);

 /* MPSTR-TRUNCATE: no DBCS character split */
 CALL ZCHECK('MPSTR-TRUNCATE',
   MPSTR(X,'V',6)='C1C20E42C10F'X &
   MPSTR(X,'V',7)='C1C20E42C10F40'X &
   MPSTR(X,'V',10)='C1C20E42C142C20F4040'X &
   LENGTH(MPSTR(X,'V'))=8 & LENGTH(MPSTR(X,'V',0))=0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM123A;
