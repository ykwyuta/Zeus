 PM125A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE STRUCTURE 1 NODE, 2 V FIXED BIN(31);
 DCL E CHAR(6) INIT('AZaz09');
 DCL A CHAR(6);
 DCL B CHAR(6);
 DCL S CHAR(4) INIT('PL I');
 DCL N FIXED BIN(31) INIT(0);
 DCL (H, K) HANDLE NODE;

 OPEN FILE(REPORT);

 /* PLIASCII: EBCDIC to ASCII */
 CALL PLIASCII(ADDR(A), ADDR(E), 6);
 CALL ZCHECK('PLIASCII',
   UNSPEC(A)=UNSPEC('415A617A3039'X));

 /* PLIEBCDIC: ASCII to EBCDIC */
 CALL PLIEBCDIC(ADDR(B), ADDR(A), 6);
 CALL ZCHECK('PLIEBCDIC',
   B='AZaz09');

 /* PLIASCII-SAME-LOCATION: x and y may be the same */
 CALL PLIASCII(ADDR(S), ADDR(S), 4);
 CALL ZCHECK('PLIASCII-SAME-LOCATION',
   UNSPEC(S)=UNSPEC('504C2049'X));

 /* PLIATTN: raises ATTENTION */
 ON ATTENTION N = N + 1;
 CALL PLIATTN;
 CALL PLIATTN();
 CALL ZCHECK('PLIATTN',
   N=2);

 /* PLIDELETE-PLICANC: both return to the caller */
 H = NEW(:NODE:);
 H => V = 7;
 CALL PLIDELETE(H);
 CALL PLICANC();
 K = NEW(:NODE:);
 K => V = 8;
 CALL ZCHECK('PLIDELETE-PLICANC',
   K => V=8);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM125A;
