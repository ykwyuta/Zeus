 PM126A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;

 OPEN FILE(REPORT);

 /* GETJCLSYMBOL: the value of an exported symbol */
 CALL ZCHECK('GETJCLSYMBOL',
   GETJCLSYMBOL('S1')='STEWART' &
   GETJCLSYMBOL('L1')='LA GUARDIA');

 /* GETJCLSYMBOL-NOT-EXPORTED: a null string */
 CALL ZCHECK('GETJCLSYMBOL-NOT-EXPORTED',
   LENGTH(GETJCLSYMBOL('H'))=0 &
   LENGTH(GETJCLSYMBOL('NONE'))=0);

 /* ISJCLSYMBOL: exported or not */
 CALL ZCHECK('ISJCLSYMBOL',
   ISJCLSYMBOL('S1') & ^ISJCLSYMBOL('H') &
   ^ISJCLSYMBOL('NONE'));

 /* ISJCLSYMBOL-NULL: a symbol set to the null string */
 CALL ZCHECK('ISJCLSYMBOL-NULL',
   LENGTH(GETJCLSYMBOL('E'))=0 & ISJCLSYMBOL('E'));
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM126A;
