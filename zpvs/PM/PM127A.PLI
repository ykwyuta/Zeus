 PM127A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL W CHAR(144) VAR;
 DCL HEXDIG CHAR(16) INIT('0123456789ABCDEF');

 OPEN FILE(REPORT);

 /* GETSYSWORD-NAMES: the job and the step have names */
 CALL ZCHECK('GETSYSWORD-NAMES',
   NAME_OK(GETSYSWORD('JOBNAME')) &
   NAME_OK(GETSYSWORD('STEPNAME')) &
   NAME_OK(GETSYSWORD('SYSNAME')));

 /* GETSYSWORD-JOBNUMBER: the JES job identifier */
 W = TRIM(GETSYSWORD('JOBNUMBER'));
 CALL ZCHECK('GETSYSWORD-JOBNUMBER',
   LENGTH(W)=8 & SUBSTR(W,1,1)='J' &
   VERIFY(SUBSTR(W,2),'OB0123456789')=0);

 /* GETSYSWORD-ASID: hexadecimal */
 W = TRIM(GETSYSWORD('ASID'));
 CALL ZCHECK('GETSYSWORD-ASID',
   LENGTH(W)>0 & VERIFY(W,HEXDIG)=0);

 /* GETSYSWORD-CLASSES: one character each */
 CALL ZCHECK('GETSYSWORD-CLASSES',
   LENGTH(TRIM(GETSYSWORD('JOBCLASS')))=1 &
   LENGTH(TRIM(GETSYSWORD('MSGCLASS')))=1);

 /* GETSYSINT-MAXACTINFO: the fields of ACTINFO */
 W = GETSYSWORD('ACTINFO');
 CALL ZCHECK('GETSYSINT-MAXACTINFO',
   LENGTH(W)>0 & LENGTH(W)<=144 &
   GETSYSINT('MAXACTINFO')=TALLY(W,',')+1 &
   INDEX(W,'''')=0);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;

 NAME_OK: PROC(N) RETURNS(BIT(1));
   DCL N CHAR(*) VAR;
   RETURN(LENGTH(TRIM(N))>0 & LENGTH(TRIM(N))<=8);
 END NAME_OK;
 END PM127A;
