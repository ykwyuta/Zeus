 PM129A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL IN FILE RECORD OUTPUT ENV(F RECSIZE(12));
 DCL OUT FILE RECORD INPUT ENV(F RECSIZE(12));
 DCL 1 R,
       2 NAME CHAR(10),
       2 N FIXED BIN(15);
 DCL RS CHAR(12) BASED(ADDR(R));
 DCL NAMES(5) CHAR(10) INIT('PEAR','APPLE','FIG','KIWI','BANANA');
 DCL NUMS(5) FIXED BIN(15) INIT(2,1,2,1,2);
 DCL (K, RC, NEXT) FIXED BIN(31) INIT(0);
 DCL SEEN CHAR(40) VAR INIT('');
 DCL EOF BIT(1);
 DCL STOP16 BIT(1) INIT('0'B);
 DCL D FIXED DEC(5);
 DCL DS CHAR(3) BASED(ADDR(D));
 DCL VALS(4) FIXED DEC(5) INIT(12, -5, 3, -40);

 OPEN FILE(REPORT);
 OPEN FILE(IN) TITLE('SORTIN');
 DO K = 1 TO 5;
   R.NAME = NAMES(K); R.N = NUMS(K);
   WRITE FILE(IN) FROM(R);
 END;
 CLOSE FILE(IN);

 /* PLISRTA: data set to data set */
 CALL PLISRTA(' SORT FIELDS=(1,10,CH,A) ',
   ' RECORD TYPE=F,LENGTH=(12) ', 1048576, RC);
 CALL ZCHECK('PLISRTA',
   RC=0 & SORTED()='APPLE BANANA FIG KIWI PEAR ');

 /* PLISRTA-KEYS: BI descending, then CH ascending */
 CALL PLISRTA(' SORT FIELDS=(11,2,BI,D,1,10,CH,A) ',
   ' RECORD TYPE=F,LENGTH=(12) ', 1048576, RC);
 CALL ZCHECK('PLISRTA-KEYS',
   RC=0 & SORTED()='BANANA FIG PEAR APPLE KIWI ');

 /* PLISRTB: input routine to data set */
 NEXT = 0;
 CALL PLISRTB(' SORT FIELDS=(1,10,CH,D) ',
   ' RECORD TYPE=F,LENGTH=(12) ', 1048576, RC, E15);
 CALL ZCHECK('PLISRTB',
   RC=0 & SORTED()='PEAR KIWI FIG BANANA APPLE ' &
   PLIRETV()=0);

 /* PLISRTC: data set to output routine */
 SEEN = '';
 CALL PLISRTC(' SORT FIELDS=(1,10,CH,A) ',
   ' RECORD TYPE=F,LENGTH=(12) ', 1048576, RC, E35);
 CALL ZCHECK('PLISRTC',
   RC=0 & SEEN='APPLE BANANA FIG KIWI PEAR ' & PLIRETV()=0);

 /* PLISRTD: routine to routine, a packed decimal field */
 NEXT = 0; SEEN = '';
 CALL PLISRTD(' SORT FIELDS=(1,3,PD,A) ',
   ' RECORD TYPE=F,LENGTH=(3) ', 1048576, RC, E15PD, E35PD);
 CALL ZCHECK('PLISRTD',
   RC=0 & SEEN='-40 -5 3 12 ');

 /* PLISRT-FAILED: return code 16 from the input routine */
 NEXT = 0; STOP16 = '1'B;
 CALL PLISRTB(' SORT FIELDS=(1,10,CH,A) ',
   ' RECORD TYPE=F,LENGTH=(12) ', 1048576, RC, E15);
 CALL ZCHECK('PLISRT-FAILED',
   RC=16);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;

 /* the names of SORTOUT in order */
 SORTED: PROC RETURNS(CHAR(40) VAR);
   DCL S CHAR(40) VAR INIT('');
   EOF = '0'B;
   ON ENDFILE(OUT) EOF = '1'B;
   OPEN FILE(OUT) TITLE('SORTOUT');
   READ FILE(OUT) INTO(R);
   DO WHILE(^EOF);
     S = S || TRIM(R.NAME) || ' ';
     READ FILE(OUT) INTO(R);
   END;
   CLOSE FILE(OUT);
   RETURN(S);
 END SORTED;

 E15: PROC RETURNS(CHAR(12));
   NEXT = NEXT + 1;
   IF STOP16 & NEXT = 3 THEN DO;
     CALL PLIRETC(16);
     RETURN('');
   END;
   IF NEXT > 5 THEN DO;
     CALL PLIRETC(8);
     RETURN('');
   END;
   R.NAME = NAMES(NEXT); R.N = NUMS(NEXT);
   CALL PLIRETC(12);
   RETURN(RS);
 END E15;

 E35: PROC(STRING);
   DCL STRING CHAR(12);
   RS = STRING;
   SEEN = SEEN || TRIM(R.NAME) || ' ';
   CALL PLIRETC(4);
 END E35;

 E15PD: PROC RETURNS(CHAR(3));
   NEXT = NEXT + 1;
   IF NEXT > 4 THEN DO;
     CALL PLIRETC(8);
     RETURN('');
   END;
   D = VALS(NEXT);
   CALL PLIRETC(12);
   RETURN(DS);
 END E15PD;

 E35PD: PROC(STRING);
   DCL STRING CHAR(3);
   DS = STRING;
   SEEN = SEEN || TRIM(CHAR(D)) || ' ';
   CALL PLIRETC(4);
 END E35PD;
 END PM129A;
