 PM131A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31) INIT(0);

 OPEN FILE(REPORT);

 /* PLIDUMP-CONTINUE: with C the routine continues */
 CALL PLIDUMP('TBFC', 'ZPVS PM131A DUMP 1');
 N = N + 1;
 CALL ZCHECK('PLIDUMP-CONTINUE',
   N=1);

 /* PLIDUMP-DEFAULT: T, F and C are the defaults */
 CALL PLIDUMP('', 'ZPVS PM131A DUMP 2');
 CALL PLIDUMP('NTNF', 'ZPVS PM131A DUMP 3');
 N = N + 1;
 CALL ZCHECK('PLIDUMP-DEFAULT',
   N=2);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM131A;
