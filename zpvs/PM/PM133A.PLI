 PM133A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL B1 CHAR(8) INIT('0000000100000002'X);
 DCL B2 CHAR(8) INIT('FFFFFFFF00000002'X);
 DCL B3 CHAR(2) INIT('0102'X);
 DCL T CHAR(20) INIT('ZPVS CHECKSUM BUFFER');
 DCL (C1, C2) FIXED BIN(32) UNSIGNED;

 OPEN FILE(REPORT);

 /* CHECKSUM-SAME-BUFFER: the same bytes, the same checksum */
 C1 = CHECKSUM(ADDR(T), 20);
 C2 = CHECKSUM(ADDR(T), LENGTH(T));
 CALL ZCHECK('CHECKSUM-SAME-BUFFER',
   C1=C2);

 /* CHECKSUM-WORDS: the sum of the 4-byte words */
 CALL ZCHECK('CHECKSUM-WORDS',
   CHECKSUM(ADDR(B1), 8)=3);

 /* CHECKSUM-CARRY: the carry is added back in */
 CALL ZCHECK('CHECKSUM-CARRY',
   CHECKSUM(ADDR(B2), 8)=2);

 /* CHECKSUM-PAD: a short last word is padded with zeros */
 CALL ZCHECK('CHECKSUM-PAD',
   CHECKSUM(ADDR(B3), 2)=16908288);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PM133A;
