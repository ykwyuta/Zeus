 PS101A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL P POINTER;
 DCL 1 NODE BASED(P), 2 A FIXED BIN(31), 2 B CHAR(4);
 DCL Q POINTER;
 DCL KEEP FIXED BIN(31) INIT(77);

 OPEN FILE(REPORT);

 /* NULL-SYSNULL */
 CALL ZCHECK('NULL-SYSNULL',
   NULL()^=SYSNULL());

 /* NULL-IMAGE */
 P=NULL();
 CALL ZCHECK('NULL-IMAGE',
   HEX(UNSPEC(P))='FF000000');

 /* SYSNULL-IMAGE */
 P=SYSNULL();
 CALL ZCHECK('SYSNULL-IMAGE',
   HEX(UNSPEC(P))='00000000');

 /* ALLOC-BASED */
 ALLOCATE NODE; NODE.A=17; NODE.B='DATA';
 CALL ZCHECK('ALLOC-BASED',
   NODE.A=17 & NODE.B='DATA');

 /* POINTER-ALIAS */
 Q=P;
 CALL ZCHECK('POINTER-ALIAS',
   Q->A=17);

 /* POINTER-REBIND */
 Q->A=99;
 CALL ZCHECK('POINTER-REBIND',
   NODE.A=99);

 /* POINTER-ADD */
 CALL ZCHECK('POINTER-ADD',
   POINTERADD(P,4)=ADDR(NODE.B));

 /* FREE-OTHER-STORAGE */
 FREE NODE;
 CALL ZCHECK('FREE-OTHER-STORAGE',
   KEEP=77);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS101A;
