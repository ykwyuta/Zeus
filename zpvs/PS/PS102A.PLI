 PS102A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL X FIXED BIN(31) CONTROLLED;
 DCL A(*) FIXED BIN(31) CONTROLLED;

 OPEN FILE(REPORT);

 /* CTL-ZERO */
 CALL ZCHECK('CTL-ZERO',
   ALLOCATION(X)=0);

 /* CTL-FIRST */
 ALLOCATE X; X=10;
 CALL ZCHECK('CTL-FIRST',
   ALLOCATION(X)=1 & X=10);

 /* CTL-SECOND */
 ALLOCATE X; X=20;
 CALL ZCHECK('CTL-SECOND',
   ALLOCATION(X)=2 & X=20);

 /* CTL-RESTORE */
 FREE X;
 CALL ZCHECK('CTL-RESTORE',
   ALLOCATION(X)=1 & X=10);

 /* CTL-EMPTY */
 FREE X;
 CALL ZCHECK('CTL-EMPTY',
   ALLOCATION(X)=0);

 /* CTL-ARRAY-FIRST */
 ALLOCATE A(3); A=7;
 CALL ZCHECK('CTL-ARRAY-FIRST',
   DIM(A)=3 & SUM(A)=21);

 /* CTL-ARG-PUSH */
 CALL PUSH(A);
 CALL ZCHECK('CTL-ARG-PUSH',
   ALLOCATION(A)=2 & DIM(A)=5 & A(5)=500);

 /* CTL-ARG-RESTORE */
 FREE A;
 CALL ZCHECK('CTL-ARG-RESTORE',
   DIM(A)=3 & SUM(A)=21);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 PUSH: PROC(B);
 DCL B(*) FIXED BIN(31) CONTROLLED;
 DCL I FIXED BIN(31);
 ALLOCATE B(5);
 DO I=1 TO 5; B(I)=I*100; END;
 END PUSH;
 END PS102A;
