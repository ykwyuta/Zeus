 PS103A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL A AREA(256), B AREA(256);
 DCL O OFFSET(A), P POINTER;
 DCL 1 NODE BASED(P), 2 VALUE FIXED BIN(31), 2 TEXT CHAR(4);

 OPEN FILE(REPORT);

 /* AREA-ALLOC */
 ALLOCATE NODE IN(A) SET(O); P=POINTER(O,A);
 NODE.VALUE=7; NODE.TEXT='DATA';
 CALL ZCHECK('AREA-ALLOC',
   NODE.VALUE=7 & NODE.TEXT='DATA');

 /* OFFSET-ROUNDTRIP */
 CALL ZCHECK('OFFSET-ROUNDTRIP',
   OFFSET(P,A)=O);

 /* AREA-COPY */
 B=A; P=POINTER(O,B);
 CALL ZCHECK('AREA-COPY',
   NODE.VALUE=7 & NODE.TEXT='DATA');

 /* AREA-INDEPENDENT */
 NODE.VALUE=99; P=POINTER(O,A);
 CALL ZCHECK('AREA-INDEPENDENT',
   NODE.VALUE=7);

 /* AREA-EMPTY-RESET */
 A=EMPTY();
 ALLOCATE NODE IN(A) SET(O); P=POINTER(O,A);
 NODE.VALUE=12;
 CALL ZCHECK('AREA-EMPTY-RESET',
   NODE.VALUE=12);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS103A;
