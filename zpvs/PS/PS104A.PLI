 PS104A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL N FIXED BIN(31) INIT(3), P POINTER;
 DCL 1 R BASED(P), 2 CNT FIXED BIN(31),
   2 ITEMS(N REFER(CNT)) CHAR(4), 2 TAIL CHAR(4);

 OPEN FILE(REPORT);

 /* REFER-ALLOC */
 ALLOCATE R;
 CALL ZCHECK('REFER-ALLOC',
   CNT=3 & DIM(ITEMS)=3 & STG(R)=20);

 /* REFER-TAIL */
 ITEMS(1)='AAAA'; ITEMS(2)='BBBB'; ITEMS(3)='CCCC';
 TAIL='TAIL';
 CALL ZCHECK('REFER-TAIL',
   TAIL='TAIL');

 /* REFER-SHRINK */
 CNT=2;
 CALL ZCHECK('REFER-SHRINK',
   TAIL='CCCC' & STG(R)=16);

 /* REFER-WRITE-SHRUNK */
 TAIL='EDIT'; CNT=3;
 CALL ZCHECK('REFER-WRITE-SHRUNK',
   ITEMS(3)='EDIT' & TAIL='TAIL');

 /* REFER-RESTORE */
 CALL ZCHECK('REFER-RESTORE',
   DIM(ITEMS)=3 & CURRENTSIZE(R)=20);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS104A;
