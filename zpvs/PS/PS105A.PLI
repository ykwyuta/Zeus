 PS105A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL A(3,3) FIXED BIN(31);
 DCL DIAG(3) FIXED BIN(31) DEFINED A(1SUB,1SUB);
 DCL T(3,3) FIXED BIN(31) DEFINED A(2SUB,1SUB);
 DCL S CHAR(8) INIT('ABCDEFGH');
 DCL PART CHAR(3) DEFINED S POSITION(4);
 DCL (I,J) FIXED BIN(31);

 OPEN FILE(REPORT);

 /* DEFINED-POSITION */
 CALL ZCHECK('DEFINED-POSITION',
   PART='DEF');

 /* DEFINED-WRITE */
 PART='123';
 CALL ZCHECK('DEFINED-WRITE',
   S='ABC123GH');

 /* ISUB-DIAGONAL */
 DO I=1 TO 3; DO J=1 TO 3; A(I,J)=I*10+J; END; END;
 CALL ZCHECK('ISUB-DIAGONAL',
   DIAG(1)=11 & DIAG(2)=22 & DIAG(3)=33);

 /* ISUB-TRANSPOSE */
 CALL ZCHECK('ISUB-TRANSPOSE',
   T(1,2)=21 & T(3,1)=13);

 /* ISUB-WRITE */
 DIAG(2)=99;
 CALL ZCHECK('ISUB-WRITE',
   A(2,2)=99 & SUM(DIAG)=143);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS105A;
