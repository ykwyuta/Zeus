 PS106A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE STRUCTURE 1 POINT, 2 X FIXED BIN(31),
   2 Y FIXED BIN(31);
 DCL P TYPE POINT, H HANDLE POINT;

 OPEN FILE(REPORT);

 /* HANDLE-EXISTING */
 P.X=7; H=HANDLE(P); H=>X=17;
 CALL ZCHECK('HANDLE-EXISTING',
   P.X=17);

 /* NEW-TYPED */
 H=NEW(:POINT:); H=>X=3; H=>Y=4;
 CALL ZCHECK('NEW-TYPED',
   H=>X=3 & H=>Y=4);

 /* NEW-INDEPENDENT */
 CALL ZCHECK('NEW-INDEPENDENT',
   P.X=17 & H=>X=3);

 /* HANDLE-FREE */
 CALL PLIFREE(H);
 CALL ZCHECK('HANDLE-FREE',
   P.X=17);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS106A;
