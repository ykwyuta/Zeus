 PS110A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL POOL AREA(10000);
 DCL POOL2 AREA(1000);
 DCL 1 DATA,
       2 ORDERINFO(4),
         3 NAME   OFFSET(POOL) LOCATES(CHAR(30) VARYING),
         3 STREET OFFSET(POOL) LOCATES(CHAR(62) VARYING);
 DCL AMOUNT OFFSET(POOL) LOCATES(FIXED DEC(7,2));
 DCL Q OFFSET LOCATES(FIXED BIN(31));

 OPEN FILE(REPORT);

 /* LOCNEWSPACE-LOCVAL: allocate, then assign through LOCVAL */
 CALL LOCNEWSPACE(NAME(1));
 LOCVAL(NAME(1)) = 'Sherlock Holmes';
 CALL ZCHECK('LOCNEWSPACE-LOCVAL',
   LOCVAL(NAME(1))='Sherlock Holmes' &
   LENGTH(LOCVAL(NAME(1)))=15 &
   LOCVAL(NAME(1),POOL)='Sherlock Holmes');

 /* LOCNEWVALUE */
 CALL LOCNEWVALUE('221B Baker Street', STREET(1));
 CALL ZCHECK('LOCNEWVALUE',
   LOCVAL(STREET(1))='221B Baker Street' &
   LOCVAL(NAME(1))='Sherlock Holmes');

 /* LOCATES-ASSIGN: a value assigned to the offset */
 NAME(2) = 'Mycroft';
 STREET(2) = 'Pall Mall';
 CALL ZCHECK('LOCATES-ASSIGN',
   LOCVAL(NAME(2))='Mycroft' & LOCVAL(STREET(2))='Pall Mall' &
   NAME(1)^=NAME(2) & LOCVAL(NAME(1))='Sherlock Holmes');

 /* LOCATES-ARITHMETIC: function and pseudovariable */
 AMOUNT = 12.5;
 LOCVAL(AMOUNT) = LOCVAL(AMOUNT) + 1;
 CALL ZCHECK('LOCATES-ARITHMETIC',
   LOCVAL(AMOUNT)=13.50);

 /* LOCNEWVALUE-AREA: an OFFSET without an area */
 CALL LOCNEWVALUE(42, Q, POOL2);
 CALL ZCHECK('LOCNEWVALUE-AREA',
   LOCVAL(Q,POOL2)=42);

 /* LOCSTG: the size of every located type */
 CALL ZCHECK('LOCSTG',
   LOCSTG(DATA)=96*4 & LOCSTG(ORDERINFO(2))=96 &
   LOCSTG(NAME(1))=32 & LOCSTG(STREET)=64*4 &
   LOCSTG(AMOUNT)=4);
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS110A;
