 PS111A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DEFINE STRUCTURE
   1 TED,
     2 T1 FIXED BIN(31),
     2 T2 CHAR(12);
 DCL (P1, P2, H) HANDLE TED;
 DCL (D1, D2) TYPE TED;

 OPEN FILE(REPORT);
 P1 = NEW(:TED:);
 P2 = NEW(:TED:);
 P2 => T1 = 17;
 P2 => T2 = '314159265358';

 /* TYPE-FUNCTION: the structure the handle locates */
 D1 = TYPE(P2);
 CALL ZCHECK('TYPE-FUNCTION',
   D1.T1=17 & D1.T2='314159265358');

 /* TYPE-PSEUDO-TYPE: TYPE(P1) = TYPE(P2) */
 TYPE(P1) = TYPE(P2);
 CALL ZCHECK('TYPE-PSEUDO-TYPE',
   P1 => T1=17 & P1 => T2='314159265358');

 /* TYPE-PSEUDO-VAR: TYPE(P1) = D2 */
 D2.T1 = 5;
 D2.T2 = 'FIVE';
 TYPE(P1) = D2;
 CALL ZCHECK('TYPE-PSEUDO-VAR',
   P1 => T1=5 & P1 => T2='FIVE' & P2 => T1=17);

 /* TYPE-OF-HANDLE: a handle to a declared variable */
 H = HANDLE(D1);
 TYPE(H) = D2;
 CALL ZCHECK('TYPE-OF-HANDLE',
   D1.T1=5 & D1.T2='FIVE');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS111A;
