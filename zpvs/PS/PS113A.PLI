 PS113P: PACKAGE EXPORTS(*) RESERVES(RX);
 DCL RX CHAR(8) RESERVED INIT('RESERVED');

 PS113A: PROC OPTIONS(MAIN);
 %INCLUDE ZPVSRPT;
 DCL RX CHAR(8) RESERVED;

 OPEN FILE(REPORT);

 /* RESERVED-INITIAL: the reserving package initializes it */
 CALL ZCHECK('RESERVED-INITIAL',
   RX='RESERVED');

 /* RESERVED-EXTERNAL: one variable for all declarations */
 CALL SETRX;
 CALL ZCHECK('RESERVED-EXTERNAL',
   RX='CHANGED');
 CALL ZFINISH;
 CALL PLIRETC(0);
 STOP;
 END PS113A;

 SETRX: PROC;
   DCL RX CHAR(8) RESERVED;
   RX = 'CHANGED';
 END SETRX;
 END PS113P;
