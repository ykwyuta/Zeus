  "PA103A": {
    "basis": "spec",
    "refs": [
      "PLI-LRM: Picture characters for numeric character data",
      "PLI-LRM: Exponent characters | The value of the exponent is adjusted in the character value so that the first significant digit of the first field (the mantissa) appears in the position associated with the first digit specifier of the specification"
    ],
    "tests": {
      "FLOAT-PIC-NORMAL": {
        "basis": "zos",
        "note": "1234.5 has five significant digits and the mantissa field holds four; the Language Reference does not say whether the dropped digit 5 truncates (1.234) or rounds (1.235) on the way to a float picture. Expected is the current Zeus value (truncation)."
