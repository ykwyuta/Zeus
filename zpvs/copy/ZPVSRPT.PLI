 /* GPL-3.0-or-later. Independent specification-based assertions. */
 DCL REPORT FILE RECORD OUTPUT ENV(F RECSIZE(120));
 DCL (ZTOTAL,ZPASS,ZFAIL) FIXED BIN(31) INIT(0);
 DCL ZLINE CHAR(120);
 ZCHECK: PROC(ID,OK);
   DCL ID CHAR(*), OK BIT(1);
   ZTOTAL=ZTOTAL+1;
   IF OK THEN DO;
     ZPASS=ZPASS+1; ZLINE='PASS '||ID;
   END;
   ELSE DO;
     ZFAIL=ZFAIL+1; ZLINE='FAIL* '||ID;
   END;
   WRITE FILE(REPORT) FROM(ZLINE);
 END ZCHECK;
 ZFINISH: PROC;
   PUT STRING(ZLINE) EDIT(ZPASS,' OF ',ZTOTAL,
     ' TESTS WERE EXECUTED SUCCESSFULLY')(F(6),A,F(6),A);
   WRITE FILE(REPORT) FROM(ZLINE);
   PUT STRING(ZLINE) EDIT(ZFAIL,' TEST(S) FAILED')(F(6),A);
   WRITE FILE(REPORT) FROM(ZLINE);
   ZLINE='NO TEST(S) DELETED';
   WRITE FILE(REPORT) FROM(ZLINE);
   ZLINE='NO TEST(S) REQUIRE VISUAL INSPECTION';
   WRITE FILE(REPORT) FROM(ZLINE);
   CLOSE FILE(REPORT);
 END ZFINISH;
